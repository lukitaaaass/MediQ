# Copia este archivo a .env y rellena con tus credenciales

# Supabase (anon/publishable — seguras en el frontend)
PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXX

# Gemini (privada — solo servidor). Es la que mueve el chat de /api/chat:
# sin ella el chat responde 500, no hay fallback a otro proveedor.
# Obténla en: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaXXXXXXXXXXXXXXXX
# Modelo. Por defecto 'gemini-flash-latest', el alias que Google mantiene
# apuntando al Flash vigente. Se deja configurable porque Google retira
# modelos de cuentas nuevas sin avisar y conviene poder cambiarlo desde
# Vercel sin esperar a un deploy. Déjalo en blanco salvo que haga falta.
GEMINI_MODEL=
# Techo de tokens de la respuesta. Por defecto 16384. Ojo: subirlo mucho
# choca con el maxDuration de vercel.json (60s) antes que con el límite del
# modelo (~65k), porque la respuesta va en streaming. Súbelos a la vez.
GEMINI_MAX_TOKENS=

# Groq (privada — solo se usa en el servidor, nunca llega al navegador)
# Ya NO mueve el chat principal, pero sigue haciendo falta: la usan el chat
# de demo y el análisis de informes y analíticas.
# Obténla gratis en: https://console.groq.com → API Keys
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXX

# Sal para hashear las IPs del rate limiting de los endpoints de demo
# (demo-chat, analyze-report, analyze-analitica). Cualquier cadena larga y
# aleatoria; si cambia, los contadores en curso se reinician.
DEMO_RATE_SALT=

# Plausible Analytics (opcional — deja en blanco para desactivar)
# Regístrate en plausible.io y añade tu dominio (p. ej. mediq.app)
PUBLIC_PLAUSIBLE_DOMAIN=

# Stripe (obtenlas en dashboard.stripe.com → Developers → API Keys)
STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXX
# IDs de precio: crea los productos en Stripe y copia el Price ID
STRIPE_PRICE_MONTHLY=price_XXXXXXXXXXXXXXXX
STRIPE_PRICE_ANNUAL=price_XXXXXXXXXXXXXXXX
# Supabase service role key (solo para el webhook — nunca al cliente)
# En Supabase → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJXXXXXXXXXXXXXXXXXXXXXXXXX
# URL pública del sitio (para los redirect URLs de Stripe)
PUBLIC_SITE_URL=https://mediq.app
