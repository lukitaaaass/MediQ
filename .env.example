# Copia este archivo a .env y rellena con tus credenciales

# Supabase (anon/publishable — seguras en el frontend)
PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXX

# Groq (privada — solo se usa en el servidor, nunca llega al navegador)
