---
/**
 * Layout compartido de MediQ.
 *
 * Props:
 *   title          — <title> de la página
 *   description    — meta description y og:description
 *   navActive      — ruta activa en nav ('/', '/pricing', '/chat', '/train', '/triadas', '/login')
 *   bodyClass      — clase extra en <body> (p. ej. 'chat-page', 'auth-page')
 *   includePdfJs   — añadir pdf.js al head (solo chat y train)
 *
 * Slots:
 *   default        — contenido de la página
 *   nav-actions    — bloque derecho del nav; por defecto: botones auth + IIFE Supabase
 *   head           — elementos extra para <head>
 */
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  navActive?: string;
  bodyClass?: string;
  includePdfJs?: boolean;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title        = 'MediQ — Soporte clínico con IA',
  description  = 'Asistente clínico con IA para médicos hispanohablantes. Diagnósticos diferenciales, verificador de interacciones y más.',
  navActive    = '',
  bodyClass    = '',
  includePdfJs = false,
  ogImage      = 'https://mediq.app/og.svg',
  noindex      = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://mediq.app').href;

const SUPABASE_URL        = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_ANON_KEY   = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
const PLAUSIBLE_DOMAIN    = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonicalURL} />
  <link rel="sitemap" href="/sitemap.xml" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale"      content="es_ES" />
  <meta property="og:site_name"   content="MediQ" />

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={ogImage} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Instrument+Serif:ital@0;1&family=Newsreader:opsz,wght@6..72,300;6..72,400;6..72,500;6..72,600&family=Inter:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@300;400;500&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  />

  <!-- Supabase SDK: disponible como window.supabase en todos los scripts de página -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <!-- pdf.js: solo en páginas que lo solicitan (chat, train) -->
  {includePdfJs && (
    <script is:inline type="module">
      import * as pdfjsLib from 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.0.379/pdf.min.mjs';
      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.0.379/pdf.worker.min.mjs';
      window.pdfjsLib = pdfjsLib;
    </script>
  )}

  <ViewTransitions />
  <slot name="head" />

  <!--
    CSS crítico para el toggle de auth. is:inline => se renderiza tal cual
    en el <head> del HTML, no se bundlea en un archivo externo. Así funciona
    incluso si el CSS de página falla en cargar (deploy en curso, 404, etc.)
    y nunca se ven ambos estados a la vez.
  -->
  <style is:inline>
    .nav-auth-state { display: none !important; }
    html[data-auth="out"] #nav-auth-out { display: flex !important; }
    html[data-auth="in"]  #nav-auth-in  { display: flex !important; }
    html[data-auth="out"] #nav-mobile-auth-out { display: flex !important; flex-direction: column; gap: 10px; }
    html[data-auth="in"]  #nav-mobile-auth-in  { display: flex !important; flex-direction: column; gap: 10px; }
    /* Enlaces de la nav condicionales segun sesion.
       Se hacen visibles en distintos contextos con display distinto:
       inline en desktop (.nav-links), block en mobile (#nav-mobile nav). */
    .nav-only-in, .nav-only-out { display: none !important; }
    html[data-auth="in"]  .nav-links .nav-only-in  { display: inline !important; }
    html[data-auth="out"] .nav-links .nav-only-out { display: inline !important; }
    html[data-auth="in"]  #nav-mobile .nav-only-in  { display: block !important; }
    html[data-auth="out"] #nav-mobile .nav-only-out { display: block !important; }
  </style>

  <!-- Plausible Analytics (solo si PUBLIC_PLAUSIBLE_DOMAIN está definido) -->
  {PLAUSIBLE_DOMAIN && (
    <script
      is:inline
      defer
      data-domain={PLAUSIBLE_DOMAIN}
      src="https://plausible.io/js/script.tagged-events.js"
    ></script>
  )}

  <!-- Helper global window.track() — no-op si Plausible no está cargado -->
  <script is:inline>
    window.track = function(event, props) {
      try {
        if (typeof window.plausible === 'function') window.plausible(event, { props: props || {} });
      } catch (_) {}
    };
  </script>

  <!--
    Script de pre-paint: aplica tema, tweaks y estado de sesión ANTES del
    primer paint para eliminar cualquier flash (FOUC de color, tipografía
    o botones de nav).
  -->
  <script is:inline>
    (function () {
      var r = document.documentElement;

      // Dark mode — inline styles tienen máxima prioridad, nada puede sobrescribirlas
      try {
        var _dark = localStorage.getItem('mediq.theme') === 'dark';
        r.setAttribute('data-dark', _dark ? 'true' : 'false');
        if (_dark) {
          // Debe coincidir con las variables de html[data-dark="true"] en global.css.
          // Si actualizas la paleta allí, actualízala aquí también.
          var _dv = {'--bg':'#0e1113','--bg-2':'#14181b','--ink':'#f2f0ea','--ink-soft':'#c6c3ba','--ink-mute':'#7f837f','--rule':'#f2f0ea14','--rule-2':'#f2f0ea22','--accent':'oklch(74% 0.11 195)','--accent-ink':'#0e1113','--accent-text':'oklch(74% 0.11 195)','--surface':'#191d20'};
          for (var _k in _dv) r.style.setProperty(_k, _dv[_k]);
        }
      } catch (e) { r.setAttribute('data-dark', 'false'); }

      // Tweaks de diseño (paleta, tipografía, estilo visual)
      try {
        var tw = JSON.parse(localStorage.getItem('mediq:tweaks') || 'null') || {
          theme: 'clinical', typePair: 'serif-soft', visualStyle: 'technical'
        };
        r.setAttribute('data-theme', tw.theme);
        r.setAttribute('data-type',  tw.typePair);
        r.setAttribute('data-style', tw.visualStyle);
      } catch (e) {
        r.setAttribute('data-theme', 'clinical');
        r.setAttribute('data-type',  'serif-soft');
        r.setAttribute('data-style', 'technical');
      }

      // Pista de sesión: pinta el header correcto desde el primer render
      try {
        r.setAttribute('data-auth',
          localStorage.getItem('mediq.authHint') === 'in' ? 'in' : 'out');
      } catch (e) { r.setAttribute('data-auth', 'out'); }
    })();
  </script>
</head>

<body class={bodyClass}>

  <a href="#main-content" class="skip-link">Ir al contenido principal</a>

  <nav class="top">
    <div class="container row">
      <a class="brand" href="/">
        <span class="brand-mark"></span>
        <span data-brand>MediQ</span>
      </a>

      <div class="nav-links">
        {/* Enlaces publicos — siempre visibles */}
        <a href="/"          class:list={[{ active: navActive === '/'          }]}>Inicio</a>
        <a href="/demo"      class="nav-only-out" class:list={[{ active: navActive === '/demo' }]}>Demo</a>
        <a href="/informes"  class:list={[{ active: navActive === '/informes'  }]}>Informes</a>
        <a href="/pricing"   class:list={[{ active: navActive === '/pricing'   }]}>Precios</a>

        {/* Enlaces de la app — solo con sesion iniciada */}
        <a href="/chat"      class="nav-only-in"  class:list={[{ active: navActive === '/chat'    }]}>Chat</a>
        <a href="/train"     class="nav-only-in"  class:list={[{ active: navActive === '/train'   }]}>Entrenar IA</a>
        <a href="/triadas"   class="nav-only-in"  class:list={[{ active: navActive === '/triadas' }]}>Tríadas</a>

        {/* MIR page existe (/mir + waitlist) pero desactivada del nav hasta que decidamos abrir el canal residentes. Reactivar aqui + en mobile nav abajo. */}
      </div>

      <!--
        Slot nav-actions:
        - Default: botones "Entrar" / "Solicitar acceso" con id="nav-auth"
          El script al final del body lo reemplaza si hay sesión activa.
        - login.astro: lo reemplaza con "Volver al inicio"
        - chat.astro:  lo reemplaza con su propio user-trigger
      -->
      <button id="theme-toggle" aria-label="Cambiar tema" title="Cambiar tema" style="width:36px;height:36px;border-radius:50%;display:grid;place-items:center;color:var(--ink-mute);transition:background .15s,color .15s;flex-shrink:0;">
        <svg id="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" style="display:none"><circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.7"/><path d="M12 2v2M12 20v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M2 12h2M20 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        <svg id="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>

      <div id="nav-actions-wrap">
        <slot name="nav-actions">
          <!--
            Renderizamos AMBOS estados en HTML. El CSS usa
            html[data-auth="in|out"] para mostrar uno u otro sin flash.
            El script de Supabase de abajo confirma/corrige el estado.
          -->
          <div id="nav-auth-out" class="nav-auth-state" style="display:flex; gap:10px; align-items:center;">
            <a class="btn btn-ghost"   href="/login">Entrar</a>
            <a class="btn btn-primary" href="/login">Solicitar acceso <span aria-hidden="true">→</span></a>
          </div>
          <div id="nav-auth-in" class="nav-auth-state" style="display:flex; gap:10px; align-items:center;">
            <span style="display:flex;align-items:center;gap:6px;font-size:13.5px;color:var(--ink-soft);">
              <span style="width:7px;height:7px;border-radius:50%;background:var(--ok);flex-shrink:0;"></span>
              <span id="nav-auth-name">&nbsp;</span>
            </span>
            <a class="btn btn-ghost" href="/account">Mi cuenta</a>
            <button type="button" class="btn btn-ghost" id="nav-logout" title="Cerrar sesión" aria-label="Cerrar sesión">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M15 3h5a1 1 0 011 1v16a1 1 0 01-1 1h-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M10 17l-5-5 5-5M5 12h11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>Salir</span>
            </button>
          </div>
        </slot>
      </div>

      <!-- Botón hamburguesa (solo móvil) -->
      <button id="nav-burger" aria-label="Abrir menú" aria-expanded="false" style="width:36px;height:36px;border-radius:8px;flex-direction:column;align-items:center;justify-content:center;gap:5px;color:var(--ink);flex-shrink:0;">
        <span class="burger-line"></span>
        <span class="burger-line"></span>
        <span class="burger-line"></span>
      </button>
    </div>
  </nav>

  <!-- Pre-fill nombre: evita que aparezca vacío hasta que Supabase responde -->
  <script is:inline>
    (function () {
      const nameEl = document.getElementById('nav-auth-name');
      if (nameEl && localStorage.getItem('mediq.authHint') === 'in') {
        const saved = localStorage.getItem('mediq.userName');
        if (saved) nameEl.textContent = saved;
      }
    })();
  </script>

  <!-- Menú móvil -->
  <div id="nav-mobile" aria-hidden="true">
    <nav>
      <a href="/">Inicio</a>
      <a href="/demo" class="nav-only-out">Demo</a>
      <a href="/informes">Informes</a>
      <a href="/pricing">Precios</a>
      <a href="/chat" class="nav-only-in">Chat</a>
      <a href="/train" class="nav-only-in">Entrenar IA</a>
      <a href="/triadas" class="nav-only-in">Tríadas</a>
      {/* MIR page existe (/mir + waitlist) pero desactivada del nav. Reactivar aqui + en desktop nav arriba. */}
    </nav>
    <div id="nav-mobile-auth">
      <div id="nav-mobile-auth-out" class="nav-auth-state">
        <a class="btn btn-ghost" href="/login">Entrar</a>
        <a class="btn btn-primary" href="/login">Solicitar acceso →</a>
      </div>
      <div id="nav-mobile-auth-in" class="nav-auth-state">
        <a class="btn btn-ghost" href="/account">Mi cuenta</a>
        <a class="btn btn-primary" href="/chat">Ir al chat →</a>
        <button type="button" class="btn btn-ghost" id="nav-mobile-logout">Cerrar sesión</button>
      </div>
    </div>
  </div>

  <span id="main-content" aria-hidden="true" style="position:absolute;"></span>
  <slot />

  <!-- Dark mode toggle -->
  <script is:inline>
    (function () {
      /* ── Variables de dark mode (una sola definición global) ── */
      if (!window.__DARK_VARS) {
        window.__DARK_VARS = {
          '--bg':'#0e1113','--bg-2':'#14181b','--ink':'#f2f0ea',
          '--ink-soft':'#c6c3ba','--ink-mute':'#7f837f',
          '--rule':'#f2f0ea14','--rule-2':'#f2f0ea22',
          '--accent':'oklch(78% 0.13 155)','--accent-ink':'#0e1113',
          '--surface':'#191d20','--ok':'oklch(70% 0.14 155)',
          '--success':'oklch(72% 0.16 145)','--danger':'oklch(68% 0.20 25)',
          '--info':'oklch(70% 0.14 240)','--warn':'oklch(75% 0.16 40)'
        };
      }

      /* ── Función global: aplica o quita dark mode ── */
      window.__applyTheme = function (dark) {
        var root = document.documentElement;
        root.setAttribute('data-dark', dark ? 'true' : 'false');
        var keys = Object.keys(window.__DARK_VARS);
        for (var i = 0; i < keys.length; i++) {
          if (dark) root.style.setProperty(keys[i], window.__DARK_VARS[keys[i]]);
          else root.style.removeProperty(keys[i]);
        }
        var sun  = document.getElementById('icon-sun');
        var moon = document.getElementById('icon-moon');
        if (sun)  sun.style.display  = dark ? '' : 'none';
        if (moon) moon.style.display = dark ? 'none' : '';
        try { localStorage.setItem('mediq.theme', dark ? 'dark' : 'light'); } catch (_) {}
      };

      /* ── astro:page-load: dispara en carga inicial Y tras cada View Transition ── */
      /* Se registra UNA sola vez; Astro lo dispara siempre. */
      if (!window.__themePageLoadReg) {
        window.__themePageLoadReg = true;
        document.addEventListener('astro:page-load', function () {
          // Sincroniza estado visual con localStorage
          window.__applyTheme(localStorage.getItem('mediq.theme') === 'dark');

          // Re-bind del botón toggle (el DOM se reemplaza en cada navegación)
          var btn = document.getElementById('theme-toggle');
          if (btn) {
            btn.onclick = function () {
              window.__applyTheme(document.documentElement.getAttribute('data-dark') !== 'true');
            };
            btn.onmouseenter = function () { btn.style.background = 'var(--bg-2)'; };
            btn.onmouseleave = function () { btn.style.background = ''; };
          }
        });
      }

      /* ── astro:before-swap: copia estado al documento entrante (solo 1 vez) ── */
      if (!window.__themeSwapReg) {
        window.__themeSwapReg = true;
        document.addEventListener('astro:before-swap', function (e) {
          var src = document.documentElement;
          var dst = e.newDocument.documentElement;
          ['data-dark', 'data-theme', 'data-type', 'data-style', 'data-auth'].forEach(function (attr) {
            var v = src.getAttribute(attr);
            if (v != null) dst.setAttribute(attr, v);
          });
          // Copia inline styles de dark mode al nuevo documento
          var keys = Object.keys(window.__DARK_VARS);
          for (var i = 0; i < keys.length; i++) {
            var v = src.style.getPropertyValue(keys[i]);
            if (v) dst.style.setProperty(keys[i], v);
            else dst.style.removeProperty(keys[i]);
          }
          window.__astroNavDir = e.direction;
          if (e.direction === 'back') {
            src.setAttribute('data-no-reveal', '');
          } else {
            src.removeAttribute('data-no-reveal');
          }
        });
      }

      /* ── popstate (solo 1 vez) ── */
      if (!window.__pstateReg) {
        window.__pstateReg = true;
        window.addEventListener('popstate', function () { window.__didPop = true; });
      }

      /* ── Aplicar inmediatamente (para el caso de primer render sin astro:page-load) ── */
      window.__applyTheme(localStorage.getItem('mediq.theme') === 'dark');
    })();
  </script>

  <!-- Menú hamburguesa -->
  <script is:inline>
    (function () {
      const burger = document.getElementById('nav-burger');
      const menu   = document.getElementById('nav-mobile');
      if (!burger || !menu) return;

      burger.addEventListener('click', () => {
        const open = menu.classList.toggle('open');
        burger.classList.toggle('open', open);
        burger.setAttribute('aria-expanded', open);
        menu.setAttribute('aria-hidden', !open);
        document.body.style.overflow = open ? 'hidden' : '';
      });

      menu.querySelectorAll('a').forEach(a => {
        a.addEventListener('click', () => {
          menu.classList.remove('open');
          burger.classList.remove('open');
          burger.setAttribute('aria-expanded', 'false');
          menu.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        });
      });
    })();
  </script>

  <!--
    Comprobación de sesión Supabase.
    En vez de reescribir el HTML (que provoca el flash), aquí solo:
      1. Guardamos mediq.authHint en localStorage para que el script del
         <head> pinte el header correcto en la SIGUIENTE navegación.
      2. Corregimos data-auth en el documento actual si es necesario.
      3. Rellenamos el nombre dentro del slot ya existente.
  -->
  <script is:inline define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY }}>
    (function () {
      const root   = document.documentElement;
      // nameEl solo existe en páginas con el slot nav-actions por defecto.
      // En chat/login/account se usa un slot personalizado, pero igual
      // necesitamos el sync entre pestañas → no hacemos early return.
      const nameEl = document.getElementById('nav-auth-name');

      const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

      function applySession(session) {
        const hint = session ? 'in' : 'out';
        root.setAttribute('data-auth', hint);
        try { localStorage.setItem('mediq.authHint', hint); } catch (_) {}
        if (session) {
          const raw = session.user.user_metadata?.name || session.user.email.split('@')[0];
          const first = raw.split(' ')[0];
          try { localStorage.setItem('mediq.userName', first); } catch (_) {}
          if (nameEl) nameEl.textContent = first;
        } else {
          try { localStorage.removeItem('mediq.userName'); } catch (_) {}
          if (nameEl) nameEl.textContent = '';
        }
      }

      sb.auth.getSession().then(({ data: { session } }) => applySession(session));

      // Supabase dispara onAuthStateChange en TODAS las pestañas cuando
      // la sesión cambia, gracias a su listener interno de storage.
      sb.auth.onAuthStateChange((_event, session) => applySession(session));

      // ─── Cerrar sesión ───
      // Botones "Salir" del nav (desktop + móvil). Solo existen en páginas
      // que usan el slot nav-actions por defecto (index, pricing, demo,
      // contact, train, triadas). En chat/account/login el slot se
      // reemplaza y esos elementos no están en el DOM → null-guard.
      async function doLogout(e) {
        if (e) e.preventDefault();
        try { await sb.auth.signOut(); } catch (_) {}
        try {
          localStorage.removeItem('mediq.authHint');
          localStorage.removeItem('mediq.userName');
        } catch (_) {}
        location.href = '/';
      }
      const desktopLogout = document.getElementById('nav-logout');
      const mobileLogout  = document.getElementById('nav-mobile-logout');
      if (desktopLogout) desktopLogout.addEventListener('click', doLogout);
      if (mobileLogout)  mobileLogout.addEventListener('click', doLogout);
    })();
  </script>

</body>
</html>
