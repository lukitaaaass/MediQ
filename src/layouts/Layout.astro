---
/**
 * Layout compartido de Hygia.
 *
 * Props:
 *   title          — <title> de la página
 *   description    — meta description y og:description
 *   navActive      — ruta activa en nav ('/', '/pricing', '/chat', '/train', '/triadas', '/login')
 *   bodyClass      — clase extra en <body> (p. ej. 'chat-page', 'auth-page')
 *   includePdfJs   — añadir pdf.js al head (solo chat y train)
 *
 * Slots:
 *   default        — contenido de la página
 *   nav-actions    — bloque derecho del nav; por defecto: botones auth + IIFE Supabase
 *   head           — elementos extra para <head>
 */
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  navActive?: string;
  bodyClass?: string;
  includePdfJs?: boolean;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title        = 'Hygia — Soporte clínico con IA',
  description  = 'Asistente clínico con IA para médicos hispanohablantes. Diagnósticos diferenciales, verificador de interacciones y más.',
  navActive    = '',
  bodyClass    = '',
  includePdfJs = false,
  ogImage      = 'https://medi-q-bice.vercel.app/og.svg',
  noindex      = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://medi-q-bice.vercel.app').href;

/* Secciones que tienen historial propio en el bloque "Recientes" del panel
   lateral. El Layout solo pinta el contenedor (#sb-list) y el boton de nuevo;
   cada pagina lo rellena con sus elementos y decide que hace el "+". Las
   secciones que no estan aqui no muestran el bloque. */
const RECENT_SECTIONS: Record<string, string> = {
  '/chat':       'Nueva consulta',
  '/informes':   'Nuevo informe',
  '/analiticas': 'Nueva analítica',
};
const recentNewLabel = RECENT_SECTIONS[navActive] ?? null;

const SUPABASE_URL        = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_ANON_KEY   = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
const PLAUSIBLE_DOMAIN    = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonicalURL} />
  <link rel="sitemap" href="/sitemap.xml" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale"      content="es_ES" />
  <meta property="og:site_name"   content="Hygia" />

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={ogImage} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500;9..144,600&family=Instrument+Serif:ital@0;1&family=Newsreader:opsz,wght@6..72,300;6..72,400;6..72,500;6..72,600&family=Inter:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@300;400;500&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  />

  <!-- Supabase SDK: disponible como window.supabase en todos los scripts de página -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <!--
    Singleton de GoTrueClient. DEBE crearse aqui (head, sincrono, tras el SDK)
    para que exista antes que cualquier <script is:inline> de body — si no,
    las paginas crean su propio cliente en el fallback `|| createClient(...)`
    y acaban dos GoTrueClient peleandose por el mismo refresh token single-use,
    lo que invalida la sesion. El guard evita re-crearlo en ViewTransitions.
  -->
  <script is:inline define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY }}>
    if (!window.__mediqSb) {
      console.log('[Hygia] singleton createClient @ head');
      window.__mediqSb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
    } else {
      console.log('[Hygia] singleton already exists — skip');
    }
  </script>

  <!-- pdf.js: solo en páginas que lo solicitan (chat, train) -->
  {includePdfJs && (
    <script is:inline type="module">
      import * as pdfjsLib from 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.0.379/pdf.min.mjs';
      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.0.379/pdf.worker.min.mjs';
      window.pdfjsLib = pdfjsLib;
    </script>
  )}

  <ViewTransitions />
  <slot name="head" />

  <!--
    CSS crítico para el toggle de auth. is:inline => se renderiza tal cual
    en el <head> del HTML, no se bundlea en un archivo externo. Así funciona
    incluso si el CSS de página falla en cargar (deploy en curso, 404, etc.)
    y nunca se ven ambos estados a la vez.
  -->
  <style is:inline>
    .nav-auth-state { display: none !important; }
    html[data-auth="out"] #nav-auth-out { display: flex !important; }
    html[data-auth="in"]  #nav-auth-in  { display: flex !important; }
    html[data-auth="out"] #nav-mobile-auth-out { display: flex !important; flex-direction: column; gap: 10px; }
    html[data-auth="in"]  #nav-mobile-auth-in  { display: flex !important; flex-direction: column; gap: 10px; }
    /* Enlaces de la nav condicionales segun sesion.
       Se hacen visibles en distintos contextos con display distinto:
       inline en desktop (.nav-links), block en mobile (#nav-mobile nav). */
    .nav-only-in, .nav-only-out { display: none !important; }
    html[data-auth="in"]  .nav-links .nav-only-in  { display: inline !important; }
    html[data-auth="out"] .nav-links .nav-only-out { display: inline !important; }
    html[data-auth="in"]  #nav-mobile .nav-only-in  { display: block !important; }
    html[data-auth="out"] #nav-mobile .nav-only-out { display: block !important; }
    /* Panel lateral: sus filas son flex (icono + etiqueta), no inline ni block. */
    html[data-auth="in"]  #app-sidebar .nav-only-in  { display: flex !important; }
    html[data-auth="out"] #app-sidebar .nav-only-out { display: flex !important; }
    html[data-auth="out"] #rail-auth-out { display: flex !important; flex-direction: column; }
    html[data-auth="in"]  #rail-auth-in  { display: flex !important; flex-direction: column; }
    /* "Recientes" solo tiene sentido con sesion: sin ella no hay nada que listar. */
    html[data-auth="in"]  #sb-recent { display: flex !important; flex-direction: column; }
    /* Elementos de CONTENIDO condicionales segun sesion (CTAs de registro, etc.).
       A diferencia de .nav-only-*, estos OCULTAN en vez de mostrar: asi el
       elemento conserva su display natural (inline-flex en los .btn) cuando
       debe verse, sin que haya que declararlo aqui para cada caso. */
    html[data-auth="in"]  .auth-hide-in { display: none !important; }

    /* Ocultado estructural de la navegacion — DUPLICADO A PROPOSITO desde
       global.css. Estos dos bloques solo deben verse cuando les toca: el panel
       movil al pulsar la hamburguesa, y el rail solo en escritorio. Si esas
       reglas vivieran unicamente en la hoja externa, cualquier momento en que
       esa hoja no este aplicada todavia (primer render, cache apuntando a un
       hash antiguo, fallo de red durante un deploy) los pinta como bloques
       normales al principio del body: el menu entero y el boton "Cerrar sesion"
       enmarcado, encima del contenido. Al estar aqui, inline en el <head>, no
       hay ninguna ventana en la que eso pueda pasar.

       Los valores coinciden con los de global.css a proposito: al ser identicos
       da igual cual de las dos hojas gane la cascada, que es justo lo que hace
       que esto sea seguro.

       NO añadir aqui reglas de #app-sidebar. Se probo `#nav-rail{display:none}` y
       rompio la navegacion: los <link> del sitio van DESPUES de este <style>,
       asi que en carga normal ganaba global.css y el rail se veia, pero al
       navegar con ViewTransitions Astro reordena el head, pasaba a ganar esta
       regla y el rail desaparecia hasta recargar — dejando la pagina sin
       ninguna navegacion. Cualquier regla de rail que se ponga aqui compite con
       global.css a igual especificidad y depende del orden. Que viva solo en
       global.css. */
    #nav-mobile { position: fixed; inset: 64px 0 0 0; transform: translateY(-110%); pointer-events: none; }
    #nav-mobile.open { transform: translateY(0); pointer-events: auto; }
  </style>

  <!-- Plausible Analytics (solo si PUBLIC_PLAUSIBLE_DOMAIN está definido) -->
  {PLAUSIBLE_DOMAIN && (
    <script
      is:inline
      defer
      data-domain={PLAUSIBLE_DOMAIN}
      src="https://plausible.io/js/script.tagged-events.js"
    ></script>
  )}

  <!-- Helper global window.track() — no-op si Plausible no está cargado -->
  <script is:inline>
    window.track = function(event, props) {
      try {
        if (typeof window.plausible === 'function') window.plausible(event, { props: props || {} });
      } catch (_) {}
    };
  </script>

  <!--
    Script de pre-paint: aplica tema, tweaks y estado de sesión ANTES del
    primer paint para eliminar cualquier flash (FOUC de color, tipografía
    o botones de nav).
  -->
  <script is:inline>
    (function () {
      var r = document.documentElement;

      // Dark mode — inline styles tienen máxima prioridad, nada puede sobrescribirlas
      try {
        var _dark = localStorage.getItem('mediq.theme') === 'dark';
        r.setAttribute('data-dark', _dark ? 'true' : 'false');
        if (_dark) {
          // Debe coincidir con las variables de html[data-dark="true"] en global.css.
          // Si actualizas la paleta allí, actualízala aquí también.
          var _dv = {'--bg':'#0e1113','--bg-2':'#14181b','--ink':'#f2f0ea','--ink-soft':'#c6c3ba','--ink-mute':'#7f837f','--rule':'#f2f0ea14','--rule-2':'#f2f0ea22','--accent':'oklch(74% 0.11 195)','--accent-ink':'#0e1113','--accent-text':'oklch(74% 0.11 195)','--surface':'#191d20'};
          for (var _k in _dv) r.style.setProperty(_k, _dv[_k]);
        }
      } catch (e) { r.setAttribute('data-dark', 'false'); }

      // Tweaks de diseño (paleta, tipografía, estilo visual)
      try {
        var tw = JSON.parse(localStorage.getItem('mediq:tweaks') || 'null') || {
          theme: 'clinical', typePair: 'serif-soft', visualStyle: 'technical'
        };
        r.setAttribute('data-theme', tw.theme);
        r.setAttribute('data-type',  tw.typePair);
        r.setAttribute('data-style', tw.visualStyle);
      } catch (e) {
        r.setAttribute('data-theme', 'clinical');
        r.setAttribute('data-type',  'serif-soft');
        r.setAttribute('data-style', 'technical');
      }

      // Pista de sesión: pinta el header correcto desde el primer render
      try {
        r.setAttribute('data-auth',
          localStorage.getItem('mediq.authHint') === 'in' ? 'in' : 'out');
      } catch (e) { r.setAttribute('data-auth', 'out'); }

      // Estado plegado/desplegado del panel lateral. Va aquí y no en el
      // script del final del body para que la primera pintura ya reserve
      // (o no) el hueco del panel y no haya salto de layout.
      try {
        if (localStorage.getItem('mediq.sidebar') === 'off') r.setAttribute('data-sb', 'off');
      } catch (e) {}
    })();
  </script>
</head>

<body class={bodyClass}>

  <a href="#main-content" class="skip-link">Ir al contenido principal</a>

  {/*
    Panel lateral — solo visible en escritorio (>720px), donde sustituye a
    la barra superior. En movil se oculta por CSS y manda nav.top + #nav-mobile.
    Los enlaces replican los de nav.top; si añades uno, añadelo en los tres
    sitios (panel, nav.top y #nav-mobile).

    "Plan" NO va aqui a proposito: se llega solo desde el menu de perfil.
  */}
  <button id="sb-reopen" aria-label="Mostrar panel" title="Mostrar panel">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2.5" stroke="currentColor" stroke-width="1.7"/><path d="M9.5 4v16" stroke="currentColor" stroke-width="1.7"/></svg>
  </button>

  <aside id="app-sidebar" aria-label="Navegación principal">
    <div class="sb-top">
      <a class="sb-logo" href="/" aria-label="Hygia — inicio">
        <span class="brand-mark"></span>
      </a>
      <button id="sb-search-btn" class="sb-icon-btn" aria-label="Buscar" aria-expanded="false" title="Buscar">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.7"/><path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
      </button>
      <button id="sb-toggle" class="sb-icon-btn" aria-label="Ocultar panel" title="Ocultar panel">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2.5" stroke="currentColor" stroke-width="1.7"/><path d="M9.5 4v16" stroke="currentColor" stroke-width="1.7"/></svg>
      </button>
    </div>

    <div class="sb-search" id="sb-search-wrap" hidden>
      <div class="sb-search-box" id="sb-search-box">
        <svg class="ic-search" width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8"/><path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        <input type="search" id="sb-search" placeholder="Buscar…" autocomplete="off" />
        <button type="button" class="clear-x" id="sb-clear" aria-label="Limpiar">
          <svg width="9" height="9" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 2l8 8M10 2l-8 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </button>
      </div>
    </div>
    <div class="sb-search-info" id="sb-search-info" style="display:none;"></div>

    <nav class="sb-nav">
      <a href="/" class:list={['sb-nav-item', { active: navActive === '/' }]}>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3.5 10.5L12 3.5l8.5 7v9a1 1 0 01-1 1h-4.5v-6h-6v6H4.5a1 1 0 01-1-1z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Inicio
      </a>
      <a href="/demo" class:list={['sb-nav-item', 'nav-only-out', { active: navActive === '/demo' }]}>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M10 8.5l6 3.5-6 3.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        Demo
      </a>
      <a href="/informes" class:list={['sb-nav-item', { active: navActive === '/informes' }]}>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 2.5H6.5a1 1 0 00-1 1v17a1 1 0 001 1h11a1 1 0 001-1V7z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M14 2.5V7h4.5M9 12h6M9 16h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Informes
      </a>
      <a href="/analiticas" class:list={['sb-nav-item', { active: navActive === '/analiticas' }]}>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3.2s5.8 6.2 5.8 10a5.8 5.8 0 11-11.6 0c0-3.8 5.8-10 5.8-10z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9.4 13.6h5.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        Analíticas
      </a>
      <a href="/blog" class:list={['sb-nav-item', { active: navActive === '/blog' }]}>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4.5 5A2.5 2.5 0 017 2.5h12.5v19H7A2.5 2.5 0 004.5 19z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M4.5 19A2.5 2.5 0 017 16.5h12.5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        Biblioteca
      </a>
      <a href="/chat" class:list={['sb-nav-item', 'nav-only-in', { active: navActive === '/chat' }]}>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.5 12.5a7 7 0 01-7 7H9l-5 3v-5.2a7 7 0 013-12.8h4.5a7 7 0 017 7z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        Chat
      </a>
      <a href="/train" class:list={['sb-nav-item', 'nav-only-in', { active: navActive === '/train' }]}>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3.2l1.9 5.4 5.4 1.9-5.4 1.9L12 17.8l-1.9-5.4-5.4-1.9 5.4-1.9z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M18.5 16.5l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
        Entrenar IA
      </a>
      <a href="/triadas" class:list={['sb-nav-item', 'nav-only-in', { active: navActive === '/triadas' }]}>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="5" r="2.4" stroke="currentColor" stroke-width="1.6"/><circle cx="5.5" cy="17.5" r="2.4" stroke="currentColor" stroke-width="1.6"/><circle cx="18.5" cy="17.5" r="2.4" stroke="currentColor" stroke-width="1.6"/><path d="M10.8 7.1l-4.1 8.3M13.2 7.1l4.1 8.3M8 17.5h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        Tríadas
      </a>
    </nav>

    <div class="sb-sep"></div>

    {recentNewLabel && (
      <div class="sb-recent nav-auth-state" id="sb-recent" data-auth-only>
        <div class="sb-recent-head">
          <span>Recientes</span>
          <button class="sb-icon-btn" id="sb-new" aria-label={recentNewLabel} title={recentNewLabel}>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
        </div>
        <div class="sb-list" id="sb-list"></div>
      </div>
    )}
    {!recentNewLabel && <div class="sb-spacer"></div>}

    <div id="rail-auth-out" class="nav-auth-state">
      <a class="sb-nav-item" href="/login" style="margin:0 8px 10px;">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 3.5H4.5a1 1 0 00-1 1v15a1 1 0 001 1H9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M14 16l5-4-5-4M19 12H8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Entrar
      </a>
    </div>

    {/* Chip de perfil: abre el menu con Mi cuenta / Plan / Configuración /
        Cerrar sesión. Es la unica via a "Plan" y a "Configuración". */}
    <div id="rail-auth-in" class="nav-auth-state">
      <button type="button" class="sb-user" id="sb-user-btn" aria-haspopup="menu" aria-label="Perfil y ajustes">
        <span class="sb-user-ava" id="sb-user-ava">·</span>
        <span class="sb-user-body">
          <span class="sb-user-name" id="sb-user-name">Mi cuenta</span>
          <span class="sb-user-hint">Perfil y ajustes</span>
        </span>
        <svg class="sb-user-caret" width="10" height="10" viewBox="0 0 12 12" aria-hidden="true">
          <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </aside>

  {/* Menú del chip de perfil. Vive aquí, no en las páginas: el chip está en
      todas y antes la lógica estaba solo en chat.astro, así que pulsarlo no
      hacía nada en el resto del sitio. */}
  <div class="user-menu" id="user-menu" style="display:none;"></div>

  <nav class="top">
    <div class="container row">
      <a class="brand" href="/">
        <span class="brand-mark"></span>
        <span data-brand>Hygia</span>
      </a>

      <div class="nav-links">
        {/* Enlaces publicos — siempre visibles */}
        <a href="/"          class:list={[{ active: navActive === '/'          }]}>Inicio</a>
        <a href="/demo"      class="nav-only-out" class:list={[{ active: navActive === '/demo' }]}>Demo</a>
        <a href="/informes"   class:list={[{ active: navActive === '/informes'   }]}>Informes</a>
        <a href="/analiticas" class:list={[{ active: navActive === '/analiticas' }]}>Analíticas</a>
        <a href="/blog"       class:list={[{ active: navActive === '/blog'       }]}>Biblioteca</a>
        {/* "Plan" (/pricing) no va en la nav: se llega desde el menu de perfil. */}

        {/* Enlaces de la app — solo con sesion iniciada */}
        <a href="/chat"      class="nav-only-in"  class:list={[{ active: navActive === '/chat'    }]}>Chat</a>
        <a href="/train"     class="nav-only-in"  class:list={[{ active: navActive === '/train'   }]}>Entrenar IA</a>
        <a href="/triadas"   class="nav-only-in"  class:list={[{ active: navActive === '/triadas' }]}>Tríadas</a>

        {/* MIR page existe (/mir + waitlist) pero desactivada del nav hasta que decidamos abrir el canal residentes. Reactivar aqui + en mobile nav abajo. */}
      </div>

      <!--
        Slot nav-actions:
        - Default: botones "Entrar" / "Solicitar acceso" con id="nav-auth"
          El script al final del body lo reemplaza si hay sesión activa.
        - login.astro: lo reemplaza con "Volver al inicio"
        - chat.astro:  lo reemplaza con su propio user-trigger
      -->
      <button id="theme-toggle" aria-label="Cambiar tema" title="Cambiar tema" style="width:36px;height:36px;border-radius:50%;display:grid;place-items:center;color:var(--ink-mute);transition:background .15s,color .15s;flex-shrink:0;">
        <svg id="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" style="display:none"><circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.7"/><path d="M12 2v2M12 20v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M2 12h2M20 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
        <svg id="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
