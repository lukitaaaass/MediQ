  <span id="main-content" aria-hidden="true" style="position:absolute;"></span>
  <slot />

  <!-- Dark mode toggle -->
  <script is:inline>
    (function () {
      /* ── Variables de dark mode (una sola definición global) ── */
      if (!window.__DARK_VARS) {
        window.__DARK_VARS = {
          '--bg':'#0e1113','--bg-2':'#14181b','--ink':'#f2f0ea',
          '--ink-soft':'#c6c3ba','--ink-mute':'#7f837f',
          '--rule':'#f2f0ea14','--rule-2':'#f2f0ea22',
          '--accent':'oklch(78% 0.13 155)','--accent-ink':'#0e1113',
          '--surface':'#191d20','--ok':'oklch(70% 0.14 155)',
          '--success':'oklch(72% 0.16 145)','--danger':'oklch(68% 0.20 25)',
          '--info':'oklch(70% 0.14 240)','--warn':'oklch(75% 0.16 40)'
        };
      }

      /* ── Función global: aplica o quita dark mode ── */
      window.__applyTheme = function (dark) {
        var root = document.documentElement;
        root.setAttribute('data-dark', dark ? 'true' : 'false');
        var keys = Object.keys(window.__DARK_VARS);
        for (var i = 0; i < keys.length; i++) {
          if (dark) root.style.setProperty(keys[i], window.__DARK_VARS[keys[i]]);
          else root.style.removeProperty(keys[i]);
        }
        var sun  = document.getElementById('icon-sun');
        var moon = document.getElementById('icon-moon');
        if (sun)  sun.style.display  = dark ? '' : 'none';
        if (moon) moon.style.display = dark ? 'none' : '';
        try { localStorage.setItem('mediq.theme', dark ? 'dark' : 'light'); } catch (_) {}
      };

      /* ── astro:page-load: dispara en carga inicial Y tras cada View Transition ── */
      /* Se registra UNA sola vez; Astro lo dispara siempre. */
      if (!window.__themePageLoadReg) {
        window.__themePageLoadReg = true;
        document.addEventListener('astro:page-load', function () {
          // Sincroniza estado visual con localStorage
          window.__applyTheme(localStorage.getItem('mediq.theme') === 'dark');

          // Re-bind del botón toggle (el DOM se reemplaza en cada navegación)
          var btn = document.getElementById('theme-toggle');
          if (btn) {
            btn.onclick = function () {
              window.__applyTheme(document.documentElement.getAttribute('data-dark') !== 'true');
            };
            btn.onmouseenter = function () { btn.style.background = 'var(--bg-2)'; };
            btn.onmouseleave = function () { btn.style.background = ''; };
          }
        });
      }

      /* ── astro:before-swap: copia estado al documento entrante (solo 1 vez) ── */
      if (!window.__themeSwapReg) {
        window.__themeSwapReg = true;
        document.addEventListener('astro:before-swap', function (e) {
          var src = document.documentElement;
          var dst = e.newDocument.documentElement;
          /* swapRootAttributes() de Astro borra TODOS los atributos de <html>
             y solo restaura los del documento servido, que no trae ninguno de
             estos (los pone el script de pre-pintado). Sin esta copia se
             pierden al navegar: data-sb faltaba y el panel plegado se volvia
             a desplegar en cada navegacion. */
          ['data-dark', 'data-theme', 'data-type', 'data-style', 'data-auth', 'data-sb'].forEach(function (attr) {
            var v = src.getAttribute(attr);
            if (v != null) dst.setAttribute(attr, v);
          });
          // Copia inline styles de dark mode al nuevo documento
          var keys = Object.keys(window.__DARK_VARS);
          for (var i = 0; i < keys.length; i++) {
            var v = src.style.getPropertyValue(keys[i]);
            if (v) dst.style.setProperty(keys[i], v);
            else dst.style.removeProperty(keys[i]);
          }
          window.__astroNavDir = e.direction;
          if (e.direction === 'back') {
            src.setAttribute('data-no-reveal', '');
          } else {
            src.removeAttribute('data-no-reveal');
          }
        });
      }

      /* ── popstate (solo 1 vez) ── */
      if (!window.__pstateReg) {
        window.__pstateReg = true;
        window.addEventListener('popstate', function () { window.__didPop = true; });
      }

      /* ── Aplicar inmediatamente (para el caso de primer render sin astro:page-load) ── */
      window.__applyTheme(localStorage.getItem('mediq.theme') === 'dark');
    })();
  </script>

  <!--
    Menú hamburguesa (móvil).

    Mismo problema de ciclo de vida que el panel lateral (ver comentario de
    mas arriba): este script is:inline no se re-ejecuta al navegar con
    ViewTransitions (Astro lo marca data-astro-exec por ser identico en toda
    pagina), pero el <body> SI se reemplaza entero, asi que #nav-burger y
    #nav-mobile son nodos nuevos tras cada navegacion.

    Por eso el cableado va en init(), que corre en cada astro:page-load, y
    se vincula con asignacion (onclick) en vez de addEventListener: es
    idempotente, asi que volver a llamar a init() no duplica handlers.
  -->
  <script is:inline>
    (function () {
      function init() {
        const burger = document.getElementById('nav-burger');
        const menu   = document.getElementById('nav-mobile');
        if (!burger || !menu) return;

        // Reset al entrar en cada pagina: si el menu quedo "open" en la
        // pagina anterior, el overflow del body se quedaria bloqueado en
        // 'hidden' para siempre porque el DOM que lo abrio ya no existe.
        menu.classList.remove('open');
        burger.classList.remove('open');
        burger.setAttribute('aria-expanded', 'false');
        menu.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';

        burger.onclick = () => {
          const open = menu.classList.toggle('open');
          burger.classList.toggle('open', open);
          burger.setAttribute('aria-expanded', open);
          menu.setAttribute('aria-hidden', !open);
          document.body.style.overflow = open ? 'hidden' : '';
        };

        menu.querySelectorAll('a').forEach(a => {
          a.onclick = () => {
            menu.classList.remove('open');
            burger.classList.remove('open');
            burger.setAttribute('aria-expanded', 'false');
            menu.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
          };
        });
      }

      // El listener de astro:page-load se registra una sola vez tras el
      // guard; init() en cambio corre en cada navegacion.
      if (!window.__mediqBurgerReg) {
        window.__mediqBurgerReg = true;
        document.addEventListener('astro:page-load', init);
      }

      // Primer render: astro:page-load tambien dispara en la carga inicial,
      // pero init() es idempotente y asi el menu responde cuanto antes.
      init();
    })();
  </script>

  <!-- Navegación a la propia página -->
  <script is:inline>
    (function () {
      /* ── Clic en un enlace a la página actual (p. ej. "Chat" estando en /chat) ──
         El ClientRouter de Astro hace igualmente el swap del body, pero NO
         re-ejecuta los scripts is:inline: su runtime marca como ya ejecutado
         (data-astro-exec) todo script del documento entrante idéntico a uno del
         documento actual — y en una navegación a la misma página lo son TODOS.
         El body queda en su estado estático "sin sesión" y ningún script lo
         corrige: parece un logout aunque la sesión de Supabase siga viva, y los
         listeners de la página (chat, etc.) mueren con el DOM viejo.

         Interceptamos en fase de captura (corre antes que el listener del
         router) y:
           · misma ruta y misma query → no navegar (no-op)
           · misma ruta con query distinta (p. ej. /chat?caso=x desde /chat) →
             carga completa, que sí re-ejecuta todos los scripts */
      if (!window.__mediqSameNavReg) {
        window.__mediqSameNavReg = true;
        var normPath = function (p) { return p.replace(/\/+$/, '') || '/'; };
        document.addEventListener('click', function (e) {
          if (e.defaultPrevented || e.button !== 0) return;
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
          if (!a || a.origin !== location.origin) return;
          if ((a.target && a.target !== '_self') || a.hasAttribute('download')) return;
          if (normPath(a.pathname) !== normPath(location.pathname)) return;
          if (a.hash) return; // anclas dentro de la página: comportamiento normal
          e.preventDefault();
          if (a.search !== location.search) location.assign(a.href);
        }, true);
      }
    })();
  </script>

  <!--
    Panel lateral: plegar/desplegar, buscador y menú de perfil.

    OJO con el ciclo de vida: este <script is:inline> NO se re-ejecuta al
    navegar con ViewTransitions. El runtime de Astro marca como ya ejecutado
    (data-astro-exec) todo script del documento entrante identico a uno del
    actual, y los del Layout son identicos en todas las paginas. Pero el
    <body> SI se reemplaza entero, asi que los elementos son nuevos.

    Por eso el cableado va en init(), que corre en cada `astro:page-load`
    (dispara en la carga inicial y tras cada navegacion), y los listeners de
    documento se registran una sola vez tras un guard. Mismo patron que el
    script de tema de mas arriba. Si se vinculan listeners aqui fuera, se
    quedan colgados del DOM viejo y el control deja de responder al navegar.

    El filtrado en sí NO vive aquí: cada página escucha el `input` de
    #sb-search y filtra su propia lista (chats, informes, analíticas).
  -->
  <script is:inline>
    (function () {
      const root = document.documentElement;

      function setSidebar(open) {
        if (open) root.removeAttribute('data-sb');
        else root.setAttribute('data-sb', 'off');
        try { localStorage.setItem('mediq.sidebar', open ? 'on' : 'off'); } catch (e) {}
      }

      function setSearch(open) {
        const searchBtn  = document.getElementById('sb-search-btn');
        const searchWrap = document.getElementById('sb-search-wrap');
        const searchIn   = document.getElementById('sb-search');
        if (!searchWrap || !searchBtn) return;
        searchWrap.hidden = !open;
        searchBtn.classList.toggle('on', open);
        searchBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (open && searchIn) searchIn.focus();
        if (!open && searchIn && searchIn.value) {
          // Cerrar el buscador debe deshacer el filtro, no dejar la lista
          // recortada sin que se vea por qué.
          searchIn.value = '';
          searchIn.dispatchEvent(new Event('input', { bubbles: true }));
        }
      }

      /* ─── Chip de perfil y su menú ───
         El chip está en todas las páginas, así que su menú tiene que vivir
         aquí. Antes la lógica estaba solo en chat.astro y pulsarlo en
         /informes o /analiticas no hacía nada. */

      // Nombre e inicial: de localStorage, que es lo que ya hay pintado en la
      // primera carga. applySession lo refresca cuando Supabase responde.
      function pintarChip() {
        const nameEl = document.getElementById('sb-user-name');
        const avaEl  = document.getElementById('sb-user-ava');
        let n = '';
        try { n = localStorage.getItem('mediq.userName') || ''; } catch (e) {}
        if (!n) return;
        if (nameEl) nameEl.textContent = n;
        if (avaEl)  avaEl.textContent  = n[0].toUpperCase();
      }

      function esc(s) {
        return String(s == null ? '' : s)
          .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
      }

      // El contenedor se busca en cada uso: el <body> se reemplaza al navegar,
      // asi que una referencia guardada apuntaria a un nodo muerto.
      function getMenu() { return document.getElementById('user-menu'); }
      function menuAbierto() { const m = getMenu(); return !!m && m.style.display !== 'none'; }

      function cerrarMenu() {
        const menu = getMenu();
        if (menu) { menu.style.display = 'none'; menu.innerHTML = ''; }
      }

      function abrirMenu(anchor) {
        const menu = getMenu();
        if (!menu || !anchor) return;
        const nombre = (document.getElementById('sb-user-name') || {}).textContent || 'Mi cuenta';
        let mail = '';
        try { mail = localStorage.getItem('mediq.userEmail') || ''; } catch (e) {}

        menu.innerHTML =
          '<div class="head">Sesión<b>' + esc(nombre) + '</b>' +
            (mail ? '<span class="mail">' + esc(mail) + '</span>' : '') +
          '</div>' +
          '<button data-act="account"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="12" cy="7" r="4" stroke="currentColor" stroke-width="1.5"/></svg><span>Mi cuenta</span></button>' +
          '<button data-act="plan"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><path d="M15.5 8.8a4 4 0 100 6.4M7.8 11h5.4M7.8 13.4h5.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><span>Plan</span></button>' +
          '<button data-act="settings"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 11-4 0v-.09a1.65 1.65 0 00-1-1.51 1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 11-2.83-2.83l.06-.06A1.65 1.65 0 005 15a1.65 1.65 0 00-1.51-1H3a2 2 0 110-4h.09A1.65 1.65 0 005 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 112.83-2.83l.06.06A1.65 1.65 0 009 5a1.65 1.65 0 001-1.51V3a2 2 0 114 0v.09A1.65 1.65 0 0015 5a1.65 1.65 0 001.82-.33l.06-.06a2 2 0 112.83 2.83l-.06.06A1.65 1.65 0 0019 9c0 .67.39 1.27 1 1.51H21a2 2 0 110 4h-.09a1.65 1.65 0 00-1.51 1z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Configuración</span></button>' +
          '<div class="sep"></div>' +
          '<button data-act="logout" class="danger"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Cerrar sesión</span></button>';

        menu.style.display = 'flex';
        // Colocarlo tras pintar, que es cuando ya tiene alto medible.
        requestAnimationFrame(() => {
          const r = anchor.getBoundingClientRect();
          const h = menu.offsetHeight;
          const w = menu.offsetWidth;
          // Si el disparador esta en la mitad inferior (el chip del panel,
          // pegado al fondo) el menu sube; si esta arriba (barra movil), baja.
          const haciaArriba = r.top > window.innerHeight / 2;
          let top = haciaArriba ? r.top - h - 6 : r.bottom + 6;
          if (top < 8) top = 8;
          if (top + h > window.innerHeight - 8) top = window.innerHeight - h - 8;
          let left = r.left;
          if (left + w > window.innerWidth - 8) left = window.innerWidth - w - 8;
          menu.style.top  = Math.max(8, top) + 'px';
          menu.style.left = Math.max(8, left) + 'px';
        });

        menu.querySelectorAll('button').forEach(b => {
          b.addEventListener('click', async () => {
            const act = b.dataset.act;
            cerrarMenu();
            if (act === 'account') { location.href = '/account'; return; }
            if (act === 'plan')    { location.href = '/pricing'; return; }
            if (act === 'settings') {
              // El modal de ajustes solo existe en /chat. Desde el resto del
              // sitio se navega alli con ?ajustes=1, que lo abre al cargar.
              const modal = document.getElementById('modal-settings');
              if (modal) modal.classList.add('open');
              else location.href = '/chat?ajustes=1';
              return;
            }
            if (act === 'logout') {
              const sb = window.__mediqSb;
              try { if (sb) await sb.auth.signOut(); } catch (e) {}
              try {
                localStorage.removeItem('mediq.authHint');
                localStorage.removeItem('mediq.userName');
                localStorage.removeItem('mediq.userEmail');
              } catch (e) {}
              location.href = '/login';
            }
          });
        });
      }

      /* ─── Cableado ───
         Corre en cada astro:page-load sobre el DOM recien insertado. Se usa
         asignacion (onclick) en vez de addEventListener a proposito: es
         idempotente, asi que volver a llamar a init() no duplica handlers. */
      function init() {
        const toggle = document.getElementById('sb-toggle');
        const reopen = document.getElementById('sb-reopen');
        if (toggle) toggle.onclick = () => setSidebar(false);
        if (reopen) reopen.onclick = () => setSidebar(true);

        const searchBtn = document.getElementById('sb-search-btn');
        const searchWrap= document.getElementById('sb-search-wrap');
        const searchBox = document.getElementById('sb-search-box');
        const searchIn  = document.getElementById('sb-search');
        const clearBtn  = document.getElementById('sb-clear');

        if (searchBtn) searchBtn.onclick = () => setSearch(searchWrap ? searchWrap.hidden : true);
        if (searchIn) {
          // El filtrado lo hace cada pagina con su propio listener de `input`;
          // aqui solo se refleja el estado visual de la caja.
          searchIn.oninput = () => {
            if (searchBox) searchBox.classList.toggle('has-value', searchIn.value.length > 0);
          };
          searchIn.onkeydown = (e) => { if (e.key === 'Escape') setSearch(false); };
        }
        if (clearBtn) clearBtn.onclick = () => {
          if (!searchIn) return;
          searchIn.value = '';
          if (searchBox) searchBox.classList.remove('has-value');
          searchIn.dispatchEvent(new Event('input', { bubbles: true }));
          searchIn.focus();
        };

        pintarChip();

        /* Dos disparadores del mismo menú: el chip del panel (escritorio) y
           #account-btn, el chip de la barra superior que monta chat.astro y
           que es el único visible en móvil, donde el panel no existe. */
        ['sb-user-btn', 'account-btn'].forEach((id) => {
          const el = document.getElementById(id);
          if (!el) return;
          el.onclick = (e) => {
            e.preventDefault();
            e.stopPropagation();
            if (menuAbierto()) cerrarMenu();
            else abrirMenu(el);
          };
        });

        // Al cambiar de pagina el menu no debe quedarse abierto flotando.
        cerrarMenu();
      }

      /* Los listeners de documento sobreviven al swap del <body>, asi que se
         registran una sola vez; init() en cambio corre en cada navegacion. */
      if (!window.__mediqSidebarReg) {
        window.__mediqSidebarReg = true;
        document.addEventListener('astro:page-load', init);
        document.addEventListener('click', (e) => {
          const menu = getMenu();
          if (menuAbierto() && !menu.contains(e.target)) cerrarMenu();
        });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') cerrarMenu(); });
      }

      // Primer render: astro:page-load tambien dispara en la carga inicial,
      // pero init() es idempotente y asi el panel responde cuanto antes.
      init();
    })();
  </script>

  <!--
    Comprobación de sesión Supabase.
    En vez de reescribir el HTML (que provoca el flash), aquí solo:
      1. Guardamos mediq.authHint en localStorage para que el script del
         <head> pinte el header correcto en la SIGUIENTE navegación.
      2. Corregimos data-auth en el documento actual si es necesario.
      3. Rellenamos el nombre dentro del slot ya existente.
  -->
  <script is:inline define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY }}>
    (function () {
      const root = document.documentElement;

      // ═══════════════════════════════════════════════════════════════
      // INIT DE AUTH — solo la PRIMERA vez que se carga el Layout.
      //
      // Este <script is:inline> se re-ejecuta en cada navegación de Astro
      // ViewTransitions (incluidos clicks al link de la propia página).
      // Sin este guard cada navegación:
      //   1. Crea un nuevo cliente Supabase (memory leak + race conditions)
      //   2. Vuelve a suscribirse al onAuthStateChange (listener duplicado)
      //   3. Llama a getSession que puede devolver null durante ms mientras
      //      el nuevo cliente rehidrata la sesión de localStorage.
      //   4. Ese null spurio dispara applySession('out') que borra userName
      //      y hace que el nav parezca "sin sesión" durante un instante.
      // ═══════════════════════════════════════════════════════════════
      if (!window.__mediqLayoutAuthInit) {
        window.__mediqLayoutAuthInit = true;

        // El cliente singleton se crea en <head> antes de que corran los
        // scripts is:inline de body. Aqui solo lo consumimos.
        const sb = window.__mediqSb;

        function applySession(session) {
          const hint = session ? 'in' : 'out';
          root.setAttribute('data-auth', hint);
          try { localStorage.setItem('mediq.authHint', hint); } catch (_) {}
          // Buscar nameEl en tiempo real: el slot nav-actions puede haber
          // sido swap-eado por ViewTransition y la referencia guardada seria
          // a un DOM ya obsoleto.
          const nameEl = document.getElementById('nav-auth-name');
          // Chip del panel lateral: mismo motivo, se busca en tiempo real.
          const chipName = document.getElementById('sb-user-name');
          const chipAva  = document.getElementById('sb-user-ava');
          if (session) {
            const raw = session.user.user_metadata?.name || session.user.email.split('@')[0];
            const first = raw.split(' ')[0];
            try {
              localStorage.setItem('mediq.userName', first);
              localStorage.setItem('mediq.userEmail', session.user.email || '');
            } catch (_) {}
            if (nameEl)   nameEl.textContent = first;
            if (chipName) chipName.textContent = first;
            if (chipAva)  chipAva.textContent = first[0].toUpperCase();
          } else {
            try {
              localStorage.removeItem('mediq.userName');
              localStorage.removeItem('mediq.userEmail');
            } catch (_) {}
            if (nameEl)   nameEl.textContent = '';
            if (chipName) chipName.textContent = 'Mi cuenta';
            if (chipAva)  chipAva.textContent = '·';
          }
        }

        sb.auth.getSession().then(({ data: { session } }) => {
          // Si getSession devuelve null pero authHint decia "in", NO
          // invalidamos el estado — el onAuthStateChange nos avisara si
          // la sesion caduca de verdad. Esto evita el flash "sin sesion"
          // durante la rehidratacion inicial del cliente.
          if (session) {
            applySession(session);
          } else if (localStorage.getItem('mediq.authHint') !== 'in') {
            applySession(null);
          }
        });

        // Supabase dispara onAuthStateChange en TODAS las pestañas cuando
        // la sesion cambia (via su listener interno de storage). Esta
        // suscripcion vive el resto de la sesion del navegador.
        sb.auth.onAuthStateChange((_event, session) => applySession(session));
      }

      // El cierre de sesion vive en el menu del chip de perfil (script del
      // panel). Aqui habia un bloque que vinculaba #nav-logout,
      // #nav-mobile-logout y #nav-rail-logout: los tres desaparecieron del
      // markup hace varios commits, asi que era codigo muerto.
    })();
  </script>

</body>
</html>
