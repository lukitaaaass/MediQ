---
import Layout from '../layouts/Layout.astro';

const SUPABASE_URL      = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---

<Layout
  title="Iniciar sesión — MediQ"
  navActive="/login"
  bodyClass="auth-page"
  noindex={true}
>

  <!-- Slot nav-actions: solo "Volver al inicio" en la página de login -->
  <a slot="nav-actions" class="btn btn-ghost" href="/">Volver al inicio</a>

  <style is:global>
    .auth-page {
      --pv-accent: oklch(82% 0.1 195);
      --pv-ava-from: oklch(75% 0.1 195);
      --pv-ava-to: oklch(55% 0.12 25);
      --pv-dot: oklch(70% 0.15 155);
      --alert-ok-text: oklch(35% 0.1 155);
      --alert-err-text: oklch(38% 0.16 25);
    }
    body.auth-page {
      min-height: 100vh;
      display: grid;
      grid-template-rows: auto 1fr;
    }
    body.auth-page main {
      display: grid;
      grid-template-columns: 1fr;
      min-height: calc(100vh - var(--topbar-h));
    }
    @media (min-width: 920px) {
      body.auth-page main { grid-template-columns: 1.05fr 1fr; }
    }

    /* Left side: form */
    .pane-form {
      padding: clamp(32px, 6vw, 80px) var(--pad);
      display: flex; flex-direction: column; justify-content: center;
      max-width: 560px; margin: 0 auto; width: 100%;
    }
    .pane-form h1 {
      font-size: clamp(36px, 4.4vw, 56px);
      line-height: 1;
      margin-bottom: 12px;
    }
    .pane-form h1 em { font-style: italic; font-weight: 300; color: var(--accent); }
    .pane-form .sub { color: var(--ink-soft); margin-bottom: 32px; max-width: 44ch; }

    .tabs {
      display: inline-flex; gap: 4px;
      background: var(--bg-2); padding: 4px; border-radius: 999px;
      margin-bottom: 28px;
    }
    .tabs button {
      padding: 8px 18px; border-radius: 999px;
      font-size: 13px; color: var(--ink-soft); font-weight: 500;
    }
    .tabs button.on { background: var(--surface); color: var(--ink); box-shadow: 0 1px 0 var(--rule-2); }

    form { display: grid; gap: 18px; }
    .field { display: grid; gap: 6px; }
    .field[hidden] { display: none !important; }
    .field label {
      font-family: var(--f-mono); font-size: 11px; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--ink-mute);
    }
    .input-wrap { position: relative; display: flex; }
    .field input {
      width: 100%;
      background: var(--surface);
      border: 1px solid var(--rule-2);
      border-radius: 10px;
      padding: 14px 16px;
      font: inherit; font-size: 15px;
      color: var(--ink);
      outline: none;
      transition: border-color .15s ease, box-shadow .15s ease;
    }
    .field input:focus {
      border-color: var(--ink-soft);
      box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 15%, transparent);
    }
    .toggle-pw {
      position: absolute; right: 6px; top: 50%; transform: translateY(-50%);
      padding: 8px 12px; font-size: 12px;
      color: var(--ink-mute); border-radius: 8px;
    }
    .toggle-pw:hover { background: var(--bg-2); color: var(--ink); }

    .strength {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px;
      margin-top: 4px;
    }
    .strength i {
      height: 4px; border-radius: 2px;
      background: var(--rule-2);
      transition: background .25s ease;
    }
    .strength[data-s="1"] i:nth-child(-n+1) { background: var(--danger); }
    .strength[data-s="2"] i:nth-child(-n+2) { background: var(--warn); }
    .strength[data-s="3"] i:nth-child(-n+3) { background: var(--accent); }
    .strength[data-s="4"] i { background: var(--ok); }
    .strength-label {
      font-family: var(--f-mono); font-size: 10.5px; letter-spacing: 0.06em;
      color: var(--ink-mute); text-transform: uppercase;
      margin-top: 6px;
    }

    .row-flex { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
    .check {
      display: inline-flex; align-items: center; gap: 8px;
      font-size: 13px; color: var(--ink-soft);
      cursor: pointer;
    }
    .check input { accent-color: var(--ink); width: 16px; height: 16px; }
    .row-flex a { font-size: 13px; color: var(--ink-soft); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
    .row-flex a:hover { color: var(--ink); }

    .submit {
      margin-top: 8px;
      padding: 14px 22px;
      border-radius: 10px;
      background: var(--ink); color: var(--bg);
      font-weight: 500; font-size: 15px;
      display: inline-flex; align-items: center; justify-content: center; gap: 10px;
      transition: transform .2s ease, opacity .2s ease;
    }
    .submit:hover { transform: translateY(-1px); }
    .submit[disabled] { opacity: .55; cursor: progress; transform: none; }

    .divider {
      text-align: center;
      font-family: var(--f-mono); font-size: 11px;
      color: var(--ink-mute); letter-spacing: 0.1em;
      margin: 26px 0 14px;
      position: relative;
    }
    .divider::before, .divider::after {
      content: ""; position: absolute; top: 50%; width: calc(50% - 30px);
      height: 1px; background: var(--rule-2);
    }
    .divider::before { left: 0; } .divider::after { right: 0; }

    .sso { display: grid; gap: 10px; }
    .sso button {
      background: var(--surface);
      border: 1px solid var(--rule-2);
      border-radius: 10px;
      padding: 12px 16px;
      font-size: 14px;
      display: flex; align-items: center; gap: 12px; justify-content: center;
      transition: background .15s ease, border-color .15s ease;
    }
    .sso button:hover { background: var(--bg-2); border-color: var(--ink-soft); }
    .sso .ico { width: 18px; height: 18px; }

    .legal {
      margin-top: 24px;
      font-family: var(--f-mono); font-size: 11px;
      color: var(--ink-mute); letter-spacing: 0.04em;
      line-height: 1.5;
    }

    .alert {
      padding: 12px 14px;
      border-radius: 10px;
      font-size: 13.5px;
      display: flex; gap: 10px;
      margin-bottom: 8px;
    }
    .alert.ok  { background: color-mix(in oklab, var(--ok)     12%, transparent); color: var(--alert-ok-text); }
    .alert.err { background: color-mix(in oklab, var(--danger) 12%, transparent); color: var(--alert-err-text); }
    .alert.info { background: var(--bg-2); color: var(--ink-soft); }

    /* Right side: data visual */
    .pane-visual {
      background: var(--ink);
      color: var(--bg);
      padding: clamp(40px, 5vw, 64px);
      display: none;
      position: relative;
      overflow: hidden;
    }
    @media (min-width: 920px) {
      .pane-visual { display: flex; flex-direction: column; justify-content: space-between; }
    }
    .pane-visual::before {
      content: "";
      position: absolute; inset: 0;
      background:
        radial-gradient(600px 400px at 80% 10%, color-mix(in oklab, var(--accent) 30%, transparent), transparent 60%),
        radial-gradient(500px 500px at 10% 90%, color-mix(in oklab, var(--accent) 18%, transparent), transparent 60%);
      pointer-events: none;
    }
    .pane-visual > * { position: relative; }

    .pv-eyebrow {
      font-family: var(--f-mono); font-size: 11px; letter-spacing: 0.12em;
      color: color-mix(in oklab, var(--bg) 60%, transparent);
      text-transform: uppercase;
    }
    .pv-quote {
      font-family: var(--f-display);
      font-size: clamp(28px, 2.6vw, 38px);
      line-height: 1.2; font-weight: 300;
      margin-top: 24px;
      text-wrap: pretty;
    }
    .pv-quote em { font-style: italic; color: var(--pv-accent); }
    .pv-attr {
      margin-top: 32px;
      display: flex; align-items: center; gap: 14px;
    }
    .pv-attr .ava {
      width: 42px; height: 42px; border-radius: 50%;
      background: linear-gradient(135deg, var(--pv-ava-from), var(--pv-ava-to));
      display: grid; place-items: center;
      font-family: var(--f-display); font-size: 16px;
      color: var(--bg);
    }
    .pv-attr .who { font-size: 14px; }
    .pv-attr .who small {
      display: block;
      color: color-mix(in oklab, var(--bg) 55%, transparent);
      font-size: 12px;
      font-family: var(--f-mono); letter-spacing: 0.04em;
      margin-top: 2px;
    }

    .inspector {
      background: color-mix(in oklab, var(--bg) 6%, transparent);
      border: 1px solid color-mix(in oklab, var(--bg) 14%, transparent);
      border-radius: 12px;
      padding: 18px;
      font-family: var(--f-mono); font-size: 12px;
      line-height: 1.6;
      color: color-mix(in oklab, var(--bg) 75%, transparent);
      margin-top: 32px;
    }
    .inspector .row-i { display: grid; grid-template-columns: 80px 1fr; gap: 12px; padding: 4px 0; }
    .inspector .row-i b {
      color: var(--pv-accent); font-weight: 400;
      text-transform: uppercase; font-size: 10.5px; letter-spacing: 0.1em;
    }
    .inspector .v {
      color: var(--bg);
      word-break: break-all;
      font-size: 11.5px;
      line-height: 1.5;
    }
    .inspector .v.muted { color: color-mix(in oklab, var(--bg) 50%, transparent); }
    .inspector h5 {
      font-family: var(--f-mono); font-size: 11px;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: color-mix(in oklab, var(--bg) 65%, transparent);
      font-weight: 400;
      margin: 0 0 12px;
      display: flex; align-items: center; gap: 8px;
    }
    .lock-dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--pv-dot);
      box-shadow: 0 0 0 0 color-mix(in oklab, var(--pv-dot) 60%, transparent);
    }
    @media (prefers-reduced-motion: no-preference) {
      .lock-dot { animation: pulse-dot 2s infinite; }
    }
    @keyframes pulse-dot {
      0%   { box-shadow: 0 0 0 0 color-mix(in oklab, var(--pv-dot) 50%, transparent); }
      70%  { box-shadow: 0 0 0 8px transparent; }
      100% { box-shadow: 0 0 0 0 transparent; }
    }
  </style>

  <main>
    <!-- ────────── FORM ────────── -->
    <section class="pane-form">
      <span class="eyebrow">Acceso seguro</span>
      <h1 style="margin-top:14px;">Bienvenido<em>.</em></h1>
      <p class="sub">Tu sesión está gestionada por Supabase Auth. Las contraseñas se almacenan con bcrypt en el servidor y nunca viajan en texto plano.</p>

      <div class="tabs" role="tablist">
        <button id="tab-login" class="on" role="tab" aria-selected="true" aria-controls="auth-form">Iniciar sesión</button>
        <button id="tab-signup" role="tab" aria-selected="false" aria-controls="auth-form">Crear cuenta</button>
      </div>

      <div id="alerts" role="alert" aria-live="polite" aria-atomic="true"></div>

      <form id="auth-form" novalidate>
        <div class="field" id="f-name" hidden>
          <label for="name">Nombre completo</label>
          <input id="name" name="name" type="text" placeholder="Dra. Ana Pérez" autocomplete="name"/>
        </div>

        <div class="field" id="f-role" hidden>
          <label for="role">Perfil profesional</label>
          <select id="role" name="role">
            <option value="">Selecciona tu perfil…</option>
            <option value="medico">Médico en ejercicio</option>
            <option value="residente">Residente / MIR</option>
            <option value="estudiante">Estudiante de medicina</option>
            <option value="enfermeria">Enfermería</option>
            <option value="otro">Otro profesional sanitario</option>
          </select>
        </div>

        <div class="field" id="f-specialty" hidden>
          <label for="specialty">Especialidad <span style="color:var(--ink-mute); font-weight:400;">(opcional)</span></label>
          <input id="specialty" name="specialty" type="text" placeholder="Cardiología, Urgencias, Medicina interna…" autocomplete="off"/>
        </div>

        <div class="field">
          <label for="email">Correo profesional</label>
          <input id="email" name="email" type="email" placeholder="ana.perez@hospital.es" required autocomplete="email"/>
        </div>

        <div class="field">
          <label for="password">Contraseña</label>
          <div class="input-wrap">
            <input id="password" name="password" type="password" placeholder="Mínimo 8 caracteres" required minlength="8" autocomplete="current-password"/>
            <button type="button" class="toggle-pw" id="toggle-pw" aria-label="Mostrar contraseña">Mostrar</button>
          </div>
          <div class="strength" id="strength" data-s="0" hidden>
            <i></i><i></i><i></i><i></i>
          </div>
          <div class="strength-label" id="strength-label" hidden aria-live="polite">Fortaleza: —</div>
        </div>

        <div class="row-flex" id="row-extras">
          <label class="check">
            <input type="checkbox" id="remember" checked/>
            Recordar este dispositivo
          </label>
          <a href="#" id="link-forgot">¿Olvidaste tu contraseña?</a>
        </div>

        <button class="submit" type="submit" id="submit-btn">
          <span id="submit-label">Iniciar sesión</span>
          <span aria-hidden="true">→</span>
        </button>
      </form>

      <div class="divider">o continúa con</div>
      <div class="sso">
        <button type="button" disabled title="Próximamente">
          <svg class="ico" viewBox="0 0 24 24" fill="none"><path d="M12 4v16M4 12h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          Cumed (colegios médicos)
        </button>
        <button type="button" disabled title="Próximamente">
          <svg class="ico" viewBox="0 0 24 24" fill="currentColor"><path d="M21.35 11.1H12v2.92h5.59c-.24 1.4-1.65 4.1-5.59 4.1-3.36 0-6.1-2.78-6.1-6.21S8.64 5.7 12 5.7c1.91 0 3.19.81 3.92 1.51l2.67-2.57C16.96 3.07 14.69 2 12 2 6.48 2 2 6.48 2 12s4.48 10 10 10c5.77 0 9.6-4.05 9.6-9.76 0-.66-.07-1.16-.25-1.74z"/></svg>
          Continuar con SSO institucional
        </button>
      </div>

      <p class="legal">
        Al continuar aceptas nuestros <a href="#" style="text-decoration:underline;">Términos</a> y <a href="#" style="text-decoration:underline;">Política de privacidad</a>. Cumplimos con el RGPD · Datos alojados en la UE.
      </p>
    </section>

    <!-- ────────── VISUAL / CRYPTO ────────── -->
    <aside class="pane-visual">
      <div>
        <span class="pv-eyebrow">Beta cerrada en curso</span>
        <p class="pv-quote">Un asistente clínico pensado <em>por y para</em> médicos hispanohablantes. Diferenciales fundamentados en evidencia, verificación de interacciones y razonamiento sobre tus documentos.</p>
        <div class="pv-attr">
          <div class="ava" style="background:linear-gradient(135deg,oklch(75% 0.1 195),oklch(55% 0.12 25));">Q</div>
          <div class="who">
            MediQ · Equipo médico + ingeniería
            <small>Madrid · en desarrollo activo · 2026</small>
          </div>
        </div>
      </div>

      <div class="inspector" aria-live="polite">
        <h5><span class="lock-dot"></span> Seguridad — Supabase Auth</h5>
        <div class="row-i"><b>Contraseña</b><span class="v">bcrypt · nunca almacenada en texto plano</span></div>
        <div class="row-i"><b>Sesión</b><span class="v">JWT · renovación automática</span></div>
        <div class="row-i"><b>Transmisión</b><span class="v">TLS 1.3 · HTTPS cifrado</span></div>
        <div class="row-i"><b>Almacén</b><span class="v">PostgreSQL · infraestructura Supabase</span></div>
        <div class="row-i"><b>Cumplimiento</b><span class="v">RGPD · datos en la UE</span></div>
      </div>
    </aside>
  </main>

  <script is:inline define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY }}>
    const { createClient } = window.supabase;
    const sb = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    const tabLogin    = document.getElementById('tab-login');
    const tabSignup   = document.getElementById('tab-signup');
    const submitLabel = document.getElementById('submit-label');
    const fName       = document.getElementById('f-name');
    const fRole       = document.getElementById('f-role');
    const fSpecialty  = document.getElementById('f-specialty');
    const rowExtras   = document.getElementById('row-extras');
    const strengthBar = document.getElementById('strength');
    const strengthLbl = document.getElementById('strength-label');
    const passwordEl  = document.getElementById('password');
    const emailEl     = document.getElementById('email');
    const nameEl      = document.getElementById('name');
    const form        = document.getElementById('auth-form');
    const submitBtn   = document.getElementById('submit-btn');
    const alertsEl    = document.getElementById('alerts');

    let mode = 'login';

    function setMode(m) {
      mode = m;
      tabLogin.classList.toggle('on', m === 'login');
      tabSignup.classList.toggle('on', m === 'signup');
      tabLogin.setAttribute('aria-selected', m === 'login');
      tabSignup.setAttribute('aria-selected', m === 'signup');
      fName.hidden = m !== 'signup';
      fRole.hidden = m !== 'signup';
      fSpecialty.hidden = m !== 'signup';
      if (m === 'signup') {
        nameEl.required = true;
        submitLabel.textContent = 'Crear cuenta';
        strengthBar.hidden = false;
        strengthLbl.hidden = false;
        rowExtras.style.display = 'none';
        passwordEl.setAttribute('autocomplete', 'new-password');
        passwordEl.placeholder = 'Mínimo 8, mezcla mayúsculas, números y símbolos';
      } else {
        nameEl.required = false;
        submitLabel.textContent = 'Iniciar sesión';
        strengthBar.hidden = true;
        strengthLbl.hidden = true;
        rowExtras.style.display = 'flex';
        passwordEl.setAttribute('autocomplete', 'current-password');
        passwordEl.placeholder = 'Mínimo 8 caracteres';
      }
      alertsEl.innerHTML = '';
    }
    tabLogin.addEventListener('click', () => setMode('login'));
    tabSignup.addEventListener('click', () => setMode('signup'));

    const togglePw = document.getElementById('toggle-pw');
    togglePw.addEventListener('click', () => {
      const isPw = passwordEl.type === 'password';
      passwordEl.type = isPw ? 'text' : 'password';
      togglePw.textContent = isPw ? 'Ocultar' : 'Mostrar';
      togglePw.setAttribute('aria-label', isPw ? 'Ocultar contraseña' : 'Mostrar contraseña');
    });

    function scorePassword(pw) {
      let s = 0;
      if (pw.length >= 8) s++;
      if (/[A-Z]/.test(pw) && /[a-z]/.test(pw)) s++;
      if (/\d/.test(pw)) s++;
      if (/[^A-Za-z0-9]/.test(pw) && pw.length >= 12) s++;
      return Math.min(s, 4);
    }
    const strengthLabels = ['—', 'Débil', 'Aceptable', 'Buena', 'Excelente'];

    passwordEl.addEventListener('input', () => {
      if (mode !== 'signup') return;
      const s = scorePassword(passwordEl.value);
      strengthBar.dataset.s = s;
      strengthLbl.textContent = 'Fortaleza: ' + strengthLabels[s];
    });

    function alertMsg(kind, text) {
      alertsEl.innerHTML = `<div class="alert ${kind}">${text}</div>`;
    }

    const ERROR_MESSAGES = {
      'Invalid login credentials':                'Correo o contraseña incorrectos.',
      'User already registered':                  'Ya existe una cuenta con ese correo. Inicia sesión.',
      'Email not confirmed':                      'Confirma tu correo antes de continuar.',
      'Password should be at least 6 characters': 'La contraseña debe tener al menos 6 caracteres.',
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      alertsEl.innerHTML = '';
      const email     = emailEl.value.trim().toLowerCase();
      const password  = passwordEl.value;
      const name      = nameEl.value.trim();
      const role      = document.getElementById('role')?.value || '';
      const specialty = document.getElementById('specialty')?.value.trim() || '';

      if (!email || !password) { alertMsg('err', 'Rellena todos los campos.'); return; }
      if (password.length < 8)  { alertMsg('err', 'La contraseña debe tener al menos 8 caracteres.'); return; }
      if (mode === 'signup' && !name) { alertMsg('err', 'Indica tu nombre.'); return; }

      submitBtn.disabled = true;
      const oldLabel = submitLabel.textContent;
      submitLabel.textContent = 'Un momento…';

      try {
        if (mode === 'signup') {
          const { data, error } = await sb.auth.signUp({
            email,
            password,
            options: { data: { name, role, specialty } }
          });
          if (error) throw error;
          if (data.session) {
            try {
              if (specialty) localStorage.setItem('mediq.specialty', specialty);
              if (role) localStorage.setItem('mediq.role', role);
            } catch (_) {}
            alertMsg('ok', '✓ Cuenta creada. Redirigiendo…');
            setTimeout(() => location.href = '/checkout-success', 900);
          } else {
            alertMsg('ok', '✓ Cuenta creada. Revisa tu correo y confirma tu cuenta antes de iniciar sesión.');
            submitBtn.disabled = false;
            submitLabel.textContent = oldLabel;
          }
        } else {
          const { error } = await sb.auth.signInWithPassword({ email, password });
          if (error) throw error;
          alertMsg('ok', '✓ Sesión iniciada. Redirigiendo al chat…');
          setTimeout(() => location.href = '/chat', 700);
        }
      } catch (err) {
        alertMsg('err', ERROR_MESSAGES[err.message] || err.message);
      } finally {
        submitBtn.disabled = false;
        submitLabel.textContent = oldLabel;
      }
    });

    document.getElementById('link-forgot').addEventListener('click', async (e) => {
      e.preventDefault();
      const email = emailEl.value.trim().toLowerCase();
      if (!email) {
        alertMsg('info', 'Escribe tu correo arriba y pulsa este enlace para recuperar la contraseña.');
        return;
      }
      const { error } = await sb.auth.resetPasswordForEmail(email);
      if (error) { alertMsg('err', error.message); return; }
      alertMsg('ok', '✓ Revisa tu correo — te hemos enviado el enlace de recuperación.');
    });

    sb.auth.getSession().then(({ data: { session } }) => {
      if (session) {
        alertMsg('info', `Sesión activa de ${session.user.email}. <a href="/chat" style="text-decoration:underline; margin-left:6px;">Ir al chat →</a>`);
      }
    });
  </script>

</Layout>
