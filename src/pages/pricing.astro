  <script is:inline>
    const bm = document.getElementById('bm');
    const ba = document.getElementById('ba');
    const priceEls = document.querySelectorAll('[data-price-monthly]');
    const periodEl = document.querySelector('[data-period]');

    function setBilling(b) {
      bm.classList.toggle('on', b === 'm');
      ba.classList.toggle('on', b === 'a');
      bm.setAttribute('aria-selected', b === 'm');
      ba.setAttribute('aria-selected', b === 'a');
      priceEls.forEach(el => {
        el.textContent = b === 'm' ? el.dataset.priceMonthly : el.dataset.priceYearly;
      });
      if (periodEl) periodEl.textContent = b === 'm' ? '/mes' : '/mes, anual';
    }
    bm.addEventListener('click', () => setBilling('m'));
    ba.addEventListener('click', () => setBilling('a'));
  </script>

  <script is:inline define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY }}>
    (function () {
      const btn = document.getElementById('btn-practica');
      if (!btn) return;

      // Reutiliza el cliente singleton de Layout.astro para evitar refresh-token
      // races entre multiples clientes en ViewTransitions (que cierran la sesion).
      const sb = window.__mediqSb || window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

      const PAYMENT_LINKS = {
        monthly: 'https://buy.stripe.com/test_7sY14pcbJ3Ik1eq4cM6wE00',
        annual:  'https://buy.stripe.com/test_4gM9AV5Nl5Qs0amgZy6wE01',
      };

      btn.addEventListener('click', async () => {
        btn.disabled = true;
        btn.textContent = 'Redirigiendo…';

        const isAnnual = document.getElementById('ba')?.classList.contains('on');
        const plan = isAnnual ? 'annual' : 'monthly';

        const { data: { session } } = await sb.auth.getSession();
        if (!session) {
          location.href = '/login?next=/pricing';
          return;
        }

        window.track('Checkout Started', { plan });
        location.href = `${PAYMENT_LINKS[plan]}?prefilled_email=${encodeURIComponent(session.user.email)}`;
      });
    })();
  </script>

</Layout>
