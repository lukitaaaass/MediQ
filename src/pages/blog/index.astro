---
import Layout from '../../layouts/Layout.astro';
import TarjetaPost from '../../components/TarjetaPost.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const featured = posts[0];
const rest = posts.slice(1);

// Solo mostramos el enlace a /blog/casos si hay al menos un caso publicado.
const hayCasos = posts.some(p => p.data.tipo === 'caso');
---

<Layout
  title="Blog médico — MediQ"
  description="Análisis clínicos, guías rápidas para médicos y contenidos para pacientes. Artículos revisados por el equipo médico de MediQ."
  navActive="/blog"
>

  <style is:global>
    .blog-wrap {
      max-width: 1080px;
      margin: 0 auto;
      padding: clamp(40px, 6vw, 80px) var(--pad) 120px;
    }

    /* Hero */
    .blog-hero { margin-bottom: clamp(48px, 6vw, 72px); max-width: 780px; }
    .blog-hero h1 {
      font-family: var(--f-display);
      font-size: clamp(40px, 5vw, 64px);
      line-height: 1.02;
      font-weight: 300;
      letter-spacing: -0.02em;
      margin: 18px 0 20px;
    }
    .blog-hero h1 em { font-style: italic; color: var(--accent); }
    .blog-hero .sub {
      font-size: clamp(16px, 1.15vw, 18px);
      color: var(--ink-soft);
      line-height: 1.55;
      max-width: 62ch;
    }

    .blog-subnav {
      display: flex;
      gap: 20px;
      margin-bottom: clamp(32px, 4vw, 48px);
      font-family: var(--f-mono);
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .blog-subnav a {
      color: var(--ink-mute);
      text-decoration: none;
      padding-bottom: 6px;
      border-bottom: 1px solid transparent;
      transition: color .15s, border-color .15s;
    }
    .blog-subnav a.active { color: var(--ink); border-color: var(--accent); }
    .blog-subnav a:hover { color: var(--ink); }

    .featured-wrap { margin-bottom: clamp(40px, 5vw, 60px); }

    /* Grid */
    .post-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1px;
      background: var(--rule-2);
      border: 1px solid var(--rule-2);
      border-radius: 14px;
      overflow: hidden;
    }
    @media (min-width: 720px) { .post-grid { grid-template-columns: 1fr 1fr; } }
    @media (min-width: 1000px) { .post-grid { grid-template-columns: 1fr 1fr 1fr; } }

    .empty {
      text-align: center;
      padding: 80px 24px;
      color: var(--ink-mute);
      border: 1px dashed var(--rule-2);
      border-radius: 14px;
    }
  </style>

  <section class="blog-wrap">
    <header class="blog-hero">
      <span class="eyebrow"><span class="eyebrow-dot"></span> Blog médico</span>
      <h1>Práctica clínica, <em>en formato leíble</em>.</h1>
      <p class="sub">Guías rápidas para médicos y residentes, y contenidos claros para pacientes. Revisado por profesionales sanitarios.</p>
    </header>

    <nav class="blog-subnav" aria-label="Navegación del blog">
      <a href="/blog/" class="active">Todos</a>
      {hayCasos && <a href="/blog/casos/">Casos clínicos</a>}
    </nav>

    {featured && (
      <div class="featured-wrap">
        <TarjetaPost post={featured} variante="destacada" />
      </div>
    )}

    {rest.length > 0 ? (
      <div class="post-grid">
        {rest.map(p => <TarjetaPost post={p} variante="compacta" />)}
      </div>
    ) : posts.length === 0 && (
      <div class="empty">
        Todavía no hay artículos publicados. Vuelve pronto.
      </div>
    )}
  </section>
</Layout>
