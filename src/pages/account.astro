---
import Layout from '../layouts/Layout.astro';

const SUPABASE_URL      = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---

<Layout
  title="Mi cuenta â€” MediQ"
  navActive="/account"
  noindex={true}
>

  <Fragment slot="nav-actions">
    <a class="btn btn-ghost" href="/chat" id="to-chat" style="display:none;">Ir al chat</a>
    <a class="btn btn-ghost" href="/login" id="to-login">Entrar</a>
  </Fragment>

  <style is:global>
    .account-page {
      min-height: calc(100vh - var(--topbar-h));
      padding: clamp(32px, 5vw, 64px) 0;
    }
    .account-wrap {
      display: grid;
      grid-template-columns: 200px 1fr;
      gap: 40px;
      align-items: start;
    }
    @media (max-width: 720px) {
      .account-wrap { grid-template-columns: 1fr; }
      .acct-nav      { display: none; }
    }

    /* Sidebar */
    .acct-nav { position: sticky; top: 88px; }
    .acct-nav a {
      display: flex; align-items: center; gap: 9px;
      padding: 9px 11px; border-radius: var(--radius-sm);
      font-size: 13.5px; color: var(--ink-soft);
      transition: background .15s, color .15s;
    }
    .acct-nav a:hover  { background: var(--bg-2); color: var(--ink); }
    .acct-nav a.active { background: var(--bg-2); color: var(--ink); font-weight: 500; }
    .acct-nav .sep     { height: 1px; background: var(--rule); margin: 8px 0; }

    /* Cards */
    .acct-card {
      background: var(--surface);
      border: 1px solid var(--rule-2);
      border-radius: var(--radius);
      overflow: hidden;
      margin-bottom: 18px;
    }
    .acct-card-head {
      padding: 18px 22px;
      border-bottom: 1px solid var(--rule);
    }
    .acct-card-head h2 {
      font-family: var(--f-body); font-size: 14.5px; font-weight: 600;
      letter-spacing: 0; margin: 0; color: var(--ink);
    }
    .acct-card-head p { font-size: 12.5px; color: var(--ink-mute); margin-top: 2px; }
    .acct-card-body   { padding: 22px; }

    /* Profile hero */
    .profile-hero {
      display: flex; align-items: center; gap: 18px;
      padding: 24px 22px; border-bottom: 1px solid var(--rule);
    }
    .ava-lg {
      width: 52px; height: 52px; border-radius: 50%;
      background: var(--ink); color: var(--bg);
      display: grid; place-items: center;
      font-family: var(--f-display); font-size: 20px; flex-shrink: 0;
    }
    .profile-meta strong { font-size: 16px; font-weight: 500; display: block; }
    .profile-meta span   { font-size: 13px; color: var(--ink-mute); }

    /* Plan badges */
    .plan-badge {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 3px 11px; border-radius: 999px;
      font-size: 11.5px; font-family: var(--f-mono); letter-spacing: 0.04em;
    }
    .plan-badge.active { background: color-mix(in oklab, var(--ok) 14%, transparent); color: var(--ok); }
    .plan-badge.trial  { background: color-mix(in oklab, var(--accent) 14%, transparent); color: var(--accent-text); }
    .plan-badge.none   { background: var(--bg-2); color: var(--ink-mute); }
    .plan-dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; flex-shrink: 0; }

    /* Plan rows */
    .plan-row {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      padding: 14px 0; border-bottom: 1px solid var(--rule);
    }
    .plan-row:last-child  { border-bottom: none; padding-bottom: 0; }
    .plan-row:first-child { padding-top: 0; }
    .plan-row .lbl { font-size: 13px; color: var(--ink-soft); }
    .plan-row .val { font-size: 13.5px; font-weight: 500; }

    /* Form */
    .field { margin-bottom: 16px; }
    .field label { display: block; font-size: 12.5px; font-weight: 500; margin-bottom: 5px; color: var(--ink-soft); }
    .field input {
      width: 100%; padding: 9px 12px;
      background: var(--bg); border: 1px solid var(--rule-2);
      border-radius: var(--radius-sm); font: inherit; font-size: 14px;
      color: var(--ink); transition: border-color .15s; outline: none;
    }
    .field input:focus   { border-color: var(--accent); }
    .field input:disabled { opacity: .45; cursor: not-allowed; }

    .row-between { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    .acct-sep    { height: 1px; background: var(--rule); margin: 20px 0; }

    /* Danger */
    .danger-card {
      background: color-mix(in oklab, var(--danger) 5%, var(--surface));
      border-color: color-mix(in oklab, var(--danger) 18%, transparent);
    }
    .danger-card .acct-card-head h2 { color: var(--danger); }

    /* Toast */
    .acct-toast {
      position: fixed; bottom: 28px; left: 50%; transform: translateX(-50%);
      background: var(--ink); color: var(--bg);
      padding: 9px 20px; border-radius: 999px;
      font-size: 13.5px; z-index: 999;
      opacity: 0; transition: opacity .2s; pointer-events: none; white-space: nowrap;
    }
    .acct-toast.show { opacity: 1; }

    /* Modal */
    .acct-modal {
      display: none; position: fixed; inset: 0;
      background: #00000070; z-index: 200; place-items: center;
    }
    .acct-modal.open { display: grid; }
    .acct-modal-box {
      background: var(--surface); border: 1px solid var(--rule-2);
      border-radius: var(--radius); padding: 26px;
      max-width: 400px; width: 90%;
      box-shadow: 0 30px 60px -30px #0005;
    }
    .acct-modal-box h3 {
      font-family: var(--f-body); font-size: 16px; font-weight: 600;
      margin: 0 0 8px;
    }

    .btn-sm { padding: 7px 14px; font-size: 13px; }
  </style>

  <div class="account-page">
    <div class="container">
      <div class="account-wrap">

        <!-- â”€â”€ Sidebar nav â”€â”€ -->
        <nav class="acct-nav">
          <a href="#profile" class="active">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
            Perfil
          </a>
          <a href="#plan">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
            Plan y facturaciÃ³n
          </a>
          <a href="#security">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="5" y="11" width="14" height="10" rx="1"/><path d="M8 11V7a4 4 0 1 1 8 0v4"/></svg>
            Seguridad
          </a>
          <div class="sep"></div>
          <a href="#danger" style="color:var(--danger);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>
            Zona de peligro
          </a>
        </nav>

        <!-- â”€â”€ Main â”€â”€ -->
        <div>

          <!-- PERFIL -->
          <div class="acct-card" id="profile">
            <div class="profile-hero">
              <div class="ava-lg" id="ava-lg">?</div>
              <div class="profile-meta">
                <strong id="profile-name">Cargandoâ€¦</strong>
                <span id="profile-email"></span>
              </div>
            </div>
            <div class="acct-card-body">
              <div class="field">
                <label>Nombre visible</label>
                <input type="text" id="inp-name" placeholder="Tu nombre" />
              </div>
              <div class="field">
                <label>Correo electrÃ³nico</label>
                <input type="email" id="inp-email" disabled />
              </div>
              <div style="display:flex; justify-content:flex-end; margin-top:6px;">
                <button class="btn btn-primary btn-sm" id="save-profile">Guardar cambios</button>
              </div>
            </div>
          </div>

          <!-- PLAN -->
          <div class="acct-card" id="plan">
            <div class="acct-card-head">
              <h2>Plan y facturaciÃ³n</h2>
              <p>Estado de tu suscripciÃ³n y prÃ³ximo ciclo de pago.</p>
            </div>
            <div class="acct-card-body">
              <div class="plan-row">
                <span class="lbl">Estado</span>
                <span id="plan-status"><span class="plan-badge none"><span class="plan-dot"></span>Sin suscripciÃ³n</span></span>
              </div>
              <div class="plan-row">
                <span class="lbl">Plan</span>
                <span class="val" id="plan-name">â€”</span>
              </div>
              <div class="plan-row">
                <span class="lbl">PrÃ³xima renovaciÃ³n</span>
                <span class="val" id="plan-renews">â€”</span>
              </div>
              <div style="margin-top:18px; display:flex; gap:10px; flex-wrap:wrap;">
                <button class="btn btn-ghost btn-sm" id="btn-billing" style="display:none;">Gestionar facturaciÃ³n â†’</button>
                <a class="btn btn-primary btn-sm" href="/pricing" id="btn-upgrade">Ver planes â†’</a>
              </div>
            </div>
          </div>

          <!-- SEGURIDAD -->
          <div class="acct-card" id="security">
            <div class="acct-card-head">
              <h2>Seguridad</h2>
              <p>Cambia tu contraseÃ±a y gestiona el acceso.</p>
            </div>
            <div class="acct-card-body">
              <div class="field">
                <label>ContraseÃ±a actual</label>
                <input type="password" id="inp-pw-current" placeholder="Tu contraseÃ±a actual" autocomplete="current-password" />
              </div>
              <div class="field">
                <label>Nueva contraseÃ±a</label>
                <input type="password" id="inp-pw" placeholder="MÃ­nimo 8 caracteres" autocomplete="new-password" />
              </div>
              <div class="field">
                <label>Confirmar nueva contraseÃ±a</label>
                <input type="password" id="inp-pw2" placeholder="Repite la nueva contraseÃ±a" autocomplete="new-password" />
              </div>
              <div style="display:flex; justify-content:flex-end; margin-top:6px;">
                <button class="btn btn-primary btn-sm" id="save-pw">Cambiar contraseÃ±a</button>
              </div>
              <div class="acct-sep"></div>
              <div class="row-between">
                <div>
                  <div style="font-size:14px; font-weight:500;">Cerrar sesiÃ³n</div>
                  <div style="font-size:12.5px; color:var(--ink-mute); margin-top:2px;">Cierra la sesiÃ³n en este dispositivo.</div>
                </div>
                <button class="btn btn-ghost btn-sm" id="logout-btn">Cerrar sesiÃ³n</button>
              </div>
            </div>
          </div>

          <!-- ZONA DE PELIGRO -->
          <div class="acct-card danger-card" id="danger">
            <div class="acct-card-head">
              <h2>Zona de peligro</h2>
              <p>Acciones irreversibles. Procede con cuidado.</p>
            </div>
            <div class="acct-card-body">
              <div class="row-between">
                <div>
                  <div style="font-size:14px; font-weight:500;">Eliminar mi cuenta</div>
                  <div style="font-size:12.5px; color:var(--ink-mute); margin-top:3px; max-width:36ch; line-height:1.5;">
                    Borra tu cuenta, historial de chats y suscripciÃ³n de forma permanente.
                  </div>
                </div>
                <button class="btn btn-sm" id="delete-btn"
                  style="color:var(--danger); border:1px solid color-mix(in oklab,var(--danger) 28%,transparent); flex-shrink:0;">
                  Eliminar cuenta
                </button>
              </div>
            </div>
          </div>

        </div><!-- /main -->
      </div><!-- /wrap -->
    </div><!-- /container -->
  </div>

  <!-- Modal confirmar borrado -->
  <div class="acct-modal" id="modal-delete">
    <div class="acct-modal-box">
      <h3>Â¿Eliminar tu cuenta?</h3>
      <p style="font-size:13.5px; color:var(--ink-soft); margin-bottom:16px; line-height:1.55;">
        Esta acciÃ³n borrarÃ¡ permanentemente tu cuenta, tus chats y tus datos. No se puede deshacer.
      </p>
      <p style="font-size:12.5px; color:var(--ink-mute); margin-bottom:10px;">
        Escribe <strong>eliminar</strong> para confirmar:
      </p>
      <input type="text" id="confirm-del-input"
        placeholder="eliminar"
        style="width:100%; padding:9px 12px; background:var(--bg); border:1px solid var(--rule-2); border-radius:var(--radius-sm); font:inherit; font-size:14px; color:var(--ink); outline:none; margin-bottom:16px;" />
      <div style="display:flex; gap:10px; justify-content:flex-end;">
        <button class="btn btn-ghost btn-sm" id="cancel-del">Cancelar</button>
        <button class="btn btn-sm" id="confirm-del" disabled
          style="background:var(--danger); color:#fff; opacity:.45; transition:opacity .15s;">
          Eliminar para siempre
        </button>
      </div>
    </div>
  </div>

  <div class="acct-toast" id="acct-toast"></div>

  <script is:inline define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY }}>
    // Reutiliza el cliente singleton de Layout.astro para evitar refresh-token
    // races entre multiples clientes en ViewTransitions (que cierran la sesion).
    const sb = window.__mediqSb || window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    function toast(msg, dur = 3200) {
      const el = document.getElementById('acct-toast');
      el.textContent = msg;
      el.classList.add('show');
      setTimeout(() => el.classList.remove('show'), dur);
    }

    /* â”€â”€ Auth check â”€â”€ */
    sb.auth.getSession().then(({ data: { session } }) => {
      if (!session) { location.href = '/login'; return; }
      boot(session);
    });

    async function boot(session) {
      const user = session.user;

      document.getElementById('to-chat').style.display  = '';
      document.getElementById('to-login').style.display = 'none';

      const name = user.user_metadata?.name || user.email.split('@')[0];
      document.getElementById('ava-lg').textContent        = name.trim().charAt(0).toUpperCase();
      document.getElementById('profile-name').textContent  = name;
      document.getElementById('profile-email').textContent = user.email;
      document.getElementById('inp-name').value  = name;
      document.getElementById('inp-email').value = user.email;

      loadPlan(user.id);
      bindActions(session);
    }

    /* â”€â”€ Plan â”€â”€ */
    async function loadPlan(userId) {
      try {
        const { data } = await sb
          .from('subscriptions')
          .select('status, plan_id, current_period_end')
          .eq('user_id', userId)
          .order('created_at', { ascending: false })
          .limit(1)
          .maybeSingle();

        if (!data) return;

        const statusEl   = document.getElementById('plan-status');
        const nameEl     = document.getElementById('plan-name');
        const renewsEl   = document.getElementById('plan-renews');
        const billingBtn = document.getElementById('btn-billing');
        const upgradeBtn = document.getElementById('btn-upgrade');

        if (data.status === 'active' || data.status === 'trialing') {
          const active = data.status === 'active';
          statusEl.innerHTML = `<span class="plan-badge ${active ? 'active' : 'trial'}"><span class="plan-dot"></span>${active ? 'Activo' : 'Prueba gratuita'}</span>`;
          nameEl.textContent = 'MediQ Pro Â· ' + (data.plan_id?.includes('annual') ? 'Anual' : 'Mensual');
          if (data.current_period_end) {
            renewsEl.textContent = new Date(data.current_period_end * 1000)
              .toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
          }
          billingBtn.style.display = '';
          upgradeBtn.style.display = 'none';
        } else if (data.status === 'canceled') {
          statusEl.innerHTML = `<span class="plan-badge none"><span class="plan-dot"></span>Cancelada</span>`;
          renewsEl.textContent = 'No se renovarÃ¡';
        }
      } catch (_) {}
    }

    /* â”€â”€ Acciones â”€â”€ */
    function bindActions(session) {
      /* Guardar perfil */
      document.getElementById('save-profile').addEventListener('click', async () => {
        const newName = document.getElementById('inp-name').value.trim();
        if (!newName) { toast('El nombre no puede estar vacÃ­o.'); return; }
        const { error } = await sb.auth.updateUser({ data: { name: newName } });
        if (error) { toast('Error: ' + error.message); return; }
        document.getElementById('profile-name').textContent = newName;
        document.getElementById('ava-lg').textContent       = newName.charAt(0).toUpperCase();
        toast('Perfil actualizado âœ“');
      });

      /* Cambiar contraseÃ±a â€” requiere verificar la contraseÃ±a actual antes de
         cambiarla, para evitar que alguien con acceso fÃ­sico a una sesiÃ³n abierta
         pueda bloquear al usuario fuera de su propia cuenta.
         La verificaciÃ³n se hace re-autenticando con signInWithPassword; si es OK,
         se llama a updateUser({ password }). */
      const btnPw = document.getElementById('save-pw');
      btnPw.addEventListener('click', async () => {
        const cur = document.getElementById('inp-pw-current').value;
        const pw  = document.getElementById('inp-pw').value;
        const pw2 = document.getElementById('inp-pw2').value;

        if (!cur)          { toast('Introduce tu contraseÃ±a actual.'); return; }
        if (pw.length < 8) { toast('La nueva contraseÃ±a debe tener al menos 8 caracteres.'); return; }
        if (pw === cur)    { toast('La nueva contraseÃ±a debe ser distinta a la actual.'); return; }
        if (pw !== pw2)    { toast('Las contraseÃ±as nuevas no coinciden.'); return; }

        const email = user?.email;
        if (!email) { toast('SesiÃ³n no vÃ¡lida. Vuelve a entrar.'); return; }

        btnPw.disabled = true;
        const oldLabel = btnPw.textContent;
        btnPw.textContent = 'Verificandoâ€¦';

        try {
          // 1) Verificar contraseÃ±a actual re-autenticando
          const { error: signInErr } = await sb.auth.signInWithPassword({ email, password: cur });
          if (signInErr) { toast('La contraseÃ±a actual es incorrecta.'); return; }

          // 2) Cambiar contraseÃ±a
          btnPw.textContent = 'Cambiandoâ€¦';
          const { error: updateErr } = await sb.auth.updateUser({ password: pw });
          if (updateErr) { toast('Error: ' + updateErr.message); return; }

          document.getElementById('inp-pw-current').value = '';
          document.getElementById('inp-pw').value         = '';
          document.getElementById('inp-pw2').value        = '';
          toast('ContraseÃ±a actualizada âœ“');
        } catch (err) {
          toast('Error inesperado: ' + (err.message || err));
        } finally {
          btnPw.disabled = false;
          btnPw.textContent = oldLabel;
        }
      });

      /* Gestionar facturaciÃ³n (Stripe portal) */
      document.getElementById('btn-billing').addEventListener('click', async () => {
        const btn = document.getElementById('btn-billing');
        btn.textContent = 'Redirigiendoâ€¦';
        btn.disabled = true;
        try {
          const { data: { session: s } } = await sb.auth.getSession();
          const res  = await fetch('/api/billing-portal', {
            method: 'POST',
            headers: { 'Authorization': 'Bearer ' + s.access_token }
          });
          const json = await res.json();
          if (json.url) { location.href = json.url; return; }
          throw new Error();
        } catch {
          toast('Error al abrir el portal de facturaciÃ³n.');
          btn.textContent = 'Gestionar facturaciÃ³n â†’';
          btn.disabled = false;
        }
      });

      /* Cerrar sesiÃ³n */
      document.getElementById('logout-btn').addEventListener('click', async () => {
        await sb.auth.signOut();
        try { localStorage.removeItem('mediq.authHint'); } catch (_) {}
        location.href = '/login';
      });

      /* Eliminar cuenta */
      const modal      = document.getElementById('modal-delete');
      const delInput   = document.getElementById('confirm-del-input');
      const confirmBtn = document.getElementById('confirm-del');

      document.getElementById('delete-btn').addEventListener('click', () => {
        delInput.value    = '';
        confirmBtn.disabled = true;
        confirmBtn.style.opacity = '.45';
        modal.classList.add('open');
        setTimeout(() => delInput.focus(), 80);
      });
      document.getElementById('cancel-del').addEventListener('click', () => modal.classList.remove('open'));
      modal.addEventListener('click', (e) => { if (e.target === modal) modal.classList.remove('open'); });

      delInput.addEventListener('input', () => {
        const ok = delInput.value.trim().toLowerCase() === 'eliminar';
        confirmBtn.disabled = !ok;
        confirmBtn.style.opacity = ok ? '1' : '.45';
      });

      confirmBtn.addEventListener('click', async () => {
        confirmBtn.disabled = true;
        confirmBtn.textContent = 'Eliminandoâ€¦';
        try {
          const { data: { session: s } } = await sb.auth.getSession();
          const res = await fetch('/api/delete-account', {
            method: 'POST',
            headers: { 'Authorization': 'Bearer ' + s.access_token }
          });
          if (!res.ok) throw new Error();
          await sb.auth.signOut();
          try { localStorage.clear(); sessionStorage.clear(); } catch (_) {}
          location.href = '/login?deleted=1';
        } catch {
          toast('Error al eliminar la cuenta. Contacta con soporte.');
          modal.classList.remove('open');
          confirmBtn.disabled = false;
          confirmBtn.textContent = 'Eliminar para siempre';
        }
      });
    }

    /* â”€â”€ Scroll spy para nav sidebar â”€â”€ */
    const navLinks = document.querySelectorAll('.acct-nav a[href^="#"]');
    const obs = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          navLinks.forEach(a => a.classList.toggle('active', a.getAttribute('href') === '#' + e.target.id));
        }
      });
    }, { threshold: 0.4, rootMargin: '-64px 0px -40% 0px' });
    ['profile','plan','security','danger'].forEach(id => {
      const el = document.getElementById(id);
      if (el) obs.observe(el);
    });
  </script>

</Layout>
