---
import Layout from '../layouts/Layout.astro';
const SUPABASE_URL      = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---

<Layout title="Chat compartido — MediQ" navActive="" noindex={true}>
  <style is:global>
    .share-wrap { max-width: 760px; margin: 48px auto; padding: 0 var(--pad) 80px; }
    .share-head { margin-bottom: 32px; padding-bottom: 20px; border-bottom: 1px solid var(--rule); }
    .share-head h1 { font-size: clamp(20px, 2.5vw, 28px); margin-bottom: 6px; }
    .share-head .meta { font-family: var(--f-mono); font-size: 11px; color: var(--ink-mute); letter-spacing: 0.06em; text-transform: uppercase; }
    .share-msgs { display: flex; flex-direction: column; gap: 24px; }
    .share-msg { display: grid; grid-template-columns: 36px 1fr; gap: 14px; align-items: start; }
    .share-msg .av { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; font-family: var(--f-display); font-size: 14px; flex-shrink: 0; }
    .share-msg.user .av { background: var(--bg-2); border: 1px solid var(--rule-2); color: var(--ink); }
    .share-msg.ai .av { background: var(--ink); color: var(--bg); position: relative; }
    .share-msg.ai .av::after { content: ""; position: absolute; inset: 6px; border-radius: 50%; background: var(--accent); }
    .share-msg .body { padding-top: 4px; }
    .share-msg .role-line { font-family: var(--f-mono); font-size: 10.5px; color: var(--ink-mute); letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 6px; display: flex; gap: 8px; align-items: center; }
    .share-msg .content { font-size: 15.5px; line-height: 1.6; color: var(--ink); word-wrap: break-word; }
    .share-msg.user .content { white-space: pre-wrap; }
    .share-msg.ai .content { color: var(--ink-soft); }
    .share-msg.ai .content b, .share-msg.ai .content strong { color: var(--ink); font-weight: 600; }
    .share-msg.ai .content h3 { font-size: 16px; margin: 12px 0 4px; font-weight: 600; font-family: var(--f-body); color: var(--ink); }
    .share-msg.ai .content code { font-family: var(--f-mono); font-size: 13px; background: var(--bg-2); padding: 1px 5px; border-radius: 4px; }
    .share-msg.ai .content pre { background: var(--bg-2); padding: 10px 12px; border-radius: 8px; overflow-x: auto; font-family: var(--f-mono); font-size: 13px; }
    .share-msg.ai .content ul, .share-msg.ai .content ol { margin: 8px 0; padding-left: 22px; }
    .share-msg.ai .content li { margin: 4px 0; }
    .share-actions { margin-top: 40px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
    .share-disclaimer { margin-top: 20px; font-family: var(--f-mono); font-size: 10.5px; color: var(--ink-mute); letter-spacing: 0.04em; display: flex; gap: 6px; align-items: flex-start; }
    .share-state { text-align: center; padding: 80px 0; }
    .share-state p { color: var(--ink-mute); margin-bottom: 24px; font-size: 15px; }
    .share-spinner { width: 32px; height: 32px; border: 2px solid var(--rule-2); border-top-color: var(--accent); border-radius: 50%; animation: spin .7s linear infinite; margin: 0 auto 16px; }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>

  <div class="share-wrap">
    <div id="share-loading" class="share-state">
      <div class="share-spinner"></div>
      <p style="font-family:var(--f-mono); font-size:12px; color:var(--ink-mute);">Cargando conversación…</p>
    </div>

    <div id="share-error" class="share-state" style="display:none;">
      <p>No se encontró esta conversación o el enlace ha expirado.</p>
      <a href="/" class="btn btn-primary">Volver al inicio →</a>
    </div>

    <div id="share-content" style="display:none;">
      <div class="share-head">
        <h1 id="share-title"></h1>
        <div class="meta" id="share-meta"></div>
      </div>
      <div class="share-msgs" id="share-msgs"></div>
      <div class="share-actions">
        <a href="/chat" class="btn btn-primary">Usar MediQ →</a>
        <span style="font-family:var(--f-mono); font-size:11px; color:var(--ink-mute);">Compartido desde MediQ</span>
      </div>
      <p class="share-disclaimer">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none"><path d="M12 9v4M12 17h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Herramienta de apoyo clínico — las decisiones finales corresponden al profesional sanitario.
      </p>
    </div>
  </div>

  <script is:inline define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY }}>
    (function () {
      const params  = new URLSearchParams(location.search);
      const shareId = params.get('id');
      if (!shareId) { showError(); return; }

      const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

      sb.from('shared_chats').select('*').eq('id', shareId).single()
        .then(({ data, error }) => {
          if (error || !data) { showError(); return; }

          document.getElementById('share-loading').style.display = 'none';
          document.getElementById('share-content').style.display  = '';
          document.getElementById('share-title').textContent = data.title;

          const date = new Date(data.created_at).toLocaleDateString('es', { day: '2-digit', month: 'long', year: 'numeric' });
          document.getElementById('share-meta').textContent =
            `Especialidad: ${data.specialty || 'General'} · ${date}`;

          const msgsEl = document.getElementById('share-msgs');
          (data.messages || []).forEach(m => {
            if (m.pending) return;
            const time = new Date(m.at).toLocaleTimeString('es', { hour: '2-digit', minute: '2-digit' });
            const el = document.createElement('div');
            el.className = `share-msg ${m.role}`;
            const content = m.role === 'ai'
              ? mdRender(m.text || '')
              : escHtml(m.text || '').replace(/\n/g, '<br>');
            el.innerHTML = `
              <div class="av">${m.role === 'user' ? escHtml((m.text||'U')[0].toUpperCase()) : ''}</div>
              <div class="body">
                <div class="role-line">
                  <span>${m.role === 'ai' ? 'MediQ' : 'Tú'}</span>·<span>${time}</span>
                </div>
                <div class="content">${content}</div>
              </div>`;
            msgsEl.appendChild(el);
          });
        });

      function showError() {
        document.getElementById('share-loading').style.display = 'none';
        document.getElementById('share-error').style.display   = '';
      }

      function escHtml(s) {
        return String(s).replace(/[&<>"']/g, c =>
          ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
      }

      function mdRender(text) {
        let s = escHtml(text);
        s = s.replace(/```([\s\S]*?)```/g, (_, c) =>
          `<pre>${c}</pre>`);
        s = s.replace(/`([^`]+)`/g, '<code>$1</code>');
        s = s.replace(/^#{1,3} (.+)$/gm, '<h3>$1</h3>');
        s = s.replace(/\*\*(.+?)\*\*/g, '<b>$1</b>');
        s = s.replace(/(^|[^*])\*([^*\n]+)\*/g, '$1<em>$2</em>');
        s = s.replace(/_([^_\n]+)_/g, '<em>$1</em>');
        s = s.replace(/(?:^|\n)((?:- .+\n?)+)/g, (_, b) =>
          '\n<ul>' + b.trim().split('\n').map(l => '<li>' + l.replace(/^- /, '') + '</li>').join('') + '</ul>');
        s = s.replace(/(?:^|\n)((?:\d+\. .+\n?)+)/g, (_, b) =>
          '\n<ol>' + b.trim().split('\n').map(l => '<li>' + l.replace(/^\d+\. /, '') + '</li>').join('') + '</ol>');
        s = s.replace(/\n/g, '<br>');
        return s;
      }
    })();
  </script>
</Layout>
