<!--
  Scripts de index.astro.
  Al ser is:inline en <body>, Astro los re-ejecuta en cada navegación SPA
  hacia esta página. Los guardamos con flags en window para evitar
  duplicación de listeners globales (window.addEventListener).
-->
<script is:inline>
  /* ───────── TWEAKS defaults ─────────
     Se usa window.TWEAKS (no const) para que persista entre navegaciones
     SPA y sea accesible desde cualquier contexto de script.
     El bloque EDITMODE-BEGIN/END lo preserva el design tool.
  */
  if (!window.TWEAKS) {
    window.TWEAKS = /*EDITMODE-BEGIN*/{
      "brandName": "MediQ",
      "theme": "clinical",
      "typePair": "serif-soft",
      "visualStyle": "technical"
    }/*EDITMODE-END*/;
  }

  const root = document.documentElement;

  function applyTweaks(t) {
    root.setAttribute('data-theme', t.theme);
    root.setAttribute('data-type',  t.typePair);
    root.setAttribute('data-style', t.visualStyle);
    document.querySelectorAll('[data-brand]').forEach(el => el.textContent = t.brandName);
    document.title = t.brandName + ' — soporte clínico con IA';

    document.querySelectorAll('.swatch').forEach(b   => b.classList.toggle('on', b.dataset.theme === t.theme));
    document.querySelectorAll('#t-type button').forEach(b => b.classList.toggle('on', b.dataset.val === t.typePair));
    document.querySelectorAll('#t-style button').forEach(b => b.classList.toggle('on', b.dataset.val === t.visualStyle));
    const brandInput = document.getElementById('t-brand');
    if (brandInput && document.activeElement !== brandInput) brandInput.value = t.brandName;

    // Persistir para que el script del <head> restaure los data-* antes del primer paint
    try { localStorage.setItem('mediq:tweaks', JSON.stringify(t)); } catch (e) {}
  }

  // Si el script del <head> ya restauró tweaks desde localStorage, adoptamos esos valores
  try {
    const stored = JSON.parse(localStorage.getItem('mediq:tweaks') || 'null');
    if (stored && typeof stored === 'object') Object.assign(window.TWEAKS, stored);
  } catch (e) {}

  applyTweaks(window.TWEAKS);

  /* ───────── Word-reveal split ─────────
     Guardamos el flag .split-done en el elemento para no volver a
     procesar los spans en navegaciones SPA de vuelta a esta página.
  */
  document.querySelectorAll('.word-reveal:not([data-split-done])').forEach(el => {
    el.dataset.splitDone = '1';
    const tmp  = document.createElement('div');
    tmp.innerHTML = el.innerHTML;
    const walk = (node, out) => {
      node.childNodes.forEach(n => {
        if (n.nodeType === 3) {
          n.textContent.split(/(\s+)/).forEach(part => {
            if (!part) return;
            if (/^\s+$/.test(part)) { out.appendChild(document.createTextNode(part)); return; }
            const s = document.createElement('span');
            s.className = 'w'; s.textContent = part;
            out.appendChild(s);
          });
        } else {
          const clone = n.cloneNode(false);
          if (n.nodeType === 1 && n.tagName === 'EM') {
            n.childNodes.forEach(ch => {
              if (ch.nodeType === 3) {
                ch.textContent.split(/(\s+)/).forEach(part => {
                  if (!part) return;
                  if (/^\s+$/.test(part)) { clone.appendChild(document.createTextNode(part)); return; }
                  const s = document.createElement('span');
                  s.className = 'w'; s.textContent = part;
                  clone.appendChild(s);
                });
              }
            });
          } else { walk(n, clone); }
          out.appendChild(clone);
        }
      });
    };
    const container = document.createElement('span');
    walk(tmp, container);
    el.innerHTML = container.innerHTML;
    el.querySelectorAll('.w').forEach((w, i) => { w.style.transitionDelay = (i * 55) + 'ms'; });
  });

  /* ───────── Scroll reveal ─────────
     Primera visita en la sesión: anima los elementos al entrar en viewport.
     Visitas posteriores (SPA, botón atrás, etc.): visible de golpe.
     pageshow.persisted: restauración desde bfcache del navegador.

     sessionStorage es la señal más fiable porque sobrevive las View
     Transitions pero se resetea al cerrar la pestaña (nueva sesión = nueva
     animación). No dependemos del timing de snapshots ni de popstate.
  */
  if (window.__revealObserver) window.__revealObserver.disconnect();

  const _alreadySeen = !!sessionStorage.getItem('mediq.index.v1');
  if (!_alreadySeen) sessionStorage.setItem('mediq.index.v1', '1');

  const _showNow = _alreadySeen || window.__didPop || window.__astroNavDir === 'back';
  window.__didPop      = false;
  window.__astroNavDir = undefined;

  if (_showNow) {
    document.querySelectorAll('.reveal, .word-reveal').forEach(el => el.classList.add('in'));
  } else {
    window.__revealObserver = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('in'); window.__revealObserver.unobserve(e.target); }
      });
    }, { threshold: 0.14, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal, .word-reveal').forEach(el => {
      el.classList.remove('in');
      window.__revealObserver.observe(el);
    });
  }

  // Bfcache: el navegador restaura la página congelada sin re-ejecutar scripts.
  // pageshow con persisted=true es el único hook fiable en ese caso.
  if (!window.__pgsReveal) {
    window.__pgsReveal = true;
    window.addEventListener('pageshow', (e) => {
      if (e.persisted) {
        document.querySelectorAll('.reveal, .word-reveal').forEach(el => el.classList.add('in'));
      }
    });
  }

  /* ───────── Tweak-mode host protocol ─────────
     Solo registramos el listener de postMessage UNA VEZ por sesión.
     En re-ejecuciones SPA eliminamos el anterior antes de añadir el nuevo.
  */
  if (window.__tweakMsgHandler) window.removeEventListener('message', window.__tweakMsgHandler);
  window.__tweakMsgHandler = (e) => {
    const d = e.data || {};
    const panel = document.getElementById('tweaks');
    if (!panel) return;
    if (d.type === '__activate_edit_mode')   panel.classList.add('open');
    if (d.type === '__deactivate_edit_mode') panel.classList.remove('open');
  };
  window.addEventListener('message', window.__tweakMsgHandler);
  window.parent.postMessage({ type: '__edit_mode_available' }, '*');

  /* Los listeners solo se enganchan si el panel existe (solo en dev).
     En producción el aside no se renderiza y estos getElementById devuelven null. */
  const tCloseBtn = document.getElementById('t-close');
  if (tCloseBtn) {
    tCloseBtn.addEventListener('click', () => {
      document.getElementById('tweaks')?.classList.remove('open');
    });
  }

  function setTweak(patch) {
    Object.assign(window.TWEAKS, patch);
    applyTweaks(window.TWEAKS);
    window.parent.postMessage({ type: '__edit_mode_set_keys', edits: patch }, '*');
  }

  const tBrandInput = document.getElementById('t-brand');
  if (tBrandInput) {
    tBrandInput.addEventListener('input', (e) => {
      setTweak({ brandName: e.target.value || 'MediQ' });
    });
  }
  document.querySelectorAll('.tweaks-panel [data-name]').forEach(b => {
    b.addEventListener('click', () => setTweak({ brandName: b.dataset.name }));
  });
  document.querySelectorAll('.swatch').forEach(b => {
    b.addEventListener('click', () => setTweak({ theme: b.dataset.theme }));
  });
  document.querySelectorAll('#t-type button').forEach(b => {
    b.addEventListener('click', () => setTweak({ typePair: b.dataset.val }));
  });
  document.querySelectorAll('#t-style button').forEach(b => {
    b.addEventListener('click', () => setTweak({ visualStyle: b.dataset.val }));
  });
</script>

</Layout>
