        name: document.getElementById('profile-name').value.trim(),
        role: document.getElementById('profile-role').value,
        specialty: document.getElementById('profile-specialty').value.trim(),
        institution: document.getElementById('profile-institution').value.trim(),
      };
      localStorage.setItem(PROFILE_KEY, JSON.stringify(profile));
      avaNav.textContent = avaInitial();
      accountLabel.textContent = displayName().split(' ')[0];
      const banner = document.getElementById('onboarding-banner');
      if (banner) banner.style.display = 'none';
      localStorage.setItem('mediq.banner.v1', '1');
      closeModal('modal-profile');
    });

    function hydrateSettingsModal() {
      document.getElementById('set-default-specialty').value = settings.defaultSpecialty || 'General';
      document.querySelectorAll('#modal-settings .switch').forEach(sw => {
        const k = sw.dataset.setting;
        sw.classList.toggle('on', !!settings[k]);
        sw.setAttribute('aria-pressed', settings[k] ? 'true' : 'false');
      });
    }
    document.querySelectorAll('#modal-settings .switch').forEach(sw => {
      sw.addEventListener('click', () => {
        sw.classList.toggle('on');
        sw.setAttribute('aria-pressed', sw.classList.contains('on') ? 'true' : 'false');
      });
    });
    document.getElementById('settings-save').addEventListener('click', () => {
      settings.defaultSpecialty = document.getElementById('set-default-specialty').value;
      document.querySelectorAll('#modal-settings .switch').forEach(sw => {
        settings[sw.dataset.setting] = sw.classList.contains('on');
      });
      localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings));
      closeModal('modal-settings');
    });
    document.getElementById('export-chats').addEventListener('click', () => {
      const blob = new Blob([JSON.stringify(chats, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = 'mediq-chats-' + new Date().toISOString().slice(0, 10) + '.json';
      a.click(); URL.revokeObjectURL(url);
    });
    document.getElementById('clear-chats').addEventListener('click', () => {
      if (!confirm('¿Borrar TODAS las conversaciones? Esta acción no se puede deshacer.')) return;
      chats = []; activeId = null;
      saveChats(); renderSidebar(); renderMessages(null);
      closeModal('modal-settings');
      if (sbUser) sb.from('chats').delete().eq('user_id', sbUser.id).then(({ error }) => {
        if (error) console.error('[chats] clear error:', error);
      });
    });

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    function md(text) {
      let s = escapeHtml(text);
      s = s.replace(/```([\s\S]*?)```/g, (_, c) => `<pre style="background:var(--bg-2); padding:10px 12px; border-radius:8px; overflow-x:auto; font-family:var(--f-mono); font-size:13px;">${c}</pre>`);
      s = s.replace(/`([^`]+)`/g, '<code>$1</code>');
      s = s.replace(/^### (.+)$/gm, '<h3>$1</h3>');
      s = s.replace(/^## (.+)$/gm, '<h3>$1</h3>');
      s = s.replace(/^# (.+)$/gm, '<h3>$1</h3>');
      s = s.replace(/\*\*(.+?)\*\*/g, '<b>$1</b>');
      s = s.replace(/(^|[^*])\*([^*\n]+)\*/g, '$1<em>$2</em>');
      s = s.replace(/_([^_\n]+)_/g, '<em>$1</em>');
      s = s.replace(/(?:^|\n)((?:- .+\n?)+)/g, (m, block) => {
        const items = block.trim().split(/\n/).map(l => '<li>' + l.replace(/^- /, '') + '</li>').join('');
        return '\n<ul>' + items + '</ul>';
      });
      s = s.replace(/(?:^|\n)((?:\d+\. .+\n?)+)/g, (m, block) => {
        const items = block.trim().split(/\n/).map(l => '<li>' + l.replace(/^\d+\. /, '') + '</li>').join('');
        return '\n<ol>' + items + '</ol>';
      });
      return s;
    }

    function renderMessages(chat) {
      msgsInner.querySelectorAll('.msg').forEach(n => n.remove());
      if (!chat || chat.messages.length === 0) {
        welcomeEl.style.display = '';
        messagesEl.classList.add('welcome-mode');
        renderSuggestions();
        startSuggestionRotation();
        titleEl.textContent = chat?.title || 'Nueva consulta';
        return;
      }
      stopSuggestionRotation();
      messagesEl.classList.remove('welcome-mode');
      welcomeEl.style.display = 'none';
      titleEl.textContent = chat.title || 'Conversación';
      chat.messages.forEach(m => msgsInner.appendChild(buildMsgEl(m)));
      requestAnimationFrame(() => { messagesEl.scrollTop = messagesEl.scrollHeight; });
    }

    function buildMsgEl(m) {
      const wrap = document.createElement('div');
      wrap.className = 'msg ' + m.role;
      const av = m.role === 'ai'
        ? `<div class="av"></div>`
        : `<div class="av">${sbUser?.email ? sbUser.email[0].toUpperCase() : 'M'}</div>`;
      const role = m.role === 'ai' ? 'MediQ' : 'Tú';
      const time = new Date(m.at).toLocaleTimeString('es', { hour: '2-digit', minute: '2-digit' });
      let attachHtml = '';
      if (m.attachments && m.attachments.length) {
        attachHtml = '<div style="margin-bottom:8px;">' + m.attachments.map(a =>
          `<span class="msg-attach"><svg class="ic-file" viewBox="0 0 16 16" fill="none"><path d="M9 1H3a1 1 0 00-1 1v12a1 1 0 001 1h10a1 1 0 001-1V6L9 1z" stroke="currentColor" stroke-width="1.4"/><path d="M9 1v5h5" stroke="currentColor" stroke-width="1.4"/></svg><span>${escapeHtml(a.name)}</span><span class="meta">${a.pages}p · ${Math.round(a.chars / 1000)}k</span></span>`
        ).join('') + '</div>';
      }
      const content = m.pending
        ? `<div class="content"><span class="typing"><i></i><i></i><i></i></span></div>`
        : `<div class="content">${m.role === 'ai' ? md(m.text) : escapeHtml(m.text)}</div>`;
      const copyBtn = m.role === 'ai' && !m.pending
        ? `<button class="copy-btn" aria-label="Copiar respuesta">Copiar</button>`
        : '';
      wrap.innerHTML = `${av}<div class="body"><div class="role-line"><span>${role}</span>·<span>${time}</span>${copyBtn}</div>${attachHtml}${content}</div>`;
      if (m.role === 'ai' && !m.pending) {
        wrap.querySelector('.copy-btn').addEventListener('click', function () {
          navigator.clipboard.writeText(m.text).then(() => {
            this.textContent = '✓ Copiado';
            this.classList.add('copied');
            setTimeout(() => { this.textContent = 'Copiar'; this.classList.remove('copied'); }, 2000);
          });
        });
      }
      return wrap;
    }

    /* ═══════════════════════════════════════════════════════════
       CHAT OPS
       ═══════════════════════════════════════════════════════════ */
    function newChat() {
      activeId = null;
      renderMessages(null);
      renderSidebar();
      input.focus();
    }

    function openChat(id) {
      const c = chats.find(x => x.id === id);
      if (!c) return;
      activeId = id;
      specialty = c.specialty || 'General';
      document.getElementById('specialty-label').textContent = specialty;
      document.querySelectorAll('#specialty-menu button').forEach(b => b.classList.toggle('on', b.dataset.sp === specialty));
      renderMessages(c);
      renderSidebar();
    }

    function ensureChat() {
      if (activeId) return chats.find(x => x.id === activeId);
      const c = {
        id: 'c_' + Date.now().toString(36),
        title: 'Nueva consulta',
        specialty,
        messages: [],
        createdAt: Date.now(),
        updatedAt: Date.now()
      };
      chats.unshift(c);
      activeId = c.id;
      return c;
    }

    async function sendMessage(text) {
      if (paywallActive) return;
      if (sending) return;
      if (!text.trim() && pendingAttachments.length === 0) return;
      if (pendingAttachments.some(a => a.status === 'processing')) return;

      sending = true;
      sendBtn.disabled = true;

      const chat = ensureChat();
      const attachments = pendingAttachments
        .filter(a => a.status === 'ready')
        .map(a => ({ name: a.name, size: a.size, pages: a.pages, chars: a.text.length, text: a.text }));

      if (chat.messages.length === 0) {
        if (text.trim()) {
          chat.title = text.length > 48 ? text.slice(0, 48).trim() + '…' : text.trim();
        } else if (attachments.length) {
          chat.title = attachments[0].name.replace(/\.pdf$/i, '');
        }
        window.track('Chat Started', { specialty });
        // Si el chat viene de un CasoCTA (?caso=slug), trackeamos aparte.
        // Solo se dispara una vez por sesion de caso — sin repetir en mensajes
        // subsiguientes de la misma conversacion.
        try {
          const ctx = window.__mediqCasoContext;
          if (ctx && !ctx.tracked) {
            ctx.tracked = true;
            window.track('caso_chat_iniciado', {
              slug: ctx.slug,
              nivel: ctx.nivel || undefined,
              rama: ctx.rama || undefined,
            });
          }
        } catch (_) {}
      }
      window.track('Message Sent', { specialty, has_attachment: attachments.length > 0 ? 'yes' : 'no' });

      chat.messages.push({
        role: 'user',
        text: text || (attachments.length ? `He adjuntado ${attachments.length} documento${attachments.length > 1 ? 's' : ''}. Analízalo y dime lo más relevante.` : ''),
        attachments: attachments.map(a => ({ name: a.name, size: a.size, pages: a.pages, chars: a.chars })),
        at: Date.now()
      });
      chat.updatedAt = Date.now();

      pendingAttachments = [];
      renderAttachments();
      saveChats(chat);
      renderMessages(chat);
      renderSidebar();

      const pending = { role: 'ai', text: '', at: Date.now(), pending: true };
      chat.messages.push(pending);
      renderMessages(chat);

      const allMsgs = chat.messages
        .filter(m => !m.pending)
        .map(m => ({ role: m.role === 'ai' ? 'assistant' : 'user', content: m.text }));

      // Si hay resumen cacheado, usar solo los últimos 8 mensajes + el resumen ya está en el system prompt
      const apiMsgs = chat.historySummary && allMsgs.length > HISTORY_THRESHOLD
        ? allMsgs.slice(-8)
        : allMsgs;

      if (attachments.length) {
        for (let i = apiMsgs.length - 1; i >= 0; i--) {
          if (apiMsgs[i].role === 'user') {
            const docs = attachments.map(a =>
              `\n\n===== DOCUMENTO ADJUNTO: ${a.name} (${a.pages} páginas) =====\n${a.text.slice(0, 60000)}\n===== FIN DEL DOCUMENTO =====`
            ).join('');
            apiMsgs[i].content = (apiMsgs[i].content || '') + docs;
            break;
          }
        }
      }

      // Capturamos el elemento del mensaje pendiente para actualizarlo en vivo
      const streamEl = msgsInner.lastElementChild;
      const streamContent = streamEl?.querySelector('.content');

      function finishSend() {
        chat.updatedAt = Date.now();
        saveChats(chat);
        renderMessages(chat);
        renderSidebar();
        sending = false;
        sendBtn.disabled = input.value.trim().length === 0;
        input.focus();
      }

      // Detectar cambio de tema explícito → limpiar topic/summary para no anclar el modelo
      if (TOPIC_SHIFT_RE.test(text)) {
        delete chat.historySummary;
      }

      await window.claude.stream({
        system: systemPrompt(chat),
        messages: apiMsgs,
        onChunk(accumulated) {
          pending.text = accumulated;
          if (streamContent) streamContent.innerHTML = md(accumulated);
          messagesEl.scrollTop = messagesEl.scrollHeight;
        },
        onDone(fullText) {
          pending.text = fullText.trim();
          pending.pending = false;
          pending.at = Date.now();
          finishSend();
          // Generar resumen en background cuando se supera el umbral
          const completedMsgs = chat.messages.filter(m => !m.pending);
          if (completedMsgs.length >= HISTORY_THRESHOLD && !chat.historySummary) {
            summarizeHistory(chat);
          }
        },
        onError(err) {
          console.error('[chat] error:', err);
          pending.text = `⚠️ Error: ${err.message || err}. Revisa la consola del servidor.`;
          pending.pending = false;
          finishSend();
        },
      });
    }

    /* ═══════════════════════════════════════════════════════════
       COMPOSER
       ═══════════════════════════════════════════════════════════ */
    const input         = document.getElementById('input');
    const sendBtn       = document.getElementById('send');
    const composer      = document.getElementById('composer');
    const attachBtn     = document.getElementById('attach-btn');
    const fileInput     = document.getElementById('file-input');
    const attachmentsEl = document.getElementById('attachments');
    const dropOverlay   = document.getElementById('drop-overlay');

    let pendingAttachments = [];

    function updateSendState() {
      const hasText      = input.value.trim().length > 0;
      const hasReady     = pendingAttachments.some(a => a.status === 'ready');
      const isProcessing = pendingAttachments.some(a => a.status === 'processing');
      sendBtn.disabled = paywallActive || sending || isProcessing || (!hasText && !hasReady);
    }

    function renderAttachments() {
      attachmentsEl.innerHTML = '';
      pendingAttachments.forEach(a => {
        const chip = document.createElement('span');
        chip.className = 'chip ' + (a.status === 'processing' ? 'processing' : a.status === 'error' ? 'error' : '');
        const sizeKb = (a.size / 1024).toFixed(0);
        const meta = a.status === 'ready' ? `${a.pages}p · ${sizeKb}KB`
          : a.status === 'error' ? 'error' : `${sizeKb}KB`;
        chip.innerHTML = `
          <svg class="ic-file" viewBox="0 0 16 16" fill="none"><path d="M9 1H3a1 1 0 00-1 1v12a1 1 0 001 1h10a1 1 0 001-1V6L9 1z" stroke="currentColor" stroke-width="1.4"/><path d="M9 1v5h5" stroke="currentColor" stroke-width="1.4"/></svg>
          <span class="name">${escapeHtml(a.name)}</span>
          <span class="meta">${meta}</span>
          <button type="button" class="x" data-id="${a.id}" aria-label="Quitar">
            <svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="M2 2l8 8M10 2l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </button>`;
        attachmentsEl.appendChild(chip);
      });
      attachmentsEl.querySelectorAll('button.x').forEach(b => {
        b.addEventListener('click', () => {
          pendingAttachments = pendingAttachments.filter(x => x.id !== b.dataset.id);
          renderAttachments();
          updateSendState();
        });
      });
      updateSendState();
    }

    async function extractPdfText(file) {
      if (!window.pdfjsLib) {
        for (let i = 0; i < 30; i++) {
          await new Promise(r => setTimeout(r, 150));
          if (window.pdfjsLib) break;
        }
        if (!window.pdfjsLib) throw new Error('PDF reader no disponible');
      }
      const buf = await file.arrayBuffer();
      const pdf = await window.pdfjsLib.getDocument({ data: buf }).promise;
      let text = '';
      for (let p = 1; p <= pdf.numPages; p++) {
        const page = await pdf.getPage(p);
        const content = await page.getTextContent();
        text += `\n--- Página ${p} ---\n${content.items.map(i => i.str).join(' ')}\n`;
      }
      return { text: text.trim(), pages: pdf.numPages };
    }

    async function handleFiles(fileList) {
      const files = [...fileList];
      for (const f of files) {
        if (f.type !== 'application/pdf' && !f.name.toLowerCase().endsWith('.pdf')) {
          const id = 'att_' + Math.random().toString(36).slice(2, 8);
          pendingAttachments.push({ id, name: f.name, size: f.size, status: 'error', error: 'Solo PDF' });
          renderAttachments();
          continue;
        }
        if (f.size > 20 * 1024 * 1024) {
          const id = 'att_' + Math.random().toString(36).slice(2, 8);
          pendingAttachments.push({ id, name: f.name, size: f.size, status: 'error', error: 'Máx 20 MB' });
          renderAttachments();
          continue;
        }
        const id = 'att_' + Math.random().toString(36).slice(2, 8);
        const att = { id, name: f.name, size: f.size, status: 'processing' };
        pendingAttachments.push(att);
        renderAttachments();
        try {
          const { text, pages } = await extractPdfText(f);
          att.text = text; att.pages = pages; att.status = 'ready';
        } catch (err) {
          console.error(err);
          att.status = 'error';
          att.error = String(err.message || err);
        }
        renderAttachments();
      }
    }

    attachBtn.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', (e) => {
      if (e.target.files && e.target.files.length) handleFiles(e.target.files);
      e.target.value = '';
    });

    /* drag & drop — guardados para evitar duplicados en navegación SPA */
    if (window.__chatDragEnter) window.removeEventListener('dragenter', window.__chatDragEnter);
    if (window.__chatDragOver)  window.removeEventListener('dragover',  window.__chatDragOver);
    if (window.__chatDragLeave) window.removeEventListener('dragleave', window.__chatDragLeave);
    if (window.__chatDrop)      window.removeEventListener('drop',      window.__chatDrop);

    let dragDepth = 0;
    window.__chatDragEnter = (e) => {
      if (e.dataTransfer && [...e.dataTransfer.types].includes('Files')) {
        dragDepth++;
        dropOverlay.classList.add('on');
      }
    };
    window.__chatDragOver = (e) => {
      if (e.dataTransfer && [...e.dataTransfer.types].includes('Files')) e.preventDefault();
    };
    window.__chatDragLeave = () => {
      dragDepth = Math.max(0, dragDepth - 1);
      if (dragDepth === 0) dropOverlay.classList.remove('on');
    };
    window.__chatDrop = (e) => {
      dragDepth = 0;
      dropOverlay.classList.remove('on');
      if (e.dataTransfer && e.dataTransfer.files.length) {
        e.preventDefault();
        handleFiles(e.dataTransfer.files);
      }
    };
    window.addEventListener('dragenter', window.__chatDragEnter);
    window.addEventListener('dragover',  window.__chatDragOver);
    window.addEventListener('dragleave', window.__chatDragLeave);
    window.addEventListener('drop',      window.__chatDrop);

    function autoresize() {
      input.style.height = 'auto';
      input.style.height = Math.min(input.scrollHeight, 200) + 'px';
    }
    input.addEventListener('input', () => { autoresize(); updateSendState(); });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); if (!sendBtn.disabled) composer.requestSubmit(); }
    });
    composer.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = input.value.trim();
      if (!text && !pendingAttachments.some(a => a.status === 'ready')) return;
      input.value = '';
      autoresize();
      sendMessage(text);
    });

    const SUGGESTIONS_POOL = [
      { cat: 'Caso clínico', text: 'Dolor torácico opresivo + supradesnivel ST inferior en varón 58a', prompt: 'Varón de 58 años con dolor torácico opresivo de 40 minutos que irradia a brazo izquierdo. ECG muestra supradesnivel ST en DII, DIII y aVF. ¿Diagnóstico diferencial y manejo prioritario?' },
      { cat: 'Interacciones', text: 'Warfarina + amoxi-clavulánico en paciente FA', prompt: 'Paciente de 72 años con fibrilación auricular toma warfarina. Necesita iniciar amoxicilina-clavulánico por neumonía. ¿Qué interacciones debo vigilar y cómo ajusto?' },
      { cat: 'Modo estudiante', text: 'CHA₂DS₂-VASc explicado paso a paso', prompt: 'Explícame el score CHA2DS2-VASc paso a paso, qué evalúa, cómo se calcula y cuándo está indicado anticoagular.' },
      { cat: 'Caso clínico', text: 'Cefalea + HTA en embarazo de 16 semanas', prompt: 'Mujer de 28 años, embarazo de 16 semanas, con cefalea persistente y TA 150/95. ¿Cómo enfocar el diagnóstico diferencial?' },
      { cat: 'Farmacología', text: 'Diferencias entre IECA y ARA-II: ¿cuándo elegir uno u otro?', prompt: 'Explícame las diferencias clínicas entre IECAs y ARA-II: mecanismo, efectos adversos y en qué situaciones prefieres uno sobre otro.' },
      { cat: 'Urgencias', text: 'Manejo inicial del shock séptico en urgencias', prompt: 'Paciente de 65 años con fiebre, hipotensión (TA 80/50) y taquicardia. Sospecha de shock séptico. ¿Cuál es el manejo inicial según la campaña Surviving Sepsis?' },
      { cat: 'Caso clínico', text: 'Varón joven con disnea + sibilancias + antecedente atópico', prompt: 'Varón de 22 años acude con disnea aguda, sibilancias espiratorias y antecedente de dermatitis atópica. ¿Diagnóstico más probable, criterios de gravedad y tratamiento de primera línea?' },
      { cat: 'Modo estudiante', text: '¿Qué es el SOFA score y cómo se interpreta?', prompt: 'Explícame el SOFA score: qué parámetros incluye, cómo se calcula y qué valor tiene para el diagnóstico y pronóstico de la sepsis.' },
      { cat: 'Farmacología', text: 'Criterios Beers: fármacos a evitar en el anciano', prompt: '¿Cuáles son los grupos de fármacos más importantes de los criterios Beers y por qué se deben evitar en pacientes mayores de 65 años?' },
      { cat: 'Caso clínico', text: 'Mujer con artritis simétrica de pequeñas articulaciones + rigidez matutina', prompt: 'Mujer de 45 años con artritis simétrica en MCF e IFP, rigidez matutina de 2 horas y factor reumatoide positivo. ¿Cuál es el enfoque diagnóstico y cuándo inicio DMARDs?' },
      { cat: 'Urgencias', text: 'Crisis hipertensiva: emergencia vs urgencia', prompt: '¿Cuál es la diferencia entre emergencia y urgencia hipertensiva? ¿Qué fármacos usarías en cada caso y por qué?' },
      { cat: 'Modo estudiante', text: 'Interpretación sistemática del ECG de 12 derivaciones', prompt: 'Dame un método sistemático para interpretar un ECG de 12 derivaciones, paso a paso, sin saltarme nada importante.' },
      { cat: 'Caso clínico', text: 'Niño con fiebre + petequias + afectación del estado general', prompt: 'Niño de 4 años con fiebre de 39 °C, petequias en miembros inferiores y afectación del estado general. ¿Cuál es la principal sospecha y qué hago en los primeros 30 minutos?' },
      { cat: 'Farmacología', text: 'Antibiótico en alérgico a penicilina con infección grave', prompt: '¿Qué alternativas antibióticas tengo en un paciente con alergia severa a penicilina que necesita cobertura para estreptococo y estafilococo?' },
      { cat: 'Caso clínico', text: 'Varón de 50a con poliuria, polidipsia y glucemia 280 mg/dL', prompt: 'Varón de 50 años con poliuria, polidipsia de 3 semanas y glucemia casual de 280 mg/dL. ¿Criterios diagnósticos de DM2, inicio de tratamiento y objetivos de HbA1c?' },
      { cat: 'Modo estudiante', text: 'Diferencias entre DM tipo 1 y tipo 2: claves para el MIR', prompt: '¿Cuáles son las diferencias clínicas, fisiopatológicas y terapéuticas más importantes entre la diabetes mellitus tipo 1 y tipo 2 de cara al examen MIR?' },
    ];

    let lastShown = new Set();
    const suggestionsEl = document.getElementById('suggestions');

    function pickRandom(n) {
      const available = SUGGESTIONS_POOL.filter((_, i) => !lastShown.has(i));
      const pool = available.length >= n ? available : SUGGESTIONS_POOL;
      const picked = [];
      const indices = [];
      while (picked.length < n && pool.length > 0) {
        const idx = Math.floor(Math.random() * pool.length);
        picked.push(pool[idx]);
        const globalIdx = SUGGESTIONS_POOL.indexOf(pool[idx]);
        indices.push(globalIdx);
        pool.splice(idx, 1);
      }
      lastShown = new Set(indices);
      return picked;
    }

    function renderSuggestions() {
      const items = pickRandom(6);
      suggestionsEl.innerHTML = items.map(s =>
        `<button class="suggestion" data-prompt="${s.prompt.replace(/"/g, '&quot;')}" title="${s.text.replace(/"/g, '&quot;')}">${escapeHtml(s.text)}</button>`
      ).join('');
      suggestionsEl.querySelectorAll('.suggestion').forEach(s => {
        s.addEventListener('click', () => {
          input.value = s.dataset.prompt;
          autoresize();
          composer.requestSubmit();
        });
      });
    }

    function rotateSuggestions() {
      suggestionsEl.classList.add('fading');
      setTimeout(() => {
        renderSuggestions();
        suggestionsEl.classList.remove('fading');
      }, 350);
    }

    let suggestionTimer = null;

    function startSuggestionRotation() {
      if (suggestionTimer) return;
      suggestionTimer = setInterval(rotateSuggestions, 10000);
    }

    function stopSuggestionRotation() {
      clearInterval(suggestionTimer);
      suggestionTimer = null;
    }

    // renderSuggestions y startSuggestionRotation se llaman desde renderMessages(null) en el init

    document.getElementById('new-chat').addEventListener('click', newChat);

    const spBtn   = document.getElementById('specialty-btn');
    const spMenu  = document.getElementById('specialty-menu');
    const spLabel = document.getElementById('specialty-label');
    spBtn.addEventListener('click', (e) => { e.stopPropagation(); spMenu.classList.toggle('open'); });

    if (window.__chatSpClickHandler) document.removeEventListener('click', window.__chatSpClickHandler);
    window.__chatSpClickHandler = () => spMenu.classList.remove('open');
    document.addEventListener('click', window.__chatSpClickHandler);

    spMenu.addEventListener('click', (e) => e.stopPropagation());
    document.querySelectorAll('#specialty-menu button').forEach(b => {
      b.addEventListener('click', () => {
        specialty = b.dataset.sp;
        spLabel.textContent = specialty;
        document.querySelectorAll('#specialty-menu button').forEach(x => x.classList.toggle('on', x.dataset.sp === specialty));
        spMenu.classList.remove('open');
        if (activeId) {
          const c = chats.find(x => x.id === activeId);
          if (c) { c.specialty = specialty; saveChats(c); renderSidebar(); }
        }
      });
    });

    /* corpus badge */
    (function() {
      const n = corpusCount();
      const badge = document.getElementById('corpus-badge');
      if (n > 0) { badge.textContent = n + ' doc' + (n > 1 ? 's' : '') + ' entrenados'; badge.style.display = ''; }
    })();

    /* init */
    renderSidebar();
    renderMessages(null);
    renderAttachments();
  </script>

</Layout>
