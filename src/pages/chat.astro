          <button class="switch" data-setting="concise" aria-pressed="false"></button>
        </div>
        <div class="toggle">
          <div class="label-stack">
            <span class="t">Recordar último chat al abrir</span>
            <span class="d">Reabre la última conversación al volver a Chat.</span>
          </div>
          <button class="switch on" data-setting="resumeLast" aria-pressed="true"></button>
        </div>
        <div style="margin-top:22px; padding-top:16px; border-top:1px solid var(--rule); display:flex; gap:10px; flex-wrap:wrap;">
          <button class="btn btn-ghost" id="export-chats">Exportar mis chats (JSON)</button>
          <button class="btn btn-ghost" id="clear-chats" style="color:var(--danger);">Borrar todos los chats</button>
        </div>
      </div>
      <footer>
        <button class="btn btn-ghost" data-close="modal-settings">Cerrar</button>
        <button class="btn btn-primary" id="settings-save">Guardar preferencias</button>
      </footer>
    </div>
  </div>

  <div class="ctx-menu" id="ctx-menu" style="display:none;"></div>

  <script is:inline define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY }}>
    /* ─── Groq streaming wrapper ─── */
    window.claude = {
      async stream({ system, messages, onChunk, onDone, onError }) {
        let res;
        try {
          res = await fetch('/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ system, messages }),
          });
        } catch (err) { onError(err); return; }

        if (!res.ok) {
          try { const d = await res.json(); onError(new Error(d.error || 'Error al conectar con la IA')); }
          catch { onError(new Error('Error al conectar con la IA')); }
          return;
        }

        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '';
        let fullText = '';

        try {
          while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            buffer += decoder.decode(value, { stream: true });
            const lines = buffer.split('\n');
            buffer = lines.pop();
            for (const line of lines) {
              if (!line.startsWith('data: ')) continue;
              const data = line.slice(6).trim();
              if (data === '[DONE]') continue;
              try {
                const parsed = JSON.parse(data);
                const chunk = parsed.choices?.[0]?.delta?.content;
                if (chunk) { fullText += chunk; onChunk(fullText); }
              } catch {}
            }
          }
        } catch (err) { onError(err); return; }

        onDone(fullText || 'No se obtuvo respuesta.');
      }
    };

    /* ═══════════════════════════════════════════════════════════
       STATE
       ═══════════════════════════════════════════════════════════ */
    const STORAGE_KEY = 'mediq.chats.v1';
    const PROFILE_KEY = 'mediq.profile.v1';
    const SETTINGS_KEY = 'mediq.settings.v1';

    let chats = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
    let activeId = null;
    let specialty = 'General';
    let sending = false;
    let searchQuery = '';

    chats.forEach(c => { if (typeof c.pinned !== 'boolean') c.pinned = false; });

    let profile = JSON.parse(localStorage.getItem(PROFILE_KEY) || '{}');
    let settings = Object.assign({
      defaultSpecialty: 'General',
      disclaimer: true, cite: true, concise: false, resumeLast: true
    }, JSON.parse(localStorage.getItem(SETTINGS_KEY) || '{}'));

    if (settings.defaultSpecialty) specialty = settings.defaultSpecialty;

    // Reutiliza el cliente singleton de Layout.astro para evitar refresh-token
    // races entre multiples clientes en ViewTransitions (que cierran la sesion).
    if (!window.__mediqSb) {
      console.error('[MediQ] chat.astro: singleton __mediqSb NO existe — fallback disparado (bug)');
      window.__mediqSb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
    } else {
      console.log('[MediQ] chat.astro: usa singleton existente');
    }
    const sb = window.__mediqSb;
    let sbUser = null;

    const accountBtn  = document.getElementById('account-btn');
    const accountLabel = document.getElementById('account-label');
    const loginLink   = document.getElementById('login-link');
    const avaNav      = document.getElementById('ava-nav');
    // whoLabel, avaMini y logoutBtn del footer del sidebar se eliminaron —
    // eran duplicado del chip account-btn (arriba dcha) que ya gestiona
    // nombre + avatar + menú con "Salir".

    function displayName() {
      if (profile.name) return profile.name;
      if (sbUser?.user_metadata?.name) return sbUser.user_metadata.name;
      if (sbUser?.email) return sbUser.email.split('@')[0];
      return 'Invitado';
    }
    function avaInitial() { return displayName()[0].toUpperCase(); }

    function updateWelcomeGreeting() {
      const el = document.getElementById('welcome-greeting');
      if (!el) return;
      const h = new Date().getHours();
      const saludo = h < 12 ? 'Buenos días' : h < 20 ? 'Buenas tardes' : 'Buenas noches';
      const name = displayName().split(' ')[0];
      el.innerHTML = `${escapeHtml(saludo)}, <em>${escapeHtml(name)}</em>`;
    }

    let paywallActive = false;

    const ADMIN_EMAILS = ['lucasjuarezparada@gmail.com'];

    async function checkSubscription(userId) {
      if (sbUser?.email && ADMIN_EMAILS.includes(sbUser.email)) return;
      try {
        const { data } = await sb
          .from('subscriptions')
          .select('status')
          .eq('user_id', userId)
          .in('status', ['active', 'trialing'])
          .maybeSingle();
        if (!data) applyPaywall(userId);
      } catch (err) {
        console.warn('[paywall] check failed, granting access:', err);
      }
    }

    async function applyPaywall(userId) {
      paywallActive = true;
      // Determinar mensaje según si alguna vez tuvo suscripción
      try {
        const { data } = await sb
          .from('subscriptions')
          .select('status')
          .eq('user_id', userId)
          .maybeSingle();
        if (!data) {
          document.getElementById('paywall-title').textContent = 'Activa tu prueba gratuita de 14 días';
        } else {
          document.getElementById('paywall-title').textContent = 'Tu suscripción ya no está activa';
        }
      } catch (_) {}
      document.getElementById('composer-wrap').hidden = true;
      document.getElementById('paywall-bar').hidden = false;
      updateSendState();
    }

    function initSessionUI(user) {
      sbUser = user;
      if (!user) return;
      accountBtn.style.display = '';
      loginLink.style.display = 'none';
      avaNav.textContent = avaInitial();
      accountLabel.textContent = displayName().split(' ')[0];
      // Chip de usuario en la sidebar integrada
      const sbAva = document.getElementById('sb-user-ava');
      const sbName = document.getElementById('sb-user-name');
      if (sbAva) sbAva.textContent = avaInitial();
      if (sbName) sbName.textContent = displayName().split(' ')[0];
      updateWelcomeGreeting();
      loadChatsFromSupabase();
      setTimeout(maybeStartOnboarding, 900);
      setTimeout(initOnboardingBanner, 400);
      loadPendingPrompt();
      readCasoParams();
      accountBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        openUserMenu(accountBtn);
      });
    }

    /* Guard contra ViewTransitions: este <script is:inline> se re-ejecuta en cada
       navegación de Astro, incluso al hacer click en el enlace de la propia página
       "Chat". En esa re-ejecución se crea un cliente Supabase fresco que puede
       devolver session=null durante unos ms hasta rehidratar de localStorage,
       disparando un redirect espurio a /login que el usuario percibe como logout.

       Solución: el redirect a /login solo debe correr en la PRIMERA carga real de
       la página. En ejecuciones posteriores, si getSession devuelve null lo
       ignoramos (el authState real ya lo verificó Layout.astro y su listener
       onAuthStateChange nos avisará si de verdad la sesión expira). */
    sb.auth.getSession().then(({ data: { session } }) => {
      if (!session) {
        if (!window.__mediqChatSessionChecked) location.href = '/login';
        return;
      }
      window.__mediqChatSessionChecked = true;
      initSessionUI(session.user);
    });

    /* ═══════════════════════════════════════════════════════════
       PROMPT
       ═══════════════════════════════════════════════════════════ */
    const TOPIC_SHIFT_RE = /\b(cambiando de tema|cambio de tema|otra cosa|por cierto|nueva pregunta|pregunta distinta|deja eso|olvida lo anterior|nuevo caso)\b/i;
    const HISTORY_THRESHOLD = 20;

    function systemPrompt(chat) {
      const corpus = JSON.parse(localStorage.getItem('mediq.corpus.v1') || '[]');
      const catMeta = {
        guideline: { label: 'GUÍA CLÍNICA / PROTOCOLO', instruction: 'Trátalo como protocolo oficial. Sigue sus recomendaciones con prioridad sobre tu conocimiento general. Cita el grado de recomendación si aparece en el texto.' },
        paper:     { label: 'ARTÍCULO CIENTÍFICO / PAPER', instruction: 'Úsalo como evidencia científica. Evalúa su relevancia para la consulta y cita los hallazgos clave con el nombre del documento.' },
        case:      { label: 'CASO CLÍNICO DE REFERENCIA', instruction: 'Úsalo como caso análogo para razonamiento comparativo. Si el caso actual se parece, señala similitudes y diferencias relevantes.' },
        reference: { label: 'MATERIAL DE REFERENCIA', instruction: 'Úsalo como fuente de consulta general. Extrae la información pertinente para la pregunta actual.' },
      };

      let corpusSection = '';
      if (corpus.length > 0) {
        const docs = corpus.map(d => {
          const meta = catMeta[d.cat] || { label: d.cat.toUpperCase(), instruction: 'Úsalo como referencia cuando sea relevante.' };
          return `===== ${meta.label}: ${d.name} =====\nINSTRUCCIÓN DE USO: ${meta.instruction}\n\n${d.snippet}\n===== FIN =====`;
        }).join('\n\n');
        corpusSection = `\n\nBASE DE CONOCIMIENTO PERSONALIZADA (${corpus.length} documento${corpus.length > 1 ? 's' : ''} subidos por el equipo):\nEstos documentos son tu referencia prioritaria. Cuando sean relevantes para la consulta, úsalos antes que tu conocimiento general y cita el nombre del documento. Cada documento incluye una instrucción específica de cómo usarlo.\n\n${docs}\n\n---`;
      }

      const msgs = chat?.messages?.filter(m => !m.pending) || [];
      const hasTopic = msgs.length >= 2 && chat?.title;
      const topicLine = hasTopic ? `\nTEMA ACTUAL DE LA CONVERSACIÓN: "${chat.title}"\n` : '';

      const summaryLine = chat?.historySummary
        ? `\nRESUMEN DE INTERCAMBIOS ANTERIORES (contexto comprimido):\n${chat.historySummary}\n`
        : '';

      // ── Preferencias que modifican el prompt en tiempo real ──
      // Se leen del objeto `settings` (localStorage mediq.settings.v1).
      // Ver modal Configuración en el header del archivo.
      const wantCite       = settings.cite       !== false;  // default true
      const wantDisclaimer = settings.disclaimer !== false;  // default true
      const wantConcise    = settings.concise    === true;   // default false

      // Bloques condicionales del prompt.
      const structureBlock = wantConcise
        ? '- Prioriza BREVEDAD: 3-5 líneas por respuesta cuando el caso lo permita. NO uses estructura con encabezados ni listas largas salvo que el usuario pida detalle. Da la información esencial en un párrafo directo.'
        : `- Usa lenguaje claro, estructurado con encabezados (##) y listas cuando ayude a la legibilidad.
- Cuando se trate de un caso clínico, organiza tu respuesta así:
  ## Resumen del caso
  ## Diagnóstico diferencial (ordenado por probabilidad)
  ## Acciones prioritarias
  ## Banderas rojas a vigilar`;

      const citeBlock = wantCite
        ? '- Cita evidencia (guías ESC, AHA, NICE, NEJM, UpToDate) cuando sea relevante. Indica el grado/clase de recomendación si la conoces.'
        : '- No cites guías ni referencias externas salvo que el usuario pregunte específicamente por ellas.';

      const disclaimerBlock = wantDisclaimer
        ? '- AÑADE SIEMPRE al final una nota: "_Esta respuesta es una herramienta de apoyo. La decisión clínica final corresponde al profesional sanitario responsable._"'
        : '- NO añadas nota de disclaimer al final. El usuario ya sabe que esto es una herramienta de apoyo.';

      return `Eres MediQ, un asistente clínico con IA diseñado para apoyar a médicos y estudiantes de medicina hispanohablantes. Especialidad activa de la sesión: ${specialty}.${topicLine}${summaryLine}${corpusSection}

INSTRUCCIONES GENERALES:
- Responde SIEMPRE en español, en lenguaje natural y profesional médico.
${structureBlock}
${citeBlock}
- Si la consulta es de farmacología, incluye dosis estándar y ajuste por función renal/hepática y embarazo cuando aplique.
- Si la pregunta es educativa (modo estudiante), explica paso a paso con razonamiento fisiopatológico.
${disclaimerBlock}
- Si te preguntan algo no clínico, redirige amablemente al uso clínico.
- Cuando el usuario adjunte documentos PDF (verás bloques delimitados por "===== DOCUMENTO ADJUNTO ====="), léelos cuidadosamente, identifica si son historias clínicas, analíticas, informes, papers, guías o protocolos, y razona sobre su contenido. Cita textualmente fragmentos relevantes entre comillas cuando aporten valor. Indica si falta información para una conclusión sólida.
- No inventes referencias. Si no sabes algo, dilo.

CONTINUIDAD Y COHERENCIA CONVERSACIONAL (CRÍTICO):
- El último mensaje del usuario debe interpretarse SIEMPRE en el contexto del tema actual de la conversación, no como una pregunta aislada.
- Si el usuario menciona un dato nuevo (síntoma, alergia, medicamento, condición, preferencia), trátalo como INFORMACIÓN ADICIONAL sobre el tema en curso e incorpóralo al razonamiento inmediatamente. Ejemplo: si se habla de vértigos y el usuario dice "tengo alergia a la aspirina", NO expliques qué es la aspirina — ajusta las opciones terapéuticas del caso actual excluyendo la aspirina.
- NUNCA definas términos médicos conocidos (fármacos, enfermedades, procedimientos) a menos que el usuario pida explícitamente "¿qué es X?" o "explícame X".
- NUNCA derives hacia tangentes (etimología, historia del fármaco, datos epidemiológicos generales) salvo petición explícita.
- Si el historial muestra un caso clínico en desarrollo, cada mensaje nuevo es una actualización de ese caso, no un caso nuevo.`;
    }

    async function summarizeHistory(chat) {
      const msgs = chat.messages.filter(m => !m.pending);
      // Resumir solo los mensajes antiguos (todos menos los últimos 8)
      const toSummarize = msgs.slice(0, -8);
      if (toSummarize.length < 4) return;

      const summaryMsgs = toSummarize.map(m => ({
        role: m.role === 'ai' ? 'assistant' : 'user',
        content: m.text,
      }));
      summaryMsgs.push({
        role: 'user',
        content: 'Resume en máximo 120 palabras los puntos clave de esta conversación: datos del paciente, síntomas relevantes, alergias, fármacos mencionados, diagnósticos discutidos y decisiones tomadas. Solo los hechos, sin formato, sin introducción.',
      });

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            system: `Eres un asistente médico. Tu única tarea es resumir conversaciones clínicas de forma concisa y fáctica.`,
            messages: summaryMsgs,
          }),
        });
        if (!res.ok) return;

        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        let summary = '';
        while (true) {
          const { done, value } = await reader.read();
          if (done) break;
          const chunk = decoder.decode(value, { stream: true });
          for (const line of chunk.split('\n')) {
            if (!line.startsWith('data: ') || line === 'data: [DONE]') continue;
            try {
              const delta = JSON.parse(line.slice(6))?.choices?.[0]?.delta?.content;
              if (delta) summary += delta;
            } catch {}
          }
        }
        if (summary.trim()) {
          chat.historySummary = summary.trim();
          saveChats(chat);
        }
      } catch (err) {
        console.warn('[summarize] error (non-fatal):', err);
      }
    }

    function corpusCount() {
      return JSON.parse(localStorage.getItem('mediq.corpus.v1') || '[]').length;
    }

    /* ═══════════════════════════════════════════════════════════
       RENDERING
       ═══════════════════════════════════════════════════════════ */
    const sbList    = document.getElementById('sb-list');
    const msgsInner = document.getElementById('msgs-inner');
    const welcomeEl = document.getElementById('welcome');
    const messagesEl = document.getElementById('messages');
    const titleEl   = document.getElementById('chat-title');

    function saveChats(modifiedChat) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(chats));
      if (modifiedChat) upsertChatToSupabase(modifiedChat);
    }

    async function upsertChatToSupabase(chat) {
      if (!sbUser) return;
      try {
        await sb.from('chats').upsert({
          id: chat.id,
          user_id: sbUser.id,
          title: chat.title || 'Nueva consulta',
          specialty: chat.specialty || 'General',
          messages: chat.messages,
          pinned: !!chat.pinned,
          created_at: new Date(chat.createdAt || Date.now()).toISOString(),
          updated_at: new Date(chat.updatedAt || Date.now()).toISOString(),
        });
      } catch (err) { console.error('[chats] upsert error:', err); }
    }

    async function deleteChatFromSupabase(id) {
      if (!sbUser) return;
      try {
        await sb.from('chats').delete().eq('id', id).eq('user_id', sbUser.id);
      } catch (err) { console.error('[chats] delete error:', err); }
    }

    async function loadChatsFromSupabase() {
      if (!sbUser) return;
      try {
        const { data, error } = await sb.from('chats')
          .select('*').eq('user_id', sbUser.id)
          .order('updated_at', { ascending: false });
        if (error) { console.error('[chats] load error:', error); return; }
        if (!data || data.length === 0) return;
        chats = data.map(row => ({
          id: row.id,
          title: row.title,
          specialty: row.specialty,
          messages: row.messages || [],
          pinned: row.pinned || false,
          createdAt: new Date(row.created_at).getTime(),
          updatedAt: new Date(row.updated_at).getTime(),
        }));
        localStorage.setItem(STORAGE_KEY, JSON.stringify(chats));
        renderSidebar();
        if (settings.resumeLast && chats.length > 0 && !activeId) openChat(chats[0].id);
      } catch (err) { console.error('[chats] load error:', err); }
    }

    function renderSidebar() {
      sbList.innerHTML = '';
      const sectionEl = document.getElementById('sb-section');
      const infoEl    = document.getElementById('sb-search-info');

      if (chats.length === 0) {
        sectionEl.style.display = '';
        sectionEl.textContent = 'Conversaciones recientes';
        infoEl.style.display = 'none';
        sbList.innerHTML = '<div style="padding:12px 14px; font-size:12.5px; color:var(--ink-mute); line-height:1.5;">Aún no hay conversaciones. Inicia una nueva consulta arriba.</div>';
        return;
      }

      const q = searchQuery.trim().toLowerCase();
      let list = chats.slice();

      if (q) {
        list = list.map(c => {
          const titleMatch = (c.title || '').toLowerCase().includes(q);
          let snippet = null;
          if (!titleMatch) {
            for (const m of (c.messages || [])) {
              const idx = (m.text || '').toLowerCase().indexOf(q);
              if (idx >= 0) {
                const start = Math.max(0, idx - 30);
                const end = Math.min(m.text.length, idx + q.length + 60);
                snippet = (start > 0 ? '…' : '') + m.text.slice(start, end) + (end < m.text.length ? '…' : '');
                break;
              }
            }
          }
          return (titleMatch || snippet) ? { c, snippet } : null;
        }).filter(Boolean);

        sectionEl.style.display = 'none';
        infoEl.style.display = '';
        infoEl.textContent = list.length
          ? `${list.length} resultado${list.length === 1 ? '' : 's'} para "${q}"`
          : `Sin resultados para "${q}"`;

        if (list.length === 0) {
          sbList.innerHTML = '<div style="padding:12px 14px; font-size:12.5px; color:var(--ink-mute); line-height:1.5;">Prueba con otras palabras.</div>';
          return;
        }
        list.forEach(({ c, snippet }) => sbList.appendChild(buildChatRow(c, snippet, q)));
        return;
      }

      const pinned = list.filter(c => c.pinned).sort((a, b) => b.updatedAt - a.updatedAt);
      const recent = list.filter(c => !c.pinned).sort((a, b) => b.updatedAt - a.updatedAt);
      infoEl.style.display = 'none';

      if (pinned.length) {
        const pinHead = document.createElement('div');
        pinHead.className = 'sb-section';
        pinHead.style.padding = '0 10px 6px';
        pinHead.textContent = 'Fijadas';
        sbList.appendChild(pinHead);
        pinned.forEach(c => sbList.appendChild(buildChatRow(c)));
        const recHead = document.createElement('div');
        recHead.className = 'sb-section';
        recHead.style.padding = '14px 10px 6px';
        recHead.textContent = 'Recientes';
        sbList.appendChild(recHead);
        sectionEl.style.display = 'none';
      } else {
        sectionEl.style.display = '';
        sectionEl.textContent = 'Conversaciones recientes';
      }
      recent.forEach(c => sbList.appendChild(buildChatRow(c)));
    }

    function buildChatRow(c, snippet, query) {
      const row = document.createElement('div');
      row.className = 'sb-item' + (c.id === activeId ? ' active' : '');
      row.dataset.id = c.id;

      const date = new Date(c.updatedAt);
      const today = new Date();
      const dStr = (date.toDateString() === today.toDateString())
        ? 'Hoy · ' + date.toLocaleTimeString('es', { hour: '2-digit', minute: '2-digit' })
        : date.toLocaleDateString('es', { day: '2-digit', month: 'short' });

      const pinIcon = c.pinned
        ? '<svg class="pin-ic" width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path d="M16 3l5 5-4 1-3 5-5-5 5-3 1-4z M2 22l7-7" stroke="currentColor" stroke-width="1.4" fill="currentColor" stroke-linejoin="round"/></svg>'
        : '';

      let snippetHtml = '';
      if (snippet && query) {
        const safe = escapeHtml(snippet);
        const re = new RegExp('(' + query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'ig');
        snippetHtml = `<div class="snippet">${safe.replace(re, '<mark>$1</mark>')}</div>`;
      }

      row.innerHTML = `
        <div class="info">
          <div class="title">${pinIcon}<span class="title-text">${escapeHtml(c.title || 'Conversación')}</span></div>
          <div class="meta">${dStr} · ${escapeHtml(c.specialty || 'General')}</div>
          ${snippetHtml}
        </div>
        <button class="more" aria-label="Acciones" data-id="${c.id}">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg>
        </button>`;

      row.addEventListener('click', (e) => {
        if (e.target.closest('.more')) return;
        if (row.querySelector('.rename-input')) return;
        openChat(c.id);
      });
      row.querySelector('.more').addEventListener('click', (e) => {
        e.stopPropagation();
        openChatMenu(e.currentTarget, c);
      });

      return row;
    }

    /* ═══════════════════════════════════════════════════════════
       CONTEXT MENUS
       ═══════════════════════════════════════════════════════════ */
    const ctxMenu = document.getElementById('ctx-menu');

    function placeMenu(anchor, align = 'right', preferUp = false) {
      ctxMenu.style.display = 'flex';
      requestAnimationFrame(() => {
        const r  = anchor.getBoundingClientRect();
        const mw = ctxMenu.offsetWidth;
        const mh = ctxMenu.offsetHeight;
        let left = align === 'right' ? r.right - mw : r.left;
        let top  = preferUp ? r.top - mh - 6 : r.bottom + 6;
        if (top + mh > window.innerHeight - 10) top = r.top - mh - 6;
        if (top < 10) top = r.bottom + 6;
        if (left < 10) left = 10;
        if (left + mw > window.innerWidth - 10) left = window.innerWidth - mw - 10;
        ctxMenu.style.left = left + 'px';
        ctxMenu.style.top  = top  + 'px';
      });
    }

