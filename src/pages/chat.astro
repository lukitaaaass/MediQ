    function loadPendingPrompt() {
      try {
        const pending = localStorage.getItem('mediq.pendingPrompt');
        if (!pending) return;
        localStorage.removeItem('mediq.pendingPrompt');
        const ta = document.getElementById('input');
        if (!ta) return;
        ta.value = pending;
        ta.dispatchEvent(new Event('input'));
        ta.focus();
      } catch (_) {}
    }

    /* Lee ?caso=slug[&nivel=xxx][&rama=idNodo] de la URL. Guarda el contexto
       en una variable global para que el submit del composer pueda disparar
       el evento 'caso_chat_iniciado' cuando el usuario envie su primer mensaje.
       Limpia los query params de la URL para que no se re-disparen en refresh.

       `rama` es el ID del nodo terminal del algoritmo clinico si el usuario
       llego al chat desde <AlgoritmoClinico>. Se incluye como prop en el
       evento y queda disponible en window.__mediqCasoContext.rama por si
       se quiere usar en el futuro para variar el system prompt. */
    function readCasoParams() {
      try {
        const params = new URLSearchParams(location.search);
        const caso = params.get('caso');
        if (!caso) return;
        window.__mediqCasoContext = {
          slug: caso,
          nivel: params.get('nivel') || null,
          rama: params.get('rama') || null,
          tracked: false,
        };
        // Limpia los query params manteniendo el resto de la URL
        params.delete('caso');
        params.delete('nivel');
        params.delete('rama');
        const qs = params.toString();
        const cleanUrl = location.pathname + (qs ? '?' + qs : '') + location.hash;
        history.replaceState({}, '', cleanUrl);
      } catch (_) {}
    }

    function showToast(msg, ms = 2600) {
      let t = document.getElementById('mediq-toast');
      if (!t) { t = document.createElement('div'); t.id = 'mediq-toast'; t.className = 'toast'; document.body.appendChild(t); }
      t.textContent = msg; t.classList.add('show');
      clearTimeout(t._timer);
      t._timer = setTimeout(() => t.classList.remove('show'), ms);
    }

    async function shareChat(chat) {
      if (!sbUser) return;
      const shareId = 'shr_' + Math.random().toString(36).slice(2, 10);
      const { error } = await sb.from('shared_chats').insert({
        id: shareId,
        title: chat.title,
        specialty: chat.specialty || 'General',
        messages: chat.messages.filter(m => !m.pending),
        owner_id: sbUser.id,
      });
      if (error) { console.error('[share] error:', error); showToast('Error al compartir. Inténtalo de nuevo.'); return; }
      const url = `${location.origin}/share?id=${shareId}`;
      navigator.clipboard.writeText(url)
        .then(() => showToast('¡Enlace copiado al portapapeles!'))
        .catch(() => prompt('Copia este enlace:', url));
    }

    function exportChatAsText(chat) {
      const date = new Date(chat.updatedAt).toLocaleDateString('es', { day: '2-digit', month: 'long', year: 'numeric' });
      let txt = `MediQ — ${chat.title}\nEspecialidad: ${chat.specialty || 'General'}\nFecha: ${date}\n${'─'.repeat(52)}\n\n`;
      for (const m of chat.messages) {
        if (m.pending) continue;
        const time = new Date(m.at).toLocaleTimeString('es', { hour: '2-digit', minute: '2-digit' });
        txt += `${m.role === 'ai' ? 'MediQ' : 'Tú'} (${time}):\n${m.text}\n\n`;
      }
      txt += `${'─'.repeat(52)}\nExportado desde MediQ · Herramienta de apoyo clínico.`;
      const blob = new Blob([txt], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `mediq-${chat.title.slice(0, 40).replace(/[^\w\s-]/g, '').trim().replace(/\s+/g, '-')}-${new Date().toISOString().slice(0, 10)}.txt`;
      a.click(); URL.revokeObjectURL(url);
    }

    function exportChatAsPdf(chat) {
      const date = new Date(chat.updatedAt).toLocaleDateString('es', { day: '2-digit', month: 'long', year: 'numeric' });
      const msgsHtml = chat.messages.filter(m => !m.pending).map(m => {
        const time = new Date(m.at).toLocaleTimeString('es', { hour: '2-digit', minute: '2-digit' });
        const content = m.role === 'ai' ? md(m.text) : escapeHtml(m.text).replace(/\n/g, '<br>');
        return `<div class="msg ${m.role}"><div class="meta">${m.role === 'ai' ? 'MediQ' : 'Tú'} · ${time}</div><div class="content">${content}</div></div>`;
      }).join('');
      const html = `<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"><title>MediQ — ${escapeHtml(chat.title)}</title>
<style>body{font-family:-apple-system,sans-serif;font-size:13px;line-height:1.6;color:#1a1a1a;max-width:720px;margin:0 auto;padding:36px}
.hdr{border-bottom:2px solid #000;padding-bottom:14px;margin-bottom:24px}.hdr h1{font-size:19px;margin:0 0 4px;font-weight:600}
.hdr .sub{font-size:11px;color:#666;text-transform:uppercase;letter-spacing:.05em}
.msg{margin-bottom:18px}.msg .meta{font-size:10.5px;color:#888;text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px;font-weight:600}
.msg.ai .content{background:#f4f4f4;border-radius:8px;padding:12px 16px}
.msg.user .content{padding-left:14px;border-left:3px solid #ccc;color:#444}
h3{font-size:13px;margin:10px 0 4px;font-weight:600}code{background:#e8e8e8;padding:1px 4px;border-radius:3px;font-size:12px}
pre{background:#e8e8e8;padding:10px;border-radius:6px;font-size:12px;overflow-x:auto}
ul,ol{padding-left:20px;margin:5px 0}
.foot{margin-top:32px;padding-top:12px;border-top:1px solid #ddd;font-size:10px;color:#aaa}
@media print{body{padding:16px}}</style></head><body>
<div class="hdr"><h1>${escapeHtml(chat.title)}</h1><div class="sub">Especialidad: ${escapeHtml(chat.specialty||'General')} · ${date}</div></div>
${msgsHtml}
<div class="foot">Exportado desde MediQ · Herramienta de apoyo clínico — las decisiones finales corresponden al profesional sanitario.</div>
</body></html>`;
      const win = window.open('', '_blank');
      if (!win) { alert('Activa las ventanas emergentes para exportar PDF.'); return; }
      win.document.write(html); win.document.close();
      win.focus(); setTimeout(() => win.print(), 400);
    }

