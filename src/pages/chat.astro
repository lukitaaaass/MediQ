    function togglePinChat(id) {
      const c = chats.find(x => x.id === id);
      if (!c) return;
      c.pinned = !c.pinned;
      saveChats(c); renderSidebar();
    }

    function startRename(id) {
      const c = chats.find(x => x.id === id);
      if (!c) return;
      const row = sbList.querySelector(`.sb-item[data-id="${id}"]`);
      if (!row) return;
      const tEl = row.querySelector('.title');
      const original = c.title || 'Conversación';
      tEl.innerHTML = `<input class="rename-input" type="text" value="${escapeHtml(original)}" />`;
      const inp = tEl.querySelector('.rename-input');
      inp.focus(); inp.select();
      const finish = (commit) => {
        const v = inp.value.trim();
        if (commit && v && v !== original) {
          c.title = v.slice(0, 80);
          saveChats(c);
          if (id === activeId) document.getElementById('chat-title').textContent = c.title;
        }
        renderSidebar();
      };
      inp.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') { e.preventDefault(); finish(true); }
        else if (e.key === 'Escape') { e.preventDefault(); finish(false); }
      });
      inp.addEventListener('blur', () => finish(true));
      inp.addEventListener('click', e => e.stopPropagation());
    }

    function deleteChat(id) {
      const c = chats.find(x => x.id === id);
      if (!c) return;
      chats = chats.filter(x => x.id !== id);
      if (activeId === id) { activeId = null; renderMessages(null); document.title = 'Chat — MediQ'; }
      saveChats(); renderSidebar();
      deleteChatFromSupabase(id);
    }

    function maybeStartOnboarding() {
      if (localStorage.getItem('mediq.onboarding.v1')) return;

      const STEPS = [
        { tag: 'Bienvenido', title: '¡Hola! Soy MediQ', body: 'Tu asistente clínico con IA. En cuatro pasos rápidos te enseñamos lo esencial.', target: null },
        { tag: 'Chats', title: 'Historial de consultas', body: 'En la barra lateral tienes todas tus conversaciones, sincronizadas entre dispositivos. Créalas, fíjalas, compártelas o expórtalas.', target: '.sidebar' },
        { tag: 'Especialidad', title: 'Adapta la respuesta', body: 'Cambia la especialidad activa para ajustar el enfoque de la IA: urgencias, cardiología, modo estudiante…', target: '#specialty-btn' },
        { tag: 'Empieza aquí', title: 'El compositor', body: 'Describe el caso en lenguaje natural o adjunta PDFs: historias clínicas, guías, artículos. La IA razonará sobre ellos.', target: '#composer' },
      ];

      let step = 0;
      let prevEl = null;

      const backdrop = document.createElement('div');
      backdrop.className = 'ob-backdrop';
      const card = document.createElement('div');
      card.className = 'ob-card';
      document.body.append(backdrop, card);

      function render() {
        const s = STEPS[step];
        if (prevEl) { prevEl.classList.remove('ob-pulse'); prevEl = null; }
        if (s.target) {
          const el = document.querySelector(s.target);
          if (el && window.getComputedStyle(el).display !== 'none') {
            el.classList.add('ob-pulse');
            prevEl = el;
          }
        }
        const dots = STEPS.map((_, i) => `<span class="ob-dot${i === step ? ' on' : ''}"></span>`).join('');
        const isLast = step === STEPS.length - 1;
        card.innerHTML = `
          <div class="ob-tag">${s.tag} · ${step + 1} / ${STEPS.length}</div>
          <h3>${s.title}</h3>
          <p>${s.body}</p>
          <div class="ob-footer">
            <div class="ob-dots">${dots}</div>
            <div style="display:flex;gap:8px;">
              <button class="btn btn-ghost" id="ob-skip" style="font-size:13px;padding:7px 14px;">Saltar</button>
              <button class="btn btn-primary" id="ob-next" style="font-size:13px;padding:7px 16px;">${isLast ? '¡Empezar! →' : 'Siguiente →'}</button>
            </div>
          </div>`;
        card.querySelector('#ob-next').addEventListener('click', () => isLast ? finish() : (step++, render()));
        card.querySelector('#ob-skip').addEventListener('click', finish);
      }

      function finish() {
        if (prevEl) prevEl.classList.remove('ob-pulse');
        backdrop.remove(); card.remove();
        localStorage.setItem('mediq.onboarding.v1', '1');
      }

      backdrop.addEventListener('click', finish);
      render();
    }

    function initOnboardingBanner() {
      const banner = document.getElementById('onboarding-banner');
      if (!banner) return;
      const dismissed = localStorage.getItem('mediq.banner.v1');
      const hasSpecialty = !!(profile.specialty || localStorage.getItem('mediq.specialty'));
      if (dismissed || hasSpecialty) { banner.style.display = 'none'; return; }
