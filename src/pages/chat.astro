    function hydrateProfileModal() {
      document.getElementById('profile-ava').textContent = avaInitial();
      document.getElementById('profile-email-display').textContent = sbUser?.email || '';
      document.getElementById('profile-name').value = profile.name || sbUser?.user_metadata?.name || '';
      document.getElementById('profile-role').value = profile.role || 'medico';
      document.getElementById('profile-specialty').value = profile.specialty || '';
      document.getElementById('profile-institution').value = profile.institution || '';
    }
    document.getElementById('profile-save').addEventListener('click', () => {
