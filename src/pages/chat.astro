---
import Layout from '../layouts/Layout.astro';

const SUPABASE_URL      = import.meta.env.PUBLIC_SUPABASE_URL;
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---

<Layout
  title="Chat — MediQ"
  navActive="/chat"
  bodyClass="chat-page"
  includePdfJs={true}
  noindex={true}
>

  <!-- Nav: user trigger (oculto hasta confirmar sesión) + fallback login link -->
  <Fragment slot="nav-actions">
    <a class="btn btn-ghost user-trigger" href="#" id="account-btn" onclick="event.preventDefault();" style="display:none;">
      <span class="ava-nav" id="ava-nav">M</span>
      <span id="account-label">Mi cuenta</span>
      <svg width="10" height="10" viewBox="0 0 12 12">
        <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" />
      </svg>
    </a>
    <a class="btn btn-ghost" href="/login" id="login-link">Mi cuenta</a>
    <script is:inline>
      (function () {
        if (localStorage.getItem('mediq.authHint') === 'in') {
          var btn  = document.getElementById('account-btn');
          var link = document.getElementById('login-link');
          var lbl  = document.getElementById('account-label');
          var ava  = document.getElementById('ava-nav');
          var name = localStorage.getItem('mediq.userName') || '';
          if (btn)  btn.style.display  = '';
          if (link) link.style.display = 'none';
          if (name) {
            if (lbl) lbl.textContent = name;
            if (ava) ava.textContent = name[0].toUpperCase();
          }
        }
      })();
    </script>
  </Fragment>

  <style is:global>
    /* Estilos de body/html solo activos en la página de chat */
    body.chat-page {
      height: 100dvh;
      display: grid;
      grid-template-rows: auto 1fr;
      overflow: hidden;
    }

    /* En chat-page la sidebar integra el nav del sitio + el historial. */
    /* Ocultamos el rail lateral global y quitamos su padding reservado. */
    body.chat-page #nav-rail { display: none !important; }
    @media (min-width: 721px) {
      body.chat-page { padding-left: 0 !important; }
    }

    /* ─── Layout ─── */
    .app {
      display: grid;
      grid-template-columns: 280px 1fr;
      height: calc(100vh - var(--topbar-h));
      overflow: hidden;
    }
    @media (max-width: 820px) {
      .app { grid-template-columns: 1fr; }
      .sidebar { display: none !important; }
    }

    /* ─── Sidebar ─── */
    .sidebar {
      background: var(--bg-2);
      border-right: 1px solid var(--rule);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    /* ─── Sidebar: brand + nav del sitio (arriba) ─── */
    .sb-brand {
      display: flex; align-items: center; gap: 10px;
      padding: 12px 18px 8px;
      color: var(--ink); text-decoration: none;
      font-family: var(--f-display); font-size: 18px;
      letter-spacing: -0.02em;
    }
    .sb-brand .brand-mark {
      width: 20px; height: 20px; flex-shrink: 0;
      background: var(--accent); border-radius: 5px;
    }
    .sb-nav {
      display: flex; flex-direction: column;
      padding: 2px 10px 4px;
      gap: 0;
    }
    .sb-nav-item {
      display: flex; align-items: center; gap: 10px;
      padding: 5px 10px;
      border-radius: 6px;
      color: var(--ink-soft);
      text-decoration: none;
      font-size: 13px;
      line-height: 1.2;
      transition: background .15s ease, color .15s ease;
    }
    .sb-nav-item svg { width: 15px; height: 15px; flex-shrink: 0; }
    .sb-nav-item:hover { background: color-mix(in oklab, var(--ink) 5%, transparent); color: var(--ink); }
    .sb-nav-item.active {
      background: var(--surface);
      color: var(--ink);
      box-shadow: inset 2px 0 0 var(--accent);
    }
    .sb-nav-sep {
      height: 1px;
      background: var(--rule);
      margin: 4px 18px;
    }

    /* Chip usuario al pie */
    .sb-user {
      display: flex; align-items: center; gap: 10px;
      padding: 12px 14px;
      margin: 0 8px 10px;
      border-radius: 10px;
      color: var(--ink);
      text-decoration: none;
      font-size: 13.5px;
      border: 1px solid transparent;
      transition: background .15s ease, border-color .15s ease;
    }
    .sb-user:hover {
      background: color-mix(in oklab, var(--ink) 5%, transparent);
      border-color: var(--rule-2);
    }
    .sb-user-ava {
      width: 28px; height: 28px; border-radius: 50%;
      background: var(--accent); color: var(--accent-ink);
      display: grid; place-items: center;
      font-size: 12px; font-weight: 600;
      flex-shrink: 0;
    }
    .sb-user-body {
      display: flex; flex-direction: column;
      min-width: 0;
    }
    .sb-user-name {
      font-weight: 500;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .sb-user-hint {
      font-size: 11px;
      color: var(--ink-mute);
    }

    .sb-head {
      padding: 8px 18px 10px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .new-chat {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 11px 14px;
      background: var(--ink);
      color: var(--bg);
      border-radius: 10px;
      font-size: 14px;
      font-weight: 500;
      transition: transform .2s ease;
    }
    .new-chat:hover { transform: translateY(-1px); }
    .sb-section {
      font-family: var(--f-mono);
      font-size: 10.5px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink-mute);
      padding: 14px 18px 8px;
    }
    .sb-list {
      flex: 1;
      overflow-y: auto;
      padding: 0 8px 12px;
      display: flex;
      flex-direction: column;
      gap: 3px;
    }
    .sb-item {
      padding: 11px 12px;
      border-radius: 8px;
      font-size: 13.5px;
      color: var(--ink-soft);
      cursor: pointer;
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: start;
      gap: 6px;
      text-align: left;
      transition: background .15s ease;
      position: relative;
      width: 100%;
      border: 0;
      background: transparent;
      font-family: inherit;
    }
    .sb-item:hover { background: color-mix(in oklab, var(--ink) 5%, transparent); }
    .sb-item.active { background: var(--surface); color: var(--ink); box-shadow: 0 1px 0 var(--rule-2); }
    .sb-item .meta { font-family: var(--f-mono); font-size: 10px; color: var(--ink-mute); letter-spacing: 0.04em; margin-top: 3px; }
    .sb-item .title { line-height: 1.35; display: flex; align-items: center; gap: 6px; overflow: hidden; }
    .sb-item .title-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1; min-width: 0; }
    .sb-item .pin-ic { color: var(--accent); flex-shrink: 0; }
    .sb-item .info { min-width: 0; overflow: hidden; }
    .sb-item .more {
      width: 24px; height: 24px;
      display: grid; place-items: center;
      border-radius: 6px;
      color: var(--ink-mute);
      opacity: 0;
      transition: opacity .15s ease;
      flex-shrink: 0;
      cursor: pointer;
    }
    .sb-item:hover .more, .sb-item.active .more { opacity: 1; }
    .sb-item .more:hover { background: var(--bg-2); color: var(--ink); }
    .sb-item .rename-input {
      width: 100%;
      background: var(--bg);
      border: 1px solid var(--accent);
      border-radius: 6px;
      padding: 4px 8px;
      font-size: 13.5px;
      color: var(--ink);
      font-family: inherit;
    }

    /* Search */
    .sb-search { position: relative; margin: 0; }
    .sb-search input {
      width: 100%;
      background: var(--surface);
      border: 1px solid var(--rule-2);
      border-radius: 8px;
      padding: 9px 12px 9px 34px;
      font-size: 13px;
      color: var(--ink);
      font-family: inherit;
    }
    .sb-search input::placeholder { color: var(--ink-mute); }
    .sb-search input:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px color-mix(in oklab, var(--accent) 15%, transparent);
    }
    .sb-search .ic-search { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); color: var(--ink-mute); pointer-events: none; }
    .sb-search .clear-x {
      position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
      width: 20px; height: 20px;
      display: none; place-items: center;
      border-radius: 50%;
      color: var(--ink-mute);
      background: var(--bg-2);
      cursor: pointer;
      border: 0;
    }
    .sb-search.has-value .clear-x { display: grid; }
    .sb-search .clear-x:hover { color: var(--ink); }
    .sb-search-info { font-family: var(--f-mono); font-size: 10.5px; color: var(--ink-mute); padding: 0 18px 8px; letter-spacing: 0.04em; }
    .sb-item .snippet {
      font-size: 11.5px; color: var(--ink-mute); line-height: 1.45; margin-top: 4px;
      overflow: hidden; text-overflow: ellipsis;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    }
    .sb-item .snippet mark { background: color-mix(in oklab, var(--accent) 30%, transparent); color: var(--ink); padding: 0 2px; border-radius: 2px; }

    /* Context menu */
    .ctx-menu {
      position: absolute;
      background: var(--surface);
      border: 1px solid var(--rule-2);
      border-radius: 10px;
      box-shadow: 0 12px 30px -8px rgba(0,0,0,.18);
      padding: 6px;
      min-width: 180px;
      z-index: 200;
      display: flex;
      flex-direction: column;
      font-family: var(--f-body);
    }
    .ctx-menu button { display: flex; align-items: center; gap: 10px; padding: 9px 10px; border-radius: 6px; font-size: 13.5px; color: var(--ink); text-align: left; background: transparent; border: 0; cursor: pointer; width: 100%; }
    .ctx-menu button:hover { background: var(--bg-2); }
    .ctx-menu button.danger { color: var(--danger); }
    .ctx-menu button.danger:hover { background: color-mix(in oklab, var(--danger) 10%, var(--bg-2)); }
    .ctx-menu .sep { height: 1px; background: var(--rule); margin: 4px 0; }
    .ctx-menu svg { flex-shrink: 0; opacity: .8; }
    .ctx-menu .ctx-head { padding: 10px 12px 8px; font-family: var(--f-mono); font-size: 10.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-mute); border-bottom: 1px solid var(--rule); margin-bottom: 4px; }
    .ctx-menu .ctx-head b { display: block; font-family: var(--f-body); font-size: 13px; color: var(--ink); margin-top: 2px; text-transform: none; letter-spacing: 0; font-weight: 500; }

    /* User trigger in nav */
    .user-trigger {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 6px 10px 6px 6px;
      border-radius: 999px;
      background: transparent;
      border: 1px solid transparent;
      cursor: pointer;
      font-family: inherit; font-size: 13.5px; color: var(--ink);
      transition: background .15s ease, border-color .15s ease;
    }
    .user-trigger:hover { background: var(--bg-2); border-color: var(--rule-2); }
    .user-trigger .ava-nav {
      width: 28px; height: 28px; border-radius: 50%;
      background: linear-gradient(135deg, oklch(75% 0.1 195), oklch(58% 0.13 25));
      display: grid; place-items: center;
      color: var(--bg); font-family: var(--f-display); font-size: 13px;
    }

    /* Modals */
    .modal-backdrop { position: fixed; inset: 0; background: oklch(0% 0 0 / 0.4); display: none; align-items: center; justify-content: center; z-index: 300; padding: 20px; }
    .modal-backdrop.open { display: flex; }
    .modal { background: var(--bg); border-radius: 16px; width: 100%; max-width: 460px; overflow: hidden; box-shadow: 0 20px 60px -20px rgba(0,0,0,.3); }
    .modal header { padding: 22px 24px 18px; border-bottom: 1px solid var(--rule); display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
    .modal h2 { font-family: var(--f-display); font-size: 22px; font-weight: 400; }
    .modal .sub { font-size: 13px; color: var(--ink-soft); margin-top: 4px; }
    .modal .x { width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; color: var(--ink-mute); border: 0; background: transparent; cursor: pointer; }
    .modal .x:hover { background: var(--bg-2); color: var(--ink); }
    .modal .body { padding: 20px 24px; }
    .modal .row-field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }
    .modal label { font-family: var(--f-mono); font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-mute); }
    .modal input, .modal select, .modal textarea { background: var(--surface); border: 1px solid var(--rule-2); border-radius: 8px; padding: 10px 12px; font-size: 14px; color: var(--ink); font-family: inherit; }
    .modal input:focus, .modal select:focus, .modal textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in oklab, var(--accent) 15%, transparent); }
    .modal footer { padding: 14px 24px 20px; display: flex; gap: 10px; justify-content: flex-end; border-top: 1px solid var(--rule); background: var(--bg-2); }
    .modal .ava-big { width: 64px; height: 64px; border-radius: 50%; background: linear-gradient(135deg, oklch(75% 0.1 195), oklch(58% 0.13 25)); display: grid; place-items: center; color: var(--bg); font-family: var(--f-display); font-size: 28px; margin-bottom: 14px; }
    .toggle { display: flex; align-items: center; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid var(--rule); }
    .toggle:last-child { border-bottom: 0; }
    .toggle .label-stack { display: flex; flex-direction: column; gap: 2px; max-width: 70%; }
    .toggle .label-stack .t { font-size: 14px; color: var(--ink); }
    .toggle .label-stack .d { font-size: 12px; color: var(--ink-mute); line-height: 1.4; }
    .toggle .switch { width: 36px; height: 20px; background: var(--rule-2); border-radius: 999px; position: relative; cursor: pointer; transition: background .2s ease; flex-shrink: 0; border: 0; }
    .toggle .switch::after { content: ''; position: absolute; top: 2px; left: 2px; width: 16px; height: 16px; background: var(--bg); border-radius: 50%; transition: transform .2s ease; }
    .toggle .switch.on { background: var(--accent); }
    .toggle .switch.on::after { transform: translateX(16px); }

    .sb-foot { border-top: 1px solid var(--rule); padding: 14px 18px; font-family: var(--f-mono); font-size: 11px; color: var(--ink-mute); display: flex; align-items: center; gap: 10px; justify-content: space-between; }
    .sb-foot .who { display: flex; align-items: center; gap: 8px; color: var(--ink-soft); }
    .ava-mini { width: 26px; height: 26px; border-radius: 50%; background: linear-gradient(135deg, oklch(75% 0.1 195), oklch(58% 0.13 25)); display: grid; place-items: center; color: var(--bg); font-family: var(--f-display); font-size: 12px; }
    .sb-foot button { color: var(--ink-mute); font-family: var(--f-mono); font-size: 11px; }
    .sb-foot button:hover { color: var(--ink); }

    /* ─── Chat pane ─── */
    .chat { display: grid; grid-template-rows: auto 1fr auto; overflow: hidden; background: var(--bg); }
    .chat-head { padding: 10px 24px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
    .chat-head h2 { font-family: var(--f-mono); font-size: 12px; font-weight: 400; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-mute); }
    .specialty { background: var(--bg-2); border: 1px solid var(--rule-2); border-radius: 999px; padding: 6px 10px 6px 12px; font-family: var(--f-mono); font-size: 11px; color: var(--ink-soft); display: inline-flex; align-items: center; gap: 6px; cursor: pointer; }
    .specialty:hover { background: var(--surface); }

    /* ─── Messages ─── */
    .messages { overflow-y: auto; padding: 32px 24px 24px; scroll-behavior: smooth; }
    .messages.welcome-mode { display: flex; flex-direction: column; }
    .msgs-inner { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 24px; }
    .messages.welcome-mode .msgs-inner { flex: 1; }
    .msg { display: grid; grid-template-columns: 36px 1fr; gap: 14px; align-items: start; }
    .msg .av { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; font-family: var(--f-display); font-size: 14px; font-weight: 500; flex-shrink: 0; }
    .msg.user .av { background: var(--bg-2); color: var(--ink); border: 1px solid var(--rule-2); }
    .msg.ai .av { background: var(--ink); color: var(--bg); position: relative; }
    .msg.ai .av::after { content: ""; position: absolute; inset: 6px; border-radius: 50%; background: var(--accent); }
    .msg .body { padding-top: 4px; }
    .msg .role-line { font-family: var(--f-mono); font-size: 10.5px; color: var(--ink-mute); letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 6px; display: flex; gap: 8px; align-items: center; }
    .copy-btn { margin-left: auto; padding: 3px 8px; border-radius: 6px; font-family: var(--f-mono); font-size: 10px; color: var(--ink-mute); border: 1px solid var(--rule-2); transition: all .15s; }
    .copy-btn:hover { background: var(--bg-2); color: var(--ink); }
    .copy-btn.copied { color: var(--ok); border-color: var(--ok); }
    .msg .content { font-size: 15.5px; line-height: 1.6; color: var(--ink); white-space: pre-wrap; word-wrap: break-word; }
    .msg.user .content { color: var(--ink); }
    .msg.ai .content { color: var(--ink-soft); }
    .msg.ai .content b, .msg.ai .content strong { color: var(--ink); font-weight: 600; }
    .msg.ai .content em { font-style: italic; }
    .msg.ai .content code { font-family: var(--f-mono); font-size: 13px; background: var(--bg-2); padding: 1px 5px; border-radius: 4px; }
    .msg.ai .content ul, .msg.ai .content ol { margin: 8px 0; padding-left: 22px; }
    .msg.ai .content li { margin: 4px 0; }
    .msg.ai .content h3 { font-size: 16px; margin: 12px 0 4px; font-weight: 600; font-family: var(--f-body); color: var(--ink); }

    /* typing dots */
    .typing { display: inline-flex; gap: 4px; align-items: center; padding: 4px 0; }
    .typing i { width: 6px; height: 6px; border-radius: 50%; background: var(--ink-mute); animation: blink 1.2s infinite; }
    .typing i:nth-child(2) { animation-delay: .15s; }
    .typing i:nth-child(3) { animation-delay: .3s; }
    @keyframes blink { 0%, 80%, 100% { opacity: .3; } 40% { opacity: 1; } }

    /* ─── Welcome state ─── */
    .welcome { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 24px 16px 36px; }
    .welcome-icon { width: 38px; height: 38px; margin: 0 auto 22px; color: var(--accent); opacity: .9; }
    .welcome-greeting { font-family: var(--f-display); font-size: clamp(26px, 3.5vw, 44px); font-weight: 400; letter-spacing: -0.025em; line-height: 1.1; margin-bottom: 10px; }
    .welcome-greeting em { font-style: italic; color: var(--accent); }
    .welcome-sub { font-size: 15px; color: var(--ink-mute); max-width: 42ch; line-height: 1.5; margin-bottom: 8px; }
    .welcome-disclaimer { font-family: var(--f-mono); font-size: 10.5px; color: var(--ink-mute); letter-spacing: 0.04em; margin-bottom: 28px; display: flex; align-items: center; gap: 6px; justify-content: center; }
    .suggestions { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; max-width: 680px; transition: opacity .35s ease; }
    .suggestions.fading { opacity: 0; }
    .suggestion { background: var(--surface); border: 1px solid var(--rule-2); border-radius: 999px; padding: 9px 16px; cursor: pointer; font-size: 13.5px; color: var(--ink-soft); transition: border-color .2s ease, background .2s ease, color .2s ease, transform .15s ease; max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .suggestion:hover { border-color: var(--ink-soft); background: color-mix(in oklab, var(--ink) 5%, transparent); color: var(--ink); transform: translateY(-1px); }

    /* ─── Paywall ─── */
    #paywall-bar { border-top: 1px solid var(--rule); padding: 16px 24px; background: color-mix(in oklab, var(--bg) 85%, transparent); backdrop-filter: blur(8px); }
    .paywall-card { max-width: 760px; margin: 0 auto; display: flex; align-items: center; gap: 16px; background: var(--surface); border: 1px solid color-mix(in oklab, var(--warn) 35%, transparent); border-radius: 14px; padding: 16px 18px; }
    .paywall-icon { width: 40px; height: 40px; flex-shrink: 0; border-radius: 10px; background: color-mix(in oklab, var(--warn) 12%, var(--bg)); display: grid; place-items: center; color: var(--warn); }
    .paywall-text { flex: 1; display: flex; flex-direction: column; gap: 3px; min-width: 0; }
    .paywall-text strong { font-size: 14px; color: var(--ink); }
    .paywall-text span { font-size: 13px; color: var(--ink-soft); }
    .paywall-cta { padding: 10px 18px !important; border-radius: 10px !important; flex-shrink: 0; white-space: nowrap; }
    @media (max-width: 600px) { .paywall-card { flex-wrap: wrap; } .paywall-cta { width: 100%; justify-content: center; } }

    /* ─── Composer ─── */
    .composer-wrap { border-top: 1px solid var(--rule); padding: 16px 24px 22px; background: color-mix(in oklab, var(--bg) 85%, transparent); backdrop-filter: blur(8px); }
    .composer { max-width: 760px; margin: 0 auto; background: var(--surface); border: 1px solid var(--rule-2); border-radius: 16px; padding: 6px 6px 6px 14px; display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 8px; transition: border-color .2s ease, box-shadow .2s ease; }
    .composer:focus-within { border-color: var(--ink-soft); box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 12%, transparent); }
    .composer textarea { width: 100%; border: 0; outline: 0; background: transparent; resize: none; font: inherit; font-size: 15px; line-height: 1.55; color: var(--ink); padding: 10px 0; max-height: 200px; min-height: 44px; }
    .composer textarea::placeholder { color: var(--ink-mute); }
    .attach-btn { width: 36px; height: 36px; border-radius: 50%; color: var(--ink-soft); display: grid; place-items: center; align-self: end; margin-bottom: 6px; transition: background .15s ease, color .15s ease; flex-shrink: 0; }
    .attach-btn:hover { background: var(--bg-2); color: var(--ink); }
    .attach-btn svg { width: 18px; height: 18px; }
    .attachments { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 6px; padding: 8px 4px 4px; }
    .attachments:empty { display: none; }
    .chip { display: inline-flex; align-items: center; gap: 8px; background: var(--bg-2); border: 1px solid var(--rule-2); border-radius: 8px; padding: 6px 8px 6px 10px; font-size: 12.5px; color: var(--ink); max-width: 280px; }
    .chip .ic-file { width: 14px; height: 14px; color: var(--accent); flex-shrink: 0; }
    .chip .name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .chip .meta { font-family: var(--f-mono); font-size: 10px; color: var(--ink-mute); letter-spacing: 0.04em; }
    .chip .x { width: 18px; height: 18px; border-radius: 50%; color: var(--ink-mute); display: grid; place-items: center; flex-shrink: 0; }
    .chip .x:hover { background: color-mix(in oklab, var(--ink) 10%, transparent); color: var(--ink); }
    .chip.processing { color: var(--ink-mute); }
    .chip.processing .name::after { content: " · extrayendo…"; color: var(--accent); }
    .chip.error { background: color-mix(in oklab, var(--danger) 10%, transparent); border-color: color-mix(in oklab, var(--danger) 25%, transparent); color: oklch(38% 0.16 25); }
    .msg-attach { display: inline-flex; align-items: center; gap: 8px; background: var(--bg-2); border: 1px solid var(--rule-2); border-radius: 8px; padding: 8px 12px; font-size: 13px; color: var(--ink); margin-bottom: 8px; margin-right: 6px; }
    .msg-attach .ic-file { width: 14px; height: 14px; color: var(--accent); }
    .msg-attach .meta { font-family: var(--f-mono); font-size: 10.5px; color: var(--ink-mute); letter-spacing: 0.04em; }

    /* drop overlay */
    .drop-overlay { position: fixed; inset: 0; background: color-mix(in oklab, var(--ink) 70%, transparent); display: none; place-items: center; z-index: 200; pointer-events: none; backdrop-filter: blur(6px); }
    .drop-overlay.on { display: grid; }
    .drop-overlay .card { background: var(--surface); border: 2px dashed var(--accent); border-radius: 16px; padding: 36px 48px; text-align: center; color: var(--ink); }
    .drop-overlay .card h3 { font-family: var(--f-display); font-size: 24px; margin-bottom: 6px; }
    .drop-overlay .card p { font-family: var(--f-mono); font-size: 12px; color: var(--ink-mute); letter-spacing: 0.06em; }
    .send { width: 40px; height: 40px; border-radius: 50%; background: var(--ink); color: var(--bg); display: grid; place-items: center; transition: transform .15s ease, opacity .15s ease; align-self: end; margin-bottom: 4px; }
    .send:hover:not(:disabled) { transform: scale(1.05); }
    .send:disabled { opacity: .35; cursor: not-allowed; }
    .send svg { width: 18px; height: 18px; }
    .composer-hint { max-width: 760px; margin: 8px auto 0; text-align: center; font-family: var(--f-mono); font-size: 10.5px; color: var(--ink-mute); letter-spacing: 0.04em; }
    .composer-hint kbd { background: var(--bg-2); border: 1px solid var(--rule-2); border-radius: 4px; padding: 1px 5px; font-family: var(--f-mono); font-size: 10px; color: var(--ink-soft); }
    .disclaimer { background: color-mix(in oklab, var(--warn) 10%, transparent); border: 1px solid color-mix(in oklab, var(--warn) 22%, transparent); border-radius: 10px; padding: 10px 14px; font-size: 12.5px; color: oklch(38% 0.16 40); line-height: 1.45; display: flex; gap: 10px; margin-bottom: 18px; }
    .disclaimer svg { flex-shrink: 0; margin-top: 2px; color: oklch(50% 0.18 40); }
    .menu { position: absolute; background: var(--surface); border: 1px solid var(--rule-2); border-radius: 10px; box-shadow: 0 12px 32px -16px #0000003d; padding: 6px; z-index: 100; display: none; min-width: 200px; }
    .menu.open { display: block; }
    .toast { position: fixed; bottom: 28px; left: 50%; transform: translateX(-50%); background: var(--ink); color: var(--bg); padding: 10px 22px; border-radius: 999px; font-size: 13.5px; z-index: 999; opacity: 0; transition: opacity .2s ease; pointer-events: none; white-space: nowrap; }
    .toast.show { opacity: 1; }
    /* ─── Onboarding ─── */
    .ob-backdrop { position: fixed; inset: 0; background: oklch(0% 0 0 / 0.55); z-index: 500; }
    .ob-card { position: fixed; z-index: 502; background: var(--surface); border: 1px solid var(--rule-2); border-radius: 16px; padding: 24px; width: min(320px, calc(100vw - 32px)); box-shadow: 0 24px 64px -20px rgba(0,0,0,.45); top: 50%; left: 50%; transform: translate(-50%, -50%); }
    .ob-tag { font-family: var(--f-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent-text); margin-bottom: 8px; }
    .ob-card h3 { font-family: var(--f-display); font-size: 20px; font-weight: 400; margin-bottom: 8px; letter-spacing: -0.02em; }
    .ob-card p { font-size: 14px; color: var(--ink-soft); line-height: 1.55; margin-bottom: 20px; }
    .ob-footer { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .ob-dots { display: flex; gap: 5px; align-items: center; }
    .ob-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--rule-2); transition: all .2s ease; flex-shrink: 0; }
    .ob-dot.on { background: var(--accent); width: 16px; border-radius: 3px; }
    .ob-pulse { outline: 2px solid var(--accent) !important; outline-offset: 4px; animation: ob-ring 1.4s ease infinite; position: relative; z-index: 501; }
    @keyframes ob-ring { 0%, 100% { outline-color: var(--accent); } 50% { outline-color: color-mix(in oklab, var(--accent) 25%, transparent); } }
    .menu button { display: flex; width: 100%; text-align: left; padding: 8px 12px; border-radius: 6px; font-size: 13.5px; color: var(--ink-soft); }
    .menu button:hover { background: var(--bg-2); color: var(--ink); }
    .menu button.on { color: var(--ink); font-weight: 500; }
    .menu button.on::after { content: "✓"; margin-left: auto; color: var(--accent); }
  </style>

