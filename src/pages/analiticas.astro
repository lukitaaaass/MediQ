---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Intérprete de analíticas — MediQ"
  description="Sube tu analítica en PDF, pégala o introduce valores manualmente. Recibes cada parámetro clasificado (normal / ligeramente alterado / alterado / muy alterado) con su rango de referencia y explicación."
  navActive="/analiticas"
  bodyClass="analiticas-page"
  includePdfJs={true}
>

  <style is:global>
    body.analiticas-page { background: var(--bg); }

    .an-wrap {
      max-width: 1080px;
      margin: 0 auto;
      padding: clamp(32px, 5vw, 64px) var(--pad) 120px;
    }

    /* ─── Hero ─── */
    .an-hero { text-align: center; margin-bottom: clamp(32px, 4vw, 48px); }
    .an-hero .eyebrow { justify-content: center; }
    .an-hero h1 {
      font-family: var(--f-display);
      font-size: clamp(36px, 4.6vw, 56px);
      line-height: 1.05;
      font-weight: 300;
      letter-spacing: -0.02em;
      margin: 16px 0 18px;
    }
    .an-hero h1 em { font-style: italic; color: var(--accent); }
    .an-hero .sub {
      max-width: 60ch;
      margin: 0 auto;
      font-size: clamp(15px, 1.15vw, 17px);
      color: var(--ink-soft);
      line-height: 1.55;
    }

    .an-disclaimer {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin-top: 20px;
      padding: 10px 16px;
      border-radius: 999px;
      background: color-mix(in oklab, var(--warn) 12%, transparent);
      border: 1px solid color-mix(in oklab, var(--warn) 25%, transparent);
      color: oklch(38% 0.16 40);
      font-size: 13px;
      line-height: 1.4;
      max-width: 620px;
      text-align: left;
    }
    .an-disclaimer svg { flex-shrink: 0; color: var(--warn); }

    /* ─── Upload zone (mismo look que /informes) ─── */
    .an-upload {
      background: var(--surface);
      border: 1px solid var(--rule-2);
      border-radius: 18px;
      padding: clamp(24px, 3vw, 36px);
      margin-bottom: 24px;
    }

    .an-tabs {
      display: inline-flex;
      gap: 4px;
      padding: 4px;
      background: var(--bg-2);
      border-radius: 999px;
      margin-bottom: 24px;
    }
    .an-tabs button {
      padding: 8px 20px;
      border-radius: 999px;
      font-family: var(--f-mono);
      font-size: 12px;
      letter-spacing: 0.04em;
      color: var(--ink-mute);
      transition: background .2s ease, color .2s ease;
      white-space: nowrap;
    }
    .an-tabs button:hover { color: var(--ink-soft); }
    .an-tabs button.on {
      background: var(--surface);
      color: var(--ink);
      box-shadow: 0 1px 3px rgba(0,0,0,.08);
    }
    .an-panel { display: none; }
    .an-panel.on { display: block; }

    .an-dropzone {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
      border: 2px dashed var(--rule-2);
      border-radius: 14px;
      padding: 48px 24px;
      text-align: center;
      cursor: pointer;
      transition: border-color .2s ease, background .2s ease;
      background: var(--bg);
      min-height: 200px;
    }
    .an-dropzone:hover, .an-dropzone.hover {
      border-color: var(--accent);
      background: color-mix(in oklab, var(--accent) 4%, var(--bg));
    }
    .an-dropzone svg { display: block; color: var(--ink-mute); }
    .an-dropzone p { margin: 0; font-size: 15px; color: var(--ink); max-width: 42ch; }
    .an-dropzone p.hint { font-size: 13px; color: var(--ink-mute); }
    .an-dropzone.has-file p { color: var(--accent-text); font-weight: 500; }

    .an-textarea {
      width: 100%;
      min-height: 200px;
      max-height: 400px;
      background: var(--bg);
      border: 1px solid var(--rule-2);
      border-radius: 12px;
      padding: 16px 18px;
      font: inherit;
      font-size: 14.5px;
      line-height: 1.55;
      color: var(--ink);
      outline: none;
      resize: vertical;
      font-family: var(--f-mono);
      transition: border-color .15s ease, box-shadow .15s ease;
    }
    .an-textarea:focus {
      border-color: var(--ink-soft);
      box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 12%, transparent);
    }

    /* Manual mode — grid dinámica de rows */
    .manual-hint {
      font-size: 13.5px;
      color: var(--ink-mute);
      margin-bottom: 12px;
    }
    .manual-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px; }
    .manual-row {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr auto;
      gap: 8px;
      align-items: center;
    }
    @media (max-width: 640px) {
      .manual-row { grid-template-columns: 1fr 1fr auto; }
      .manual-row .manual-name { grid-column: 1 / -1; }
    }
    .manual-row input {
      background: var(--bg);
      border: 1px solid var(--rule-2);
      border-radius: 10px;
      padding: 10px 12px;
      font: inherit;
      font-size: 14px;
      color: var(--ink);
      outline: none;
      transition: border-color .15s ease;
      min-width: 0;
    }
    .manual-row input:focus { border-color: var(--ink-soft); }
    .manual-row .del {
      width: 36px; height: 36px;
      border-radius: 8px;
      color: var(--ink-mute);
      display: grid; place-items: center;
      transition: background .15s, color .15s;
    }
    .manual-row .del:hover { background: color-mix(in oklab, var(--danger) 12%, transparent); color: var(--danger); }
    .manual-add {
      padding: 10px 16px;
      border-radius: 10px;
      border: 1px dashed var(--rule-2);
      color: var(--ink-soft);
      font-size: 13.5px;
      transition: border-color .15s, color .15s, background .15s;
    }
    .manual-add:hover { border-color: var(--accent); color: var(--accent-text); background: color-mix(in oklab, var(--accent) 4%, transparent); }

    .an-actions {
      margin-top: 20px;
      display: flex;
      gap: 12px;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
    }
    .an-actions .hint {
      font-family: var(--f-mono);
      font-size: 11px;
      color: var(--ink-mute);
      letter-spacing: 0.04em;
    }
    .an-analyze {
      padding: 14px 28px;
      border-radius: 12px;
      background: var(--ink);
      color: var(--bg);
      font-weight: 500;
      font-size: 15px;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      transition: transform .15s, opacity .15s;
    }
    .an-analyze:hover:not(:disabled) { transform: translateY(-1px); }
    .an-analyze:disabled { opacity: .5; cursor: not-allowed; transform: none; }

    /* Progress + error (mismo look que /informes) */
    .an-progress {
      background: var(--surface);
      border: 1px solid var(--rule-2);
      border-radius: 18px;
      padding: 32px;
      text-align: center;
    }
    .an-progress-label {
      font-family: var(--f-mono);
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-soft);
      margin-bottom: 16px;
    }
    .an-progress-bar {
      height: 6px;
      background: var(--bg-2);
      border-radius: 999px;
      overflow: hidden;
      max-width: 480px;
      margin: 0 auto;
    }
    .an-progress-fill {
      height: 100%;
      background: var(--accent);
      border-radius: 999px;
      width: 0%;
      transition: width .5s ease;
    }

    .an-alert {
      background: color-mix(in oklab, var(--danger) 10%, transparent);
      border: 1px solid color-mix(in oklab, var(--danger) 25%, transparent);
      border-radius: 12px;
      padding: 14px 18px;
      display: flex;
      gap: 12px;
      align-items: flex-start;
      color: oklch(38% 0.16 25);
    }
    .an-alert svg { flex-shrink: 0; margin-top: 2px; color: var(--danger); }
    .an-alert .msg { flex: 1; font-size: 14.5px; line-height: 1.5; }
    .an-alert button {
      padding: 8px 14px;
      border-radius: 8px;
      background: transparent;
      border: 1px solid color-mix(in oklab, var(--danger) 35%, transparent);
      color: oklch(38% 0.16 25);
      font-size: 13px;
      flex-shrink: 0;
    }

    /* ─── Resultado ─── */
    .an-overall {
      background: var(--surface);
      border: 1px solid var(--rule-2);
      border-radius: 18px;
      padding: 24px 28px;
      margin-bottom: 20px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .an-overall-bar {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      border-radius: 12px;
      border: 1px solid transparent;
      font-size: 14.5px;
      line-height: 1.4;
    }
    .an-overall-bar .sev-dot {
      width: 12px; height: 12px;
      border-radius: 50%;
      flex-shrink: 0;
      box-shadow: 0 0 0 4px color-mix(in oklab, currentColor 15%, transparent);
    }
    .an-overall-bar .sev-label {
      font-family: var(--f-mono);
      font-size: 10.5px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      font-weight: 600;
    }
    .an-overall-bar .sev-text { flex: 1; color: var(--ink); }
    .ov-normal     { background: color-mix(in oklab, var(--ok) 10%, var(--surface));      border-color: color-mix(in oklab, var(--ok) 30%, transparent);      color: oklch(35% 0.1 155); }
    .ov-attention  { background: color-mix(in oklab, oklch(78% 0.15 90) 14%, var(--surface));  border-color: color-mix(in oklab, oklch(78% 0.15 90) 40%, transparent);  color: oklch(45% 0.14 90); }
    .ov-abnormal   { background: color-mix(in oklab, var(--warn) 12%, var(--surface));    border-color: color-mix(in oklab, var(--warn) 35%, transparent);    color: oklch(38% 0.16 40); }
    .ov-concerning { background: color-mix(in oklab, var(--danger) 12%, var(--surface));  border-color: color-mix(in oklab, var(--danger) 40%, transparent);  color: oklch(38% 0.16 25); }

    @media (prefers-reduced-motion: no-preference) {
      .ov-concerning .sev-dot {
        animation: an-pulse 1.6s ease-in-out infinite;
      }
      @keyframes an-pulse {
        0%, 100% { box-shadow: 0 0 0 4px color-mix(in oklab, currentColor 15%, transparent); }
        50%      { box-shadow: 0 0 0 8px color-mix(in oklab, currentColor 5%, transparent); }
      }
    }

    .an-summary {
      font-size: 15px;
      line-height: 1.6;
      color: var(--ink);
      margin: 0;
      white-space: pre-wrap;
    }

    .params-title {
      font-family: var(--f-mono);
      font-size: 11px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-mute);
      margin: 0 0 12px 4px;
    }

    /* Lista de parámetros como cards desplegables */
    .params-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: 24px; }
    .param-card {
      background: var(--surface);
      border: 1px solid var(--rule-2);
      border-radius: 12px;
      overflow: hidden;
      transition: border-color .15s;
    }
    .param-card summary {
      list-style: none;
      cursor: pointer;
      padding: 14px 18px;
      display: grid;
      grid-template-columns: auto 1fr auto auto auto;
      gap: 14px;
      align-items: center;
    }
    .param-card summary::-webkit-details-marker { display: none; }
    @media (max-width: 640px) {
      .param-card summary { grid-template-columns: auto 1fr auto auto; gap: 10px; padding: 12px 14px; }
      .param-card .p-range { grid-column: 2 / 5; text-align: right; }
    }
    .param-status-dot {
      width: 14px; height: 14px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .p-name {
      font-size: 14.5px;
      font-weight: 500;
      color: var(--ink);
    }
    .p-value {
      font-family: var(--f-mono);
      font-size: 15px;
      font-weight: 600;
      white-space: nowrap;
      min-width: 105px;
      text-align: right;
    }
    .p-value .unit { font-weight: 400; color: var(--ink-mute); font-size: 12px; margin-left: 3px; }
    .p-range {
      font-family: var(--f-mono);
      font-size: 11px;
      color: var(--ink-mute);
      letter-spacing: 0.03em;
      white-space: nowrap;
      min-width: 140px;
      text-align: right;
      padding-left: 8px;
    }
    .p-caret {
      color: var(--ink-mute);
      display: grid;
      place-items: center;
      width: 20px;
      height: 20px;
      margin-left: 4px;
      transition: transform .2s ease, color .15s ease;
    }
    .p-caret svg { display: block; }
    .param-card summary:hover .p-caret { color: var(--ink-soft); }
    .param-card[open] .p-caret { transform: rotate(180deg); }

    /* Colores de status — cada uno claramente distinto del anterior en hue y luminosidad.
       Anillo blanco alrededor del punto para separar visualmente del fondo del card. */
    .param-status-dot {
      box-shadow:
        0 0 0 2px var(--surface),
        0 0 0 3px color-mix(in oklab, currentColor 25%, transparent);
    }
    .status-green  { --dot-c: oklch(62% 0.16 150); }
    .status-yellow { --dot-c: oklch(84% 0.19 95); }
    .status-orange { --dot-c: oklch(68% 0.20 45); }
    .status-red    { --dot-c: oklch(58% 0.24 22); }
    .status-green  .param-status-dot,
    .status-yellow .param-status-dot,
    .status-orange .param-status-dot,
    .status-red    .param-status-dot { background: var(--dot-c); color: var(--dot-c); }

    .status-green  .p-value { color: oklch(38% 0.14 150); }
    .status-yellow .p-value { color: oklch(46% 0.16 88); }
    .status-orange .p-value { color: oklch(48% 0.19 45); }
    .status-red    .p-value { color: oklch(45% 0.20 22); }

    .status-red.param-card    { border-color: color-mix(in oklab, oklch(58% 0.24 22) 35%, var(--rule-2)); }
    .status-orange.param-card { border-color: color-mix(in oklab, oklch(68% 0.20 45) 30%, var(--rule-2)); }

    /* Cuerpo desplegable */
    .p-body {
      padding: 4px 18px 18px 46px;
      border-top: 1px solid var(--rule);
      background: color-mix(in oklab, var(--bg-2) 60%, transparent);
    }
    @media (max-width: 640px) { .p-body { padding: 4px 14px 14px 14px; } }
    .p-body-section { padding: 12px 0; }
    .p-body-section:first-child { padding-top: 14px; }
    .p-body-section h4 {
      font-family: var(--f-mono);
      font-size: 10.5px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--ink-mute);
      margin: 0 0 6px;
      font-weight: 600;
    }
    .p-body-section p {
      font-size: 13.5px;
      line-height: 1.55;
      color: var(--ink-soft);
      margin: 0;
    }

    .an-recommendations {
      background: color-mix(in oklab, var(--accent) 5%, var(--surface));
      border: 1px solid color-mix(in oklab, var(--accent) 20%, transparent);
      border-radius: 14px;
      padding: 20px 24px;
      margin-bottom: 24px;
    }
    .an-recommendations h3 {
      font-family: var(--f-display);
      font-size: 17px;
      font-weight: 500;
      margin: 0 0 12px;
    }
    .an-recommendations ul { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 8px; }
    .an-recommendations li { font-size: 14px; color: var(--ink-soft); line-height: 1.55; }

    .an-disclaimer-bottom {
      margin-top: 20px;
      padding: 16px 20px;
      background: var(--bg-2);
      border-radius: 12px;
      font-size: 13px;
      color: var(--ink-mute);
      line-height: 1.55;
      text-align: center;
    }

    .an-result-actions {
      margin-top: 20px;
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
    }

    /* No analítica */
    .no-analitica {
      background: var(--surface);
      border: 1px solid var(--rule-2);
      border-radius: 18px;
      padding: 32px;
      text-align: center;
    }
    .no-analitica svg { color: var(--ink-mute); margin-bottom: 12px; }
    .no-analitica h3 { font-family: var(--f-display); font-size: 20px; font-weight: 400; margin: 0 0 8px; }
    .no-analitica p { font-size: 14.5px; color: var(--ink-soft); max-width: 50ch; margin: 0 auto 20px; line-height: 1.55; }

    @media (prefers-reduced-motion: no-preference) {
      @keyframes an-card-in {
        from { opacity: 0; transform: translateY(6px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      .an-overall, .params-title, .params-list, .an-recommendations, .no-analitica {
        animation: an-card-in .35s cubic-bezier(.2, .7, .2, 1) both;
      }
    }

    [hidden] { display: none !important; }
  </style>

  <main class="an-wrap">

    <!-- HERO -->
    <section class="an-hero">
      <span class="eyebrow">Analíticas</span>
      <h1>Entiende tus <em>valores</em>.</h1>
      <p class="sub">
        Sube tu analítica en PDF, pégala como texto o introduce los parámetros a mano. Cada valor se
        clasifica como normal, ligeramente alterado, alterado o muy alterado, con su rango de referencia
        y una explicación sin tecnicismos.
      </p>
      <div class="an-disclaimer">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 9v4M12 17h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span><strong>Herramienta educativa.</strong> No diagnostica. Los rangos varían según laboratorio y edad — confirma siempre con tu médico.</span>
      </div>
    </section>

    <!-- UPLOAD -->
    <section id="an-upload-section" class="an-upload">
      <div class="an-tabs" role="tablist">
        <button type="button" class="an-tab on" data-tab="pdf" role="tab" aria-selected="true">PDF</button>
        <button type="button" class="an-tab" data-tab="text" role="tab" aria-selected="false">Pegar analítica</button>
        <button type="button" class="an-tab" data-tab="manual" role="tab" aria-selected="false">Introducir a mano</button>
      </div>

      <!-- PDF -->
      <div class="an-panel on" data-panel="pdf">
        <label class="an-dropzone" id="an-dz" for="an-file">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
            <path d="M14 2v6h6M9 15l3-3 3 3M12 12v9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <p id="an-dz-label">Arrastra tu PDF aquí o haz clic para seleccionar</p>
          <p class="hint">Máximo 10 MB · Solo se procesa el texto</p>
          <input type="file" id="an-file" accept="application/pdf,.pdf" style="display:none" />
        </label>
      </div>

      <!-- Texto -->
      <div class="an-panel" data-panel="text">
        <textarea id="an-paste" class="an-textarea" placeholder="Pega aquí el texto de la analítica. Ejemplo:&#10;&#10;Hemoglobina 11.2 g/dL (12.0-16.0)&#10;Leucocitos 8.5 10^3/uL (4.0-10.0)&#10;Colesterol total 245 mg/dL (<200)&#10;Glucosa 108 mg/dL (70-100)"></textarea>
      </div>

      <!-- Manual -->
      <div class="an-panel" data-panel="manual">
        <p class="manual-hint">Añade cada parámetro con su valor y unidad. El rango es opcional (si no lo pones, usaremos el habitual).</p>
        <div class="manual-list" id="manual-list"></div>
        <button type="button" class="manual-add" id="manual-add">+ Añadir parámetro</button>
      </div>

      <div class="an-actions">
        <span class="hint" id="an-hint">Elige una opción para empezar</span>
        <button type="button" class="an-analyze" id="an-analyze" disabled>
          <span id="an-analyze-label">Interpretar analítica</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </section>

    <!-- PROGRESS -->
    <section id="an-progress-section" class="an-progress" hidden aria-live="polite">
      <div class="an-progress-label" id="an-progress-label">Preparando…</div>
      <div class="an-progress-bar"><div class="an-progress-fill" id="an-progress-fill"></div></div>
    </section>

    <!-- ERROR -->
    <section id="an-error-section" hidden>
      <div class="an-alert">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.8"/>
          <path d="M12 8v4M12 16h.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
        <div class="msg" id="an-error-msg">Ha ocurrido un error.</div>
        <button type="button" id="an-error-retry">Volver a intentar</button>
      </div>
    </section>

    <!-- RESULT -->
    <section id="an-result-section" hidden>
      <div class="an-overall">
        <div id="an-overall-bar" class="an-overall-bar ov-normal">
          <span class="sev-dot" aria-hidden="true"></span>
          <div class="sev-text">
            <span class="sev-label" id="an-overall-label"></span>
            <span id="an-overall-desc"></span>
          </div>
        </div>
        <p class="an-summary" id="an-summary"></p>
      </div>

      <p class="params-title">Parámetros ordenados de más a menos alterados</p>
      <div class="params-list" id="params-list"></div>

      <div class="an-recommendations" id="an-recommendations" hidden>
        <h3>Recomendaciones generales</h3>
        <ul id="an-rec-list"></ul>
      </div>

      <p class="an-disclaimer-bottom">
        Los rangos de referencia varían entre laboratorios, edad, sexo y contexto clínico. Confirma cualquier hallazgo con tu médico responsable.
      </p>

      <div class="an-result-actions">
        <button type="button" class="btn btn-ghost" id="an-new">Interpretar otra</button>
        <a class="btn btn-primary" href="/login?signup=1">Crear cuenta →</a>
      </div>
    </section>

    <!-- NO ANALITICA -->
    <section id="no-analitica-section" hidden>
      <div class="no-analitica">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.6"/>
          <path d="M8 15s1.5-2 4-2 4 2 4 2M9 9h.01M15 9h.01" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        <h3>Esto no parece una analítica</h3>
        <p id="no-analitica-msg">El texto que has subido no tiene aspecto de ser una analítica de sangre u orina. Comprueba el archivo y vuelve a intentarlo.</p>
        <button type="button" class="btn btn-ghost" id="nm-retry">Volver a intentar</button>
      </div>
    </section>

  </main>

  <script is:inline>
    (function() {
      const MAX_FILE_SIZE = 10 * 1024 * 1024;
      const MIN_TEXT_LEN  = 40;

      // Refs
      const tabBtns  = document.querySelectorAll('.an-tab');
      const panels   = document.querySelectorAll('.an-panel');
      const dz       = document.getElementById('an-dz');
      const fileEl   = document.getElementById('an-file');
      const paste    = document.getElementById('an-paste');
      const manualList = document.getElementById('manual-list');
      const manualAdd  = document.getElementById('manual-add');
      const analyzeBtn = document.getElementById('an-analyze');
      const analyzeLbl = document.getElementById('an-analyze-label');
      const hintEl     = document.getElementById('an-hint');

      const uploadSection   = document.getElementById('an-upload-section');
      const progressSection = document.getElementById('an-progress-section');
      const progressLabel   = document.getElementById('an-progress-label');
      const progressFill    = document.getElementById('an-progress-fill');
      const errorSection    = document.getElementById('an-error-section');
      const errorMsg        = document.getElementById('an-error-msg');
      const errorRetry      = document.getElementById('an-error-retry');
      const resultSection   = document.getElementById('an-result-section');
      const noAnaliticaSection = document.getElementById('no-analitica-section');
      const nmRetry         = document.getElementById('nm-retry');
      const anNew           = document.getElementById('an-new');

      let currentTab = 'pdf';
      let pdfFile = null;

      // ─── Tabs ───
      tabBtns.forEach(b => {
        b.addEventListener('click', () => {
          currentTab = b.dataset.tab;
          tabBtns.forEach(x => {
            const on = x.dataset.tab === currentTab;
            x.classList.toggle('on', on);
            x.setAttribute('aria-selected', on ? 'true' : 'false');
          });
          panels.forEach(p => p.classList.toggle('on', p.dataset.panel === currentTab));
          if (currentTab === 'manual' && manualList.children.length === 0) {
            for (let i = 0; i < 3; i++) addManualRow();
          }
          updateAnalyzeState();
        });
      });

      // ─── PDF dropzone ───
      ['dragenter','dragover'].forEach(ev => dz.addEventListener(ev, e => { e.preventDefault(); dz.classList.add('hover'); }));
      ['dragleave','drop'].forEach(ev => dz.addEventListener(ev, e => { e.preventDefault(); dz.classList.remove('hover'); }));
      dz.addEventListener('drop', e => {
        const f = e.dataTransfer.files?.[0];
        if (f) handleFile(f);
      });
      fileEl.addEventListener('change', e => {
        const f = e.target.files?.[0];
        if (f) handleFile(f);
      });
      function handleFile(file) {
        if (file.size > MAX_FILE_SIZE) { alert('Archivo demasiado grande. Máx 10 MB.'); return; }
        pdfFile = file;
        document.getElementById('an-dz-label').textContent = '📄 ' + file.name;
        dz.classList.add('has-file');
        updateAnalyzeState();
      }

      // ─── Paste ───
      paste.addEventListener('input', updateAnalyzeState);

      // ─── Manual rows ───
      function addManualRow(name, value, unit) {
        const row = document.createElement('div');
        row.className = 'manual-row';
        row.innerHTML = (
          '<input class="manual-name" type="text" placeholder="Parámetro (ej. Hemoglobina)" />' +
          '<input class="manual-value" type="text" placeholder="Valor" inputmode="decimal" />' +
          '<input class="manual-unit" type="text" placeholder="Unidad (ej. g/dL)" />' +
          '<button type="button" class="del" aria-label="Quitar fila">' +
            '<svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M3 6h18M8 6v12a2 2 0 002 2h4a2 2 0 002-2V6M10 11v6M14 11v6M5 6l1-2h12l1 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>' +
          '</button>'
        );
        if (name)  row.querySelector('.manual-name').value  = name;
        if (value) row.querySelector('.manual-value').value = value;
        if (unit)  row.querySelector('.manual-unit').value  = unit;
        row.querySelectorAll('input').forEach(i => i.addEventListener('input', updateAnalyzeState));
        row.querySelector('.del').addEventListener('click', () => { row.remove(); updateAnalyzeState(); });
        manualList.appendChild(row);
        updateAnalyzeState();
      }
      manualAdd.addEventListener('click', () => addManualRow());

      function manualToText() {
        const rows = manualList.querySelectorAll('.manual-row');
        const lines = [];
        rows.forEach(r => {
          const n = r.querySelector('.manual-name').value.trim();
          const v = r.querySelector('.manual-value').value.trim();
          const u = r.querySelector('.manual-unit').value.trim();
          if (n && v) lines.push(n + ' ' + v + (u ? ' ' + u : ''));
        });
        return lines.join('\n');
      }

      // ─── Update UI state ───
      function updateAnalyzeState() {
        let ready = false, hint = 'Elige una opción para empezar';
        if (currentTab === 'pdf') {
          ready = !!pdfFile;
          hint = pdfFile ? (pdfFile.name + ' · listo') : 'Selecciona un PDF';
        } else if (currentTab === 'text') {
          const len = paste.value.trim().length;
          ready = len >= MIN_TEXT_LEN;
          hint = len === 0 ? 'Pega el texto de la analítica' : (ready ? (len + ' caracteres · listo') : ('Añade ' + (MIN_TEXT_LEN - len) + ' caracteres más'));
        } else if (currentTab === 'manual') {
          const filled = manualList.querySelectorAll('.manual-row').length;
          const valid = manualToText().split('\n').filter(Boolean).length;
          ready = valid >= 2;
          hint = valid === 0 ? 'Rellena al menos 2 parámetros' : (ready ? (valid + ' parámetros · listo') : ('Añade ' + (2 - valid) + ' parámetro más'));
        }
        analyzeBtn.disabled = !ready;
        hintEl.textContent = hint;
      }

      // ─── Progress ───
      function setProgress(label, pct) {
        progressLabel.textContent = label;
        progressFill.style.width = pct + '%';
      }
      function showState(which) {
        uploadSection.hidden       = which !== 'upload';
        progressSection.hidden     = which !== 'progress';
        errorSection.hidden        = which !== 'error';
        resultSection.hidden       = which !== 'result';
        noAnaliticaSection.hidden  = which !== 'no-analitica';
      }

      // ─── PDF extraction ───
      async function extractPdf(file) {
        if (!window.pdfjsLib) {
          for (let i = 0; i < 30; i++) {
            await new Promise(r => setTimeout(r, 100));
            if (window.pdfjsLib) break;
          }
          if (!window.pdfjsLib) throw new Error('El lector de PDF no ha cargado. Recarga la página.');
        }
        const buf = await file.arrayBuffer();
        const pdf = await window.pdfjsLib.getDocument({ data: buf }).promise;
        let text = '';
        for (let i = 1; i <= pdf.numPages; i++) {
          setProgress('Extrayendo página ' + i + ' de ' + pdf.numPages + '…', 10 + (i / pdf.numPages) * 30);
          const page = await pdf.getPage(i);
          const content = await page.getTextContent();
          text += content.items.map(it => it.str).join(' ') + '\n\n';
        }
        return text.trim();
      }

      // ─── Render ───
      function escapeHtml(s) {
        return String(s).replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
      }

      // Formatea el rango para separar visualmente '<'/'>' del número siguiente.
      // La font mono renderiza "<200" con los dos glifos casi pegados; con espacio queda mejor.
      function formatRange(r) {
        if (!r) return '';
        return r.replace(/([<>≤≥])(?!=?\s)=?/g, m => m.trim() + ' ').replace(/\s+/g, ' ').trim();
      }

      const OVERALL_META = {
        normal:     { cls: 'ov-normal',     label: 'Analítica estable' },
        attention:  { cls: 'ov-attention',  label: 'Requiere atención leve' },
        abnormal:   { cls: 'ov-abnormal',   label: 'Valores alterados' },
        concerning: { cls: 'ov-concerning', label: 'Requiere valoración pronta' },
      };

      const STATUS_ORDER = { red: 0, orange: 1, yellow: 2, green: 3 };

      function renderResult(data) {
        if (data.overall_status === 'no_analitica') {
          document.getElementById('no-analitica-msg').textContent =
            data.overall_summary || 'El texto que has subido no tiene aspecto de ser una analítica de sangre u orina. Comprueba el archivo y vuelve a intentarlo.';
          showState('no-analitica');
          return;
        }

        // Overall bar
        const bar = document.getElementById('an-overall-bar');
        bar.classList.remove('ov-normal', 'ov-attention', 'ov-abnormal', 'ov-concerning');
        const meta = OVERALL_META[data.overall_status] || OVERALL_META.attention;
        bar.classList.add(meta.cls);
        document.getElementById('an-overall-label').textContent = meta.label + ' · ';
        document.getElementById('an-overall-desc').textContent = 'orientativo, confirma con tu médico';
        document.getElementById('an-summary').textContent = data.overall_summary || 'Sin resumen disponible.';

        // Parámetros ordenados por severidad
        const params = (data.parameters || []).slice().sort((a, b) => (STATUS_ORDER[a.status] ?? 3) - (STATUS_ORDER[b.status] ?? 3));
        const list = document.getElementById('params-list');
        list.innerHTML = '';
        params.forEach(p => {
          const el = document.createElement('details');
          el.className = 'param-card status-' + p.status;
          // Abrir automáticamente los alterados
          if (p.status === 'red' || p.status === 'orange') el.open = true;
          el.innerHTML = (
            '<summary>' +
              '<span class="param-status-dot" aria-hidden="true"></span>' +
              '<span class="p-name">' + escapeHtml(p.name) + '</span>' +
              '<span class="p-value">' + escapeHtml(p.value) + (p.unit ? '<span class="unit">' + escapeHtml(p.unit) + '</span>' : '') + '</span>' +
              (p.normal_range ? '<span class="p-range">' + escapeHtml(formatRange(p.normal_range)) + '</span>' : '<span class="p-range"></span>') +
              '<span class="p-caret" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>' +
            '</summary>' +
            '<div class="p-body">' +
              (p.what_it_measures ? '<div class="p-body-section"><h4>Qué mide</h4><p>' + escapeHtml(p.what_it_measures) + '</p></div>' : '') +
              (p.why_altered ? '<div class="p-body-section"><h4>Causas frecuentes de alteración</h4><p>' + escapeHtml(p.why_altered) + '</p></div>' : '') +
              (p.when_to_worry ? '<div class="p-body-section"><h4>Cuándo suele requerir consulta médica</h4><p>' + escapeHtml(p.when_to_worry) + '</p></div>' : '') +
            '</div>'
          );
          list.appendChild(el);
        });

        // Recomendaciones
        const recs = data.recommendations || [];
        const recSection = document.getElementById('an-recommendations');
        const recList = document.getElementById('an-rec-list');
        if (recs.length) {
          recList.innerHTML = recs.map(r => '<li>' + escapeHtml(r) + '</li>').join('');
          recSection.hidden = false;
        } else {
          recSection.hidden = true;
        }

        showState('result');
      }

      // ─── Flow ───
      async function runAnalysis() {
        try { window.track && window.track('Analitica analyze start', { source: currentTab }); } catch (_) {}

        showState('progress');
        setProgress('Preparando…', 5);

        try {
          let text;
          if (currentTab === 'pdf') {
            text = await extractPdf(pdfFile);
          } else if (currentTab === 'text') {
            text = paste.value.trim();
            setProgress('Preparando texto…', 40);
          } else {
            text = manualToText();
            setProgress('Preparando parámetros…', 40);
          }

          if (!text || text.length < MIN_TEXT_LEN) {
            throw new Error('No se pudo extraer suficiente texto. ¿Es el archivo correcto?');
          }

          setProgress('Interpretando con IA…', 55);
          const res = await fetch('/api/analyze-analitica', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ text: text.slice(0, 30000) }),
          });

          setProgress('Casi listo…', 90);

          if (!res.ok) {
            let msg = 'HTTP ' + res.status;
            try {
              const d = await res.json();
              msg = d.error || msg;
            } catch (_) {}
            throw new Error(msg);
          }

          const data = await res.json();
          setProgress('Listo', 100);
          await new Promise(r => setTimeout(r, 200));
          renderResult(data);
          try { window.track && window.track('Analitica analyze success', { overall: data.overall_status || 'unknown', params: (data.parameters || []).length }); } catch (_) {}
        } catch (err) {
          console.error('[analiticas]', err);
          errorMsg.textContent = err.message || 'Error inesperado.';
          showState('error');
          try { window.track && window.track('Analitica analyze error', { message: (err.message || '').slice(0, 80) }); } catch (_) {}
        }
      }

      analyzeBtn.addEventListener('click', runAnalysis);

      function resetAll() {
        pdfFile = null;
        fileEl.value = '';
        document.getElementById('an-dz-label').textContent = 'Arrastra tu PDF aquí o haz clic para seleccionar';
        dz.classList.remove('has-file');
        paste.value = '';
        manualList.innerHTML = '';
        for (let i = 0; i < 3; i++) addManualRow();
        updateAnalyzeState();
        showState('upload');
      }
      errorRetry.addEventListener('click', resetAll);
      nmRetry.addEventListener('click', resetAll);
      anNew.addEventListener('click', resetAll);

      // Init
      updateAnalyzeState();
    })();
  </script>

</Layout>
