---
/**
 * Tarjeta de post del blog. Reutilizable en el listado general (/blog) y en
 * el listado filtrado de casos (/blog/casos).
 *
 * Props:
 *   post     — entrada de la coleccion 'blog'
 *   variante — 'compacta' (default, grid) | 'destacada' (hero card grande)
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  variante?: 'compacta' | 'destacada';
}

const { post, variante = 'compacta' } = Astro.props;

const especialidadLabel: Record<string, string> = {
  'urgencias': 'Urgencias',
  'medicina-interna': 'Medicina interna',
  'cardiología': 'Cardiología',
  'geriatría': 'Geriatría',
  'farmacología': 'Farmacología',
  'legal-y-privacidad': 'Legal y privacidad',
  'general': 'General',
};

const nivelLabel: Record<string, string> = {
  'fundamentos': 'Fundamentos',
  'avanzado': 'Avanzado',
};

function fmtDate(d: Date): string {
  return new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
}

const esCaso = post.data.tipo === 'caso';
const href = `/blog/${post.slug}/`;
---

{variante === 'destacada' ? (
  <a class="tp-featured" href={href}>
    <span class="tp-kicker">
      {esCaso ? 'Caso clínico' : 'Destacado'} · {especialidadLabel[post.data.specialty]}
      {post.data.nivel && <span class="tp-nivel">{nivelLabel[post.data.nivel]}</span>}
    </span>
    <h2>{post.data.title}</h2>
    <p>{post.data.description}</p>
    <div class="tp-meta">
      <span>{fmtDate(post.data.publishDate)}</span>
      {post.data.readingMinutes && <span>{post.data.readingMinutes} min de lectura</span>}
      <span>{post.data.author}</span>
    </div>
  </a>
) : (
  <a class="tp-card" href={href} data-tipo={post.data.tipo}>
    <span class="tp-tag">
      {esCaso && <span class="tp-badge-caso">Caso</span>}
      {especialidadLabel[post.data.specialty]}
      {post.data.nivel && <span class="tp-nivel-inline">· {nivelLabel[post.data.nivel]}</span>}
    </span>
    <h3>{post.data.title}</h3>
    <p>{post.data.description}</p>
    <span class="tp-foot">{fmtDate(post.data.publishDate)}{post.data.readingMinutes ? ` · ${post.data.readingMinutes} min` : ''}</span>
  </a>
)}

<style>
  /* ─── Variante destacada ─── */
  .tp-featured {
    border: 1px solid var(--rule-2);
    border-radius: 18px;
    padding: clamp(28px, 3.5vw, 44px);
    background: var(--surface);
    display: block;
    color: inherit;
    text-decoration: none;
    transition: border-color .15s, transform .15s;
  }
  .tp-featured:hover { border-color: var(--accent); transform: translateY(-2px); }
  .tp-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--f-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
  }
  .tp-kicker::before {
    content: '';
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent);
  }
  .tp-nivel {
    color: var(--ink-mute);
    letter-spacing: 0.1em;
  }
  .tp-featured h2 {
    font-family: var(--f-display);
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 400;
    line-height: 1.15;
    margin: 0 0 14px;
    letter-spacing: -0.01em;
  }
  .tp-featured p {
    color: var(--ink-soft);
    font-size: clamp(15px, 1.1vw, 17px);
    line-height: 1.55;
    margin: 0 0 20px;
    max-width: 68ch;
  }
  .tp-meta {
    display: flex;
    gap: 16px;
    font-family: var(--f-mono);
    font-size: 11.5px;
    color: var(--ink-mute);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    flex-wrap: wrap;
  }

  /* ─── Variante compacta (grid) ─── */
  .tp-card {
    background: var(--bg);
    padding: clamp(22px, 2.4vw, 28px);
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: inherit;
    text-decoration: none;
    min-height: 220px;
    transition: background .15s;
  }
  .tp-card:hover { background: var(--surface); }
  .tp-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--f-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .tp-badge-caso {
    background: var(--accent);
    color: var(--accent-ink);
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }
  .tp-nivel-inline {
    color: var(--ink-mute);
  }
  .tp-card h3 {
    font-family: var(--f-display);
    font-size: 21px;
    font-weight: 400;
    line-height: 1.22;
    margin: 0;
    letter-spacing: -0.005em;
  }
  .tp-card p {
    color: var(--ink-soft);
    font-size: 14.5px;
    line-height: 1.5;
    margin: 0;
    flex: 1;
  }
  .tp-foot {
    font-family: var(--f-mono);
    font-size: 10.5px;
    color: var(--ink-mute);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-top: 6px;
  }
</style>
