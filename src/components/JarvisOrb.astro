---
/**
 * JarvisOrb — Holographic AI voice orb component.
 *
 * States (set via data-state attribute):
 *   idle      — floating, breathing, soft glow
 *   listening — brighter glow, faster rings (user speaking)
 *   thinking  — purple shift, orbiting particles (waiting for LLM)
 *   speaking  — expanding waves, dynamic pulse (TTS playing)
 */
import '../styles/jarvis.css';
---

<div
  class="jarvis"
  id="jarvis-orb"
  data-state="idle"
  role="button"
  tabindex="0"
  aria-label="Hablar con Medi"
>
  <!-- Concentric waves — visible in speaking state -->
  <div class="jarvis__waves" aria-hidden="true">
    <div class="jarvis__wave"></div>
    <div class="jarvis__wave"></div>
    <div class="jarvis__wave"></div>
  </div>

  <!-- Orbital rings -->
  <div class="jarvis__ring jarvis__ring--1" aria-hidden="true"></div>
  <div class="jarvis__ring jarvis__ring--2" aria-hidden="true"></div>

  <!-- Core sphere -->
  <div class="jarvis__core" aria-hidden="true"></div>

  <!-- Particles — visible in thinking state -->
  <div class="jarvis__particles" aria-hidden="true">
    <span class="jarvis__particle" style="--dur:3s;--del:0s;"></span>
    <span class="jarvis__particle" style="--dur:4.2s;--del:0.6s;--rad:55%;"></span>
    <span class="jarvis__particle" style="--dur:3.4s;--del:1.2s;"></span>
    <span class="jarvis__particle" style="--dur:5s;--del:0.3s;--rad:56%;"></span>
    <span class="jarvis__particle" style="--dur:3.8s;--del:0.9s;--rad:42%;"></span>
    <span class="jarvis__particle" style="--dur:4.6s;--del:1.5s;"></span>
  </div>
</div>

<script>
  import '../scripts/jarvis.ts';
</script>
